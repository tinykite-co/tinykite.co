---
import { buttonVariants } from "@refraction-ui/astro";
import BackPage from "../../../components/gloss/back/BackPage.astro";
import FamilyMembership from "../../../components/gloss/interest/FamilyMembership.astro";
import FeatureRequestForm from "../../../components/gloss/interest/FeatureRequestForm.astro";
import PracticeStory from "../../../components/gloss/interest/PracticeStory.astro";
import InterestForm from "../../../components/gloss/interest/InterestForm.astro";
import SilentDemo from "../../../components/gloss/demo/SilentDemo.astro";
import "../../../components/gloss/interest/campaign.css";
const waysToHelp = [
  { number: "01", title: "Bring your reading", body: "Tell us the words that stop a story in its tracks—from a first picture book to the books studied through Year 13." },
  { number: "02", title: "Bring your language", body: "A language from home, a regional variety, or one you’re learning. Help us make the dictionary useful far beyond English." },
  { number: "03", title: "Bring your eye", body: "Review a meaning, offer image-generation credits, or contribute pictures made from an agreed brief. Every contribution still needs checking." },
];
---
<BackPage title="A picture dictionary for your world — Gloss" description="Express interest in Gloss: a vetted picture dictionary for books read through Year 13 and grown-ups learning another language. Choose the languages that matter to you.">
  <div class="gloss-campaign">
    <header class="gc-shell gc-hero interest-hero">
      <div class="interest-kicker"><span class="gc-eyebrow">Words worth understanding</span><a href="#see-gloss" class="gc-link text-sm">See it work ↓</a></div>
      <h1 class="gc-title mt-7">A little picture.<br /><span class="interest-title-accent">A much bigger world.</span></h1>
      <div class="interest-intro">
        <p class="text-lg leading-relaxed">For the word that interrupts a story. The idea that’s hard to explain. The language you want to keep close.</p>
        <p class="gc-muted leading-relaxed">Gloss is building a vetted picture dictionary for young readers, with the ambition to cover every word in the books they read through Year 13—and help grown-ups learn another language, too.</p>
      </div>
      <div class="mt-7 flex flex-wrap items-center gap-4">
        <a href="#reading-interest" class:list={[buttonVariants({ size: "lg" }), "gc-action interest-primary"]}>I’m interested <span aria-hidden="true">↓</span></a>
        <span class="gc-muted text-sm">No payment. No account needed.</span>
      </div>
    </header>

    <div id="see-gloss" class="gc-shell interest-demo"><SilentDemo /><p class="gc-muted mt-3 text-xs">Captured from the live Gloss beta on 11 November 2026. Some entries are still awaiting pictures. No audio plays; pause or explore one step at a time.</p></div>

    <PracticeStory />
    <FamilyMembership />

    <section class="gc-shell interest-connect gc-grid" aria-labelledby="interest-connection">
      <div>
        <p class="gc-eyebrow">Made with a world of readers</p>
        <h2 id="interest-connection" class="mt-4 text-3xl font-bold leading-tight">Your words.<br />Your language.<br />Your part in the story.</h2>
        <p class="gc-muted mt-5 max-w-md leading-relaxed">One shared dictionary project. Many ways to help it grow. Tell us what would make Gloss useful in your home, classroom or next chapter.</p>
        <div class="mt-9 space-y-7">
          {waysToHelp.map(way => <article class="interest-way">
            <span class="gc-eyebrow">{way.number}</span>
            <div><h3 class="font-semibold">{way.title}</h3><p class="gc-muted mt-2 text-sm leading-relaxed">{way.body}</p></div>
          </article>)}
        </div>
        <div class="interest-note mt-9">
          <p class="font-semibold">A language doesn’t need to be “big” to matter.</p>
          <p class="gc-muted mt-2 text-sm leading-relaxed">The chooser is a starting point. Add the regional variety, community language or writing system you want us to consider. We’ll need speakers who know it well to review the work.</p>
        </div>

      </div>
      <InterestForm />
    </section>
    <FeatureRequestForm />
  </div>
</BackPage>
<style>
  .interest-kicker { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; align-items: center; }
  .interest-title-accent { color: var(--gc-accent); }
  .interest-intro { margin-top: 2rem; display: grid; gap: 1.25rem; max-width: 62rem; }
  .interest-primary { color: hsl(var(--primary-foreground)); }
  .interest-demo { margin-bottom: clamp(3rem, 7vw, 6rem); }
  .interest-connect { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .interest-way { display: grid; grid-template-columns: 1.8rem minmax(0,1fr); gap: .75rem; }
  .interest-note { border-left: 2px solid var(--gc-accent); padding-left: 1.25rem; max-width: 30rem; }
  @media (min-width: 700px) { .interest-intro { grid-template-columns: 1fr 1fr; gap: 3rem; } }
</style>
