---
import BackPage from "../../../components/gloss/back/BackPage.astro";
import { SUPPORT_EMAIL } from "../../../lib/gloss/campaign";

/** The privacy notice for backers (adults paying on the website), separate from the app's. */
const LAST_UPDATED = "11 October 2026";

const sections = [
  {
    title: "Who we are",
    body: ["Tiny Kite LTD (“TinyKite”), a company in the United Kingdom, runs the Gloss language campaigns and decides what happens to backers’ details."],
  },
  {
    title: "What we keep",
    body: [
      "Your name, email address, country, the language you backed, the reward tier, the amount, and the date. Stripe sends us these when you pay.",
      "We never see or keep your card details. Stripe handles the payment under its own privacy policy.",
    ],
  },
  {
    title: "Why we keep it",
    body: [
      "To deliver your rewards, to send you campaign updates and the spending report you were promised, and to refund you if your language misses its goal. This is our contract with you.",
      "To keep the tax and accounting records UK law requires.",
      "If you choose a reward that names your family, we use the name you give us for that, and only that.",
    ],
  },
  {
    title: "Who sees it",
    body: ["Stripe, which processes the payment. Nobody else. We don’t sell backers’ details or use them for advertising."],
  },
  {
    title: "How long we keep it",
    body: ["Six years after the payment, because UK tax law requires it. Then we delete it."],
  },
  {
    title: "Your rights",
    body: [
      `You can ask for a copy of your details, ask us to correct them, or stop campaign emails at any time, by emailing ${SUPPORT_EMAIL}. You can complain to the Information Commissioner’s Office (ico.org.uk).`,
    ],
  },
  {
    title: "Children",
    body: ["Only adults can back a campaign. We don’t knowingly take payment from, or keep details about, children here. How the app treats children’s information is in the Gloss Privacy Policy."],
  },
];
---

<BackPage title="Backer privacy notice — Gloss" description="What TinyKite keeps about people who back a Gloss language, and why.">
  <section class="pt-32 pb-12 px-6">
    <div class="container mx-auto max-w-2xl">
      <h1 class="text-4xl font-bold mb-2 text-text" style="font-family: 'Lora', serif;">Backer privacy notice</h1>
      <p class="text-sm text-gray-500 mb-8">Last updated: {LAST_UPDATED}. For the app itself, see the <a href="/gloss/privacy/" class="text-[var(--gloss-sage)] hover:underline">Gloss Privacy Policy</a>.</p>
      {sections.map((section) => (
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-text mb-2">{section.title}</h2>
          {section.body.map((paragraph) => <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-2">{paragraph}</p>)}
        </div>
      ))}
    </div>
  </section>
</BackPage>
