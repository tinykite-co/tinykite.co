---
import BackPage from "../../../components/gloss/back/BackPage.astro";
import BackingRules from "../../../components/gloss/back/BackingRules.astro";
import GoalProgress from "../../../components/gloss/back/GoalProgress.astro";
import PlusPlans from "../../../components/gloss/back/PlusPlans.astro";
import { campaign, dollars, languagePath, languagesByGroup, SUPPORT_EMAIL } from "../../../lib/gloss/campaign";

/**
 * The directory of language campaigns. It deliberately tells no story: each
 * language's page is written for its own families and stands alone, so this
 * page only lists them, with the rules and plans every campaign shares.
 */
const { languages, tiers, closesOn } = campaign;
const lowestPrice = Math.min(...tiers.map((tier) => tier.price));
const groups = languagesByGroup(languages);

const faqs = [
  {
    question: "Why should I pay for a dictionary?",
    answer: "Because each good answer costs money. Pictures cost image-generation credits, every meaning is checked by a paid person, and the servers run every day. Gloss has no ads and sells no data, so the families who use it pay for it.",
  },
  {
    question: "Why one campaign per language?",
    answer: "Each language is built only if its own families fund it, and nobody pays for one that doesn’t happen.",
  },
  {
    question: "Are the pictures made by AI?",
    answer: "Yes. An image model draws them, a second model checks them, and doubtful ones go to a person. Most of what you fund is people: native speakers and teachers who check the words.",
  },
  {
    question: "How do I get Gloss Plus as a reward?",
    answer: "We email the grown-up who backed. They sign in to their TinyKite account in the app’s Grown-ups area, and Plus follows that account on iPhone and Android. If you chose to gift a family, we also send you a code to pass on to them. Children never see a code or a price.",
  },
];
---

<BackPage
  title="Back Gloss — TinyKite"
  description="Gloss is a picture dictionary for children reading real books. Choose the language, or the English, your family reads in."
>
  <!-- Hero -->
  <section class="relative pt-32 pb-8 px-6">
    <div class="container mx-auto max-w-5xl">
      <p class="text-[var(--gloss-sage)] font-medium tracking-wide uppercase text-sm mb-3">Back Gloss</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-5 text-text" style="font-family: 'Lora', serif;">
        Choose your family’s language<span class="text-[var(--gloss-honey)]">.</span>
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
        Each language has its own page, its own goal and its own backers. If a goal isn’t reached, everyone who backed it gets their money back. Backing starts at {dollars(lowestPrice)}.
      </p>
    </div>
  </section>

  <!-- Languages, by group -->
  {groups.map((group) => (
    <section class="py-8 px-6">
      <div class="container mx-auto max-w-5xl">
        <h2 class="text-2xl font-bold text-text mb-5" style="font-family: 'Lora', serif;">{group.title}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {group.languages.map((language) => (
            <a href={languagePath(language)} class="rounded-2xl border p-5 bg-white dark:bg-white/[0.03] border-gray-100 dark:border-white/[0.06] hover:border-[var(--gloss-sage)] transition-colors flex flex-col">
              <h3 class="font-semibold text-text text-lg mb-1">{language.name}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">{language.who}</p>
              <div class="mt-auto">
                <GoalProgress language={language} closesOn={closesOn} />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="pt-4 pb-12 px-6">
    <div class="container mx-auto max-w-5xl">
      <p class="text-gray-600 dark:text-gray-400">
        Not here? <a href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("A Gloss campaign for my language")}`} class="text-[var(--gloss-sage)] font-semibold hover:underline">Ask for your language</a>. If enough families ask, we’ll open it. Native speakers who would check words are especially welcome.
      </p>
    </div>
  </section>

  <!-- Rules -->
  <section class="py-12 px-6 bg-[var(--gloss-paper)]/40 dark:bg-white/[0.02]">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold text-text mb-6" style="font-family: 'Lora', serif;">How backing works</h2>
      <BackingRules />
    </div>
  </section>

  <!-- Plans -->
  <section class="py-16 px-6">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-text mb-3" style="font-family: 'Lora', serif;">What Gloss will cost</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl">
        Backing pays to make the pictures and meanings once. Running Gloss costs money every month, so after the beta it’s a paid app. Starter lets a child try a few words a day at no charge. Gloss Plus is the whole dictionary. Every backer gets at least a year of Plus.
      </p>
      <PlusPlans />
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-6 bg-[var(--gloss-paper)]/40 dark:bg-white/[0.02]">
    <div class="container mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold text-text mb-8" style="font-family: 'Lora', serif;">Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="rounded-2xl border border-gray-100 dark:border-white/[0.06] bg-white dark:bg-white/[0.03] p-5">
            <summary class="font-semibold text-text cursor-pointer">{faq.question}</summary>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mt-3">{faq.answer}</p>
          </details>
        ))}
      </div>
      <p class="text-gray-600 dark:text-gray-400 mt-8">
        Schools, publishers or sponsors who’d like to fund a whole language: <a href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("Sponsoring a Gloss language")}`} class="text-[var(--gloss-sage)] font-semibold hover:underline">{SUPPORT_EMAIL}</a>. A real person reads every email.
      </p>
    </div>
  </section>
</BackPage>
