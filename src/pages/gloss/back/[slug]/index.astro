---
import { buttonVariants } from "@refraction-ui/astro";
import BackPage from "../../../../components/gloss/back/BackPage.astro";
import { campaign, dollars, SUPPORT_EMAIL, type Language } from "../../../../lib/gloss/campaign";
export function getStaticPaths() {
  return campaign.languages.map(language => ({ params: { slug: language.slug }, props: { language } }));
}
interface Props { language: Language; }
const { language } = Astro.props;
const contact = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(`I can help Gloss with ${language.name}`)}`;
---
<BackPage title={`${language.name} expansion — Gloss`} description={`The proposed ${language.name} expansion of Gloss’s shared picture dictionary, with scope and a working cost estimate.`}>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <a class="text-text underline" href="/gloss/back/">← The shared picture-dictionary campaign</a>
    <p class="mt-8 text-sm font-semibold uppercase tracking-wide text-[var(--gloss-sage)]">Language expansion · planning estimate</p>
    <h1 class="mt-4 text-4xl font-bold text-text">Gloss in {language.name}</h1>
    <p class="mt-5 text-lg leading-relaxed text-text">{language.promise}</p>
    <p class="mt-4 text-muted-foreground">This is proposed work, not a separate fundraiser. All backing supports the shared dictionary. Language preferences help us prioritise; they do not reserve funds or guarantee a delivery date.</p>
    <div class="my-8 rounded-2xl border border-border bg-card p-6"><h2 class="text-xl font-bold text-text">Additional working budget</h2><p class="mt-3 text-3xl font-bold text-text">US {dollars(language.goal)}</p><p class="mt-3 text-muted-foreground">An initial estimate on top of the shared foundation, not a supplier quote. Native-speaker and production quotes will refine the scope and cost before we commission work.</p></div>
    {language.roots && <p class="mb-8 text-lg leading-relaxed text-text">{language.roots}</p>}
    <h2 class="text-2xl font-bold text-text">What we want to add</h2>
    <ul class="my-5 space-y-3 text-text">{language.buys.map(item => <li>· {item}</li>)}</ul>
    {language.samples.length > 0 && <section class="mt-8"><h2 class="text-2xl font-bold text-text">An illustration of the idea</h2><p class="mt-3 text-sm text-muted-foreground">Draft examples only. Native speakers must check and revise these before publication as dictionary entries.</p><div class="mt-5 space-y-4">{language.samples.map(sample => <article class="rounded-2xl border border-border bg-card p-5"><h3 class="text-xl font-bold text-text">{sample.word}</h3>{sample.lines.map(line => <p class="mt-2 leading-relaxed text-text">{line}</p>)}</article>)}</div></section>}
    <div class="mt-9 flex flex-wrap gap-3"><a href="/gloss/back/#rewards" class:list={[buttonVariants({ variant: "outline", size: "lg" }), "min-h-12 h-auto py-3 max-w-full !whitespace-normal text-center"]}>See shared campaign rewards</a><a href={contact} class:list={[buttonVariants({ variant: "outline", size: "lg" }), "min-h-12 h-auto py-3 max-w-full !whitespace-normal text-center"]}>Help with {language.name}</a></div>
  </section>
</BackPage>
