---
import { buttonVariants } from "@refraction-ui/astro";
import FamilyPlan from "../../components/family/FamilyPlan.astro";
import Layout from "../../layouts/Layout.astro";

const createAccount = "https://accounts.tinykite.co/login/?mode=signup";
const signIn = "https://accounts.tinykite.co/login/";
const apps = [
  {
    name: "Nesta",
    summary: "Private messaging for your household. Set up your family and connect a child’s device from the grown-up account.",
    url: "https://nesta.tinykite.co/",
  },
  {
    name: "Gloss",
    summary: "Look up words, hear them aloud and practise them. A parent can connect a reader to save their progress across devices.",
    url: "https://gloss.tinykite.co/",
  },
];
const primary = buttonVariants({ size: "lg" });
const secondary = buttonVariants({ variant: "outline", size: "lg" });
---

<Layout title="TinyKite for Families" description="One TinyKite account for Nesta and Gloss. Free during beta.">
  <main class="mx-auto max-w-5xl px-5 pb-20 pt-28 sm:px-8 sm:pt-36" style="color-scheme: light dark">
    <header class="max-w-2xl">
      <p class="mb-3 font-semibold text-text">Free during beta · No payment details needed</p>
      <h1 class="text-4xl font-bold leading-tight text-text sm:text-5xl">One account for your family</h1>
      <p class="mt-4 text-lg leading-relaxed text-text">Create a grown-up account, then open Nesta or Gloss with the same sign-in.</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a href={createAccount} class:list={[primary, "min-h-12 family-primary"]}>Create a grown-up account</a>
        <a href={signIn} class:list={[secondary, "min-h-12"]}>Sign in</a>
      </div>
    </header>
    <section aria-label="Family apps" class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {apps.map((app) => (
        <article class="flex min-w-0 flex-col gap-4 rounded-2xl border border-border bg-card p-5 sm:p-6">
          <h2 class="text-2xl font-bold text-text">{app.name}</h2>
          <p class="flex-1 leading-relaxed text-text">{app.summary}</p>
          <a href={app.url} class:list={[secondary, "min-h-12 w-full"]}>Open {app.name}</a>
        </article>
      ))}
    </section>
    <p class="mt-6 text-text">On a child’s device, open the app and choose <strong>I have a setup code</strong>. A grown-up creates the code and approves the device.</p>
    <section class="mt-12" aria-label="One household plan"><FamilyPlan /><p class="mt-4 text-text"><a class="underline" href="/pricing/">Pricing details</a> · <a class="underline" href="/gloss/back/">Help build Gloss in your language</a></p></section>
  </main>
</Layout>

<style>
  .family-primary {
    color: hsl(var(--primary-foreground));
  }
</style>
