---
/**
 * src/pages/start/index.astro
 * Ishaan's Learning Launchpad - Fixed Allowed Websites Home Page
 */
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Learning Launchpad | TinyKite";
const pageDescription = "Ishaan's learning launchpad - direct access to approved learning apps, typing practice, and school resources.";

interface SiteCard {
  id: string;
  name: string;
  url: string;
  badge: string;
  category: 'learning' | 'school' | 'reading';
  icon: string;
  tagline: string;
  description: string;
  bgGradient: string;
  accentBorder: string;
  highlight?: boolean;
}

const SITES: SiteCard[] = [
  {
    id: 'typeracer',
    name: 'TinyKite TypeRacer',
    url: 'https://tinykite.co/typeracer/',
    badge: 'Touch Typing & Racing',
    category: 'learning',
    icon: '🏎️',
    tagline: '100% Ad-Free Typing Academy & Literature Sprints',
    description: 'Learn ergonomic touch typing with animated hands, race classic stories against friends, and level up your typing speed.',
    bgGradient: 'from-amber-500/10 to-amber-500/5',
    accentBorder: 'hover:border-amber-400/80',
    highlight: true,
  },
  {
    id: 'atom',
    name: 'Atom Learning',
    url: 'https://atomlearning.com',
    badge: 'Exam Prep & Lessons',
    category: 'learning',
    icon: '🚀',
    tagline: 'Personalised English, Maths & Reasoning',
    description: 'Complete daily practice questions, interactive video lessons, and mock exam tests tailored to your learning pace.',
    bgGradient: 'from-cyan-500/10 to-blue-500/5',
    accentBorder: 'hover:border-cyan-400/80',
    highlight: true,
  },
  {
    id: 'bitesize',
    name: 'BBC Bitesize',
    url: 'https://www.bbc.co.uk/bitesize',
    badge: 'Primary Curriculum',
    category: 'learning',
    icon: '📚',
    tagline: 'Curriculum Revision, Videos & Educational Games',
    description: 'Explore Science, History, Geography, English, and Maths activities mapped directly to the National Curriculum.',
    bgGradient: 'from-rose-500/10 to-orange-500/5',
    accentBorder: 'hover:border-rose-400/80',
  },
  {
    id: 'khan',
    name: 'Khan Academy',
    url: 'https://www.khanacademy.org',
    badge: 'Free Math & Science',
    category: 'learning',
    icon: '🎓',
    tagline: 'Master Math, Science & Computing Concepts',
    description: 'Step-by-step math problems, programming challenges, and video explanations with personalized mastery points.',
    bgGradient: 'from-emerald-500/10 to-teal-500/5',
    accentBorder: 'hover:border-emerald-400/80',
  },
  {
    id: 'classroom',
    name: 'Google Classroom',
    url: 'https://classroom.google.com',
    badge: 'School & Homework',
    category: 'school',
    icon: '🏫',
    tagline: 'Classroom Assignments & Teacher Feedback',
    description: 'Access school assignments, submit completed homework, and check announcements from your teachers.',
    bgGradient: 'from-green-500/10 to-emerald-500/5',
    accentBorder: 'hover:border-green-400/80',
  },
  {
    id: 'meet',
    name: 'Google Meet',
    url: 'https://meet.google.com',
    badge: 'Video Lessons',
    category: 'school',
    icon: '📹',
    tagline: 'Live Teacher Video Calls & Classes',
    description: 'Join scheduled video calls with your teachers, online tutors, and school study sessions securely.',
    bgGradient: 'from-teal-500/10 to-cyan-500/5',
    accentBorder: 'hover:border-teal-400/80',
  },
  {
    id: 'docs',
    name: 'Google Docs',
    url: 'https://docs.google.com',
    badge: 'Word Processing',
    category: 'school',
    icon: '📝',
    tagline: 'Write Stories, School Essays & Notes',
    description: 'Create new word documents, write English essays, spell-check your work, and format school projects.',
    bgGradient: 'from-blue-500/10 to-indigo-500/5',
    accentBorder: 'hover:border-blue-400/80',
  },
  {
    id: 'drive',
    name: 'Google Drive',
    url: 'https://drive.google.com',
    badge: 'Cloud Storage',
    category: 'school',
    icon: '📂',
    tagline: 'Homework Folders, PDFs & Project Files',
    description: 'Organize your school folders, download worksheets, and save revision resources in one safe place.',
    bgGradient: 'from-amber-500/10 to-yellow-500/5',
    accentBorder: 'hover:border-amber-400/80',
  },
  {
    id: 'wikipedia',
    name: 'Wikipedia',
    url: 'https://www.wikipedia.org',
    badge: 'Research Encyclopedia',
    category: 'reading',
    icon: '📖',
    tagline: 'The Free Encyclopedia for School Research',
    description: 'Look up facts about history, science discoveries, nature, animals, and world geography for school projects.',
    bgGradient: 'from-slate-500/10 to-gray-500/5',
    accentBorder: 'hover:border-slate-400/80',
  },
  {
    id: 'gutenberg',
    name: 'Project Gutenberg',
    url: 'https://www.gutenberg.org',
    badge: 'Classic Library',
    category: 'reading',
    icon: '📜',
    tagline: 'Free Classic Books, Stories & Literature',
    description: 'Read original classic novels from Charles Dickens, Arthur Conan Doyle, Lewis Carroll, and Jane Austen.',
    bgGradient: 'from-purple-500/10 to-violet-500/5',
    accentBorder: 'hover:border-purple-400/80',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Literate styling tokens and fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

  <style>
    :global(body) {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    }
    .refraction-panel {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
    }
    :global(.dark) .refraction-panel {
      background: rgba(15, 23, 42, 0.75);
      border-color: rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.04);
    }
    .refraction-card {
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .refraction-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.12);
    }
    :global(.dark) .refraction-card:hover {
      box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.7);
    }
  </style>

  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-6 px-4 sm:px-6 lg:px-8 selection:bg-amber-400 selection:text-slate-950">
    <div class="max-w-6xl mx-auto space-y-6">

      <!-- Header Strip -->
      <header class="refraction-panel rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-5 relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-56 h-56 bg-gradient-to-br from-amber-400/20 to-cyan-400/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="space-y-1 relative z-10">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-400/20 text-amber-900 dark:text-amber-300 border border-amber-400/30">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Ishaan's Learning Launchpad
            </span>
            <span class="text-xs text-slate-500 dark:text-slate-400" id="live-clock"></span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white">
            Welcome! What are we learning today?
          </h1>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl">
            Choose an approved app below to start practicing touch typing, studying lessons, or working on school assignments.
          </p>
        </div>

        <!-- Quick Filter / Search -->
        <div class="relative z-10 w-full md:w-72 shrink-0">
          <label for="search-input" class="sr-only">Search allowed websites</label>
          <div class="relative">
            <input
              type="search"
              id="search-input"
              placeholder="Search websites (e.g. Type, Atom, Math)..."
              class="w-full px-4 py-2.5 pl-10 text-xs font-medium rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-black/10 dark:border-white/10 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all min-h-[44px]"
            />
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" aria-hidden="true">
              🔍
            </span>
          </div>
        </div>
      </header>

      <!-- Category Filter Tabs -->
      <nav class="flex items-center gap-2 overflow-x-auto pb-1" aria-label="Website categories">
        <button type="button" data-filter="all" class="category-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-slate-900 text-white dark:bg-amber-400 dark:text-slate-950 shadow-sm min-h-[40px]">
          All Apps (10)
        </button>
        <button type="button" data-filter="learning" class="category-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white/70 dark:bg-slate-900/70 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 border border-black/[0.06] dark:border-white/[0.08] min-h-[40px]">
          Learning & Typing (4)
        </button>
        <button type="button" data-filter="school" class="category-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white/70 dark:bg-slate-900/70 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 border border-black/[0.06] dark:border-white/[0.08] min-h-[40px]">
          School & Class (4)
        </button>
        <button type="button" data-filter="reading" class="category-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white/70 dark:bg-slate-900/70 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 border border-black/[0.06] dark:border-white/[0.08] min-h-[40px]">
          Reading & Research (2)
        </button>
      </nav>

      <!-- FEATURED HERO APPS (Top 2 Primary Learning Apps) -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {SITES.filter(s => s.highlight).map((site) => (
          <a
            href={site.url}
            class={`refraction-panel refraction-card site-card block p-6 rounded-3xl bg-gradient-to-br ${site.bgGradient} border border-black/[0.08] dark:border-white/[0.1] ${site.accentBorder} group relative overflow-hidden`}
            data-category={site.category}
            data-name={site.name.toLowerCase()}
            data-tagline={site.tagline.toLowerCase()}
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <span class="text-4xl filter drop-shadow group-hover:scale-110 transition-transform" aria-hidden="true">{site.icon}</span>
                <div>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-400 text-slate-950 inline-block mb-1">
                    {site.badge}
                  </span>
                  <h2 class="text-xl font-extrabold text-slate-950 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                    {site.name}
                  </h2>
                </div>
              </div>
              <span class="w-10 h-10 rounded-full bg-white dark:bg-white/10 flex items-center justify-center text-sm font-bold text-slate-800 dark:text-slate-200 shadow-sm group-hover:translate-x-1 group-hover:bg-amber-400 group-hover:text-slate-950 transition-all shrink-0" aria-hidden="true">
                →
              </span>
            </div>
            <p class="text-xs font-bold text-amber-700 dark:text-amber-300 mb-1">
              {site.tagline}
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {site.description}
            </p>
          </a>
        ))}
      </section>

      <!-- ALL OTHER APPS GRID -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="sites-grid">
        {SITES.filter(s => !s.highlight).map((site) => (
          <a
            href={site.url}
            class={`refraction-panel refraction-card site-card block p-5 rounded-2xl bg-gradient-to-br ${site.bgGradient} border border-black/[0.08] dark:border-white/[0.1] ${site.accentBorder} group relative`}
            data-category={site.category}
            data-name={site.name.toLowerCase()}
            data-tagline={site.tagline.toLowerCase()}
          >
            <div class="flex items-start justify-between gap-3 mb-2">
              <div class="flex items-center gap-2.5">
                <span class="text-3xl filter drop-shadow group-hover:scale-110 transition-transform" aria-hidden="true">{site.icon}</span>
                <div>
                  <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-slate-200 dark:bg-white/10 text-slate-800 dark:text-slate-300 inline-block mb-0.5">
                    {site.badge}
                  </span>
                  <h3 class="text-base font-bold text-slate-950 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                    {site.name}
                  </h3>
                </div>
              </div>
              <span class="w-8 h-8 rounded-full bg-white dark:bg-white/10 flex items-center justify-center text-xs font-bold text-slate-700 dark:text-slate-300 shadow-sm group-hover:translate-x-1 group-hover:bg-amber-400 group-hover:text-slate-950 transition-all shrink-0" aria-hidden="true">
                →
              </span>
            </div>
            <p class="text-[11px] font-semibold text-slate-700 dark:text-slate-200 mb-1">
              {site.tagline}
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
              {site.description}
            </p>
          </a>
        ))}
      </section>

      <!-- Empty Search Notice -->
      <div id="no-results" class="hidden p-12 text-center refraction-panel rounded-3xl">
        <span class="text-4xl block mb-2" aria-hidden="true">🔍</span>
        <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">No websites match your search</h3>
        <p class="text-xs text-slate-500 mt-1">Try searching for "Type", "Atom", "Classroom", "Maths", or click "All Apps".</p>
      </div>

      <!-- Quick Bookmarks Hint Bar -->
      <footer class="refraction-panel rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400">
        <div class="flex items-center gap-2">
          <span class="text-base" aria-hidden="true">⭐</span>
          <span>
            <strong>Pro Tip:</strong> All these sites are also pinned directly on your Bookmarks Bar at the top of Google Chrome!
          </span>
        </div>
        <div class="flex items-center gap-3 font-mono text-[11px]">
          <span>Protected by Nesta Web Guard</span>
          <span>•</span>
          <a href="https://tinykite.co/typeracer/" class="text-amber-600 dark:text-amber-400 font-bold hover:underline">Play TypeRacer 🏎️</a>
        </div>
      </footer>

    </div>
  </main>

  <script>
    // Live Clock & Greeting
    (() => {
      const clockEl = document.getElementById('live-clock');
      const updateClock = () => {
        if (!clockEl) return;
        const now = new Date();
        clockEl.textContent = '• ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ', ' + now.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
      };
      updateClock();
      setInterval(updateClock, 30000);

      // Search & Category Filters
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const cards = Array.from(document.querySelectorAll('.site-card')) as HTMLElement[];
      const filterBtns = Array.from(document.querySelectorAll('.category-filter-btn')) as HTMLButtonElement[];
      const noResults = document.getElementById('no-results');

      let currentCategory = 'all';
      let currentQuery = '';

      const applyFilters = () => {
        let visibleCount = 0;
        cards.forEach((card) => {
          const category = card.dataset.category || '';
          const name = card.dataset.name || '';
          const tagline = card.dataset.tagline || '';

          const matchesCategory = currentCategory === 'all' || category === currentCategory;
          const matchesQuery = !currentQuery || name.includes(currentQuery) || tagline.includes(currentQuery);

          const isVisible = matchesCategory && matchesQuery;
          card.classList.toggle('hidden', !isVisible);
          if (isVisible) visibleCount++;
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      };

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          currentQuery = searchInput.value.trim().toLowerCase();
          applyFilters();
        });
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.className = 'category-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white/70 dark:bg-slate-900/70 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 border border-black/[0.06] dark:border-white/[0.08] min-h-[40px]';
          });
          btn.className = 'category-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-slate-900 text-white dark:bg-amber-400 dark:text-slate-950 shadow-sm min-h-[40px]';

          currentCategory = btn.dataset.filter || 'all';
          applyFilters();
        });
      });
    })();
  </script>
</Layout>
