---
import Layout from "../../layouts/Layout.astro";

const apps = [
  {
    name: "Nesta",
    tagline: "Your family's private messenger.",
    description: "A private messenger for one household — no public feed, no strangers, no ads. Grown-ups hold the keys; children join with a parent-issued QR and never need an email or a password.",
    icon: "/nesta/icon-512.png",
    accent: "#e85d2f",
    badge: "Lifestyle",
    actionUrl: "/nesta",
    actionLabel: "Discover Nesta"
  },
  {
    name: "Gloss",
    tagline: "The word from your book — made clear in a breath.",
    description: "A calm, offline-first reading companion. Type a few letters, get one short meaning in words a child can read, and get back to the book. No account, no ads, no tracking.",
    icon: "/gloss/icon-512.png",
    accent: "#2f9e8f",
    badge: "Education",
    actionUrl: "/gloss",
    actionLabel: "Discover Gloss"
  },
  {
    name: "Hold",
    tagline: "Your baby's own pattern, built one tap at a time.",
    description: "A calm companion for the third trimester. One tap logs a movement, a pattern builds from what you log, and Labor Mode times contractions with 5-1-1 guidance when it's time. Works offline; no account required.",
    icon: "/hold/icon-512.png",
    accent: "#c67139",
    badge: "Pregnancy",
    actionUrl: "/hold",
    actionLabel: "Discover Hold"
  },
  {
    name: "TinyKite Router",
    tagline: "Your family's central AI hub.",
    description: "Manage access, set usage limits, and securely store API keys for your entire family in one centralized dashboard. Pay only for exactly what you use—no hidden fees, no redundant monthly subscriptions.",
    icon: "/assets/router_icon.png",
    accent: "#3b6ff5",
    badge: "Infrastructure",
    actionUrl: "/router",
    actionLabel: "Manage Hub"
  },
  {
    name: "TinyKite Water",
    tagline: "Your friendly desktop hydration buddy.",
    description: "TinyKite Water lives quietly in your macOS menu bar and walks across your screen to remind you to drink water. Fully customizable, completely free, and offline-first.",
    icon: "/water/avatar.svg",
    accent: "#4dabf7",
    badge: "Utility",
    actionUrl: "/water",
    actionLabel: "Discover Water"
  },
];
---

<Layout title="Apps Directory | TinyKite" description="Explore the unified TinyKite ecosystem of apps.">
  <main class="min-h-screen bg-brand-cream pt-32 pb-24 relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">

      <div class="text-center mb-20 animate-fade-in-up">
        <h1 class="text-4xl md:text-5xl font-black mb-6 text-brand-navy tracking-tight">
          The App <span class="text-brand-slate">Directory</span>
        </h1>
        <p class="text-brand-slate text-lg max-w-2xl mx-auto leading-relaxed">
          Explore our unified family of AI assistants, beautiful mobile apps, and secure infrastructure.
        </p>
      </div>

      <!-- Premium Grid Layout (matches AppShowcase) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto mb-16">
        {apps.map((app, index) => (
          <div class="reveal-on-scroll" style={`transition-delay: ${(index % 3) * 0.15}s`}>
            <div class="spotlight-card group relative h-full bg-white rounded-3xl border border-brand-mist overflow-hidden hover:border-brand-navy/25 transition-all duration-500 flex flex-col hover:shadow-[0_16px_48px_rgba(11,16,32,0.1)]">

              <!-- Logo Area: the app's own icon on a branded glow -->
              <div
                class="relative aspect-[16/10] overflow-hidden flex items-center justify-center bg-brand-cream/60"
                style={`background-image: radial-gradient(115% 90% at 50% 22%, ${app.accent}26, transparent 68%);`}
              >
                <img
                  src={app.icon}
                  alt={`${app.name} logo`}
                  width="120"
                  height="120"
                  class="w-[120px] h-[120px] rounded-[24%] shadow-xl ring-1 ring-brand-navy/10 transform group-hover:scale-105 group-hover:-rotate-2 transition duration-500 ease-out"
                />
                <div class="absolute top-5 left-5 z-20">
                  <span class="inline-block px-3 py-1 rounded-full bg-white/80 backdrop-blur-md text-brand-navy text-xs font-bold border border-brand-mist">
                    {app.badge}
                  </span>
                </div>
              </div>

              <!-- Content Area -->
              <div class="p-8 flex flex-col flex-grow relative z-20">
                <h3 class="text-2xl font-bold tracking-tight mb-1 text-brand-navy">{app.name}</h3>
                <p class="text-brand-slate font-bold text-xs tracking-wider mb-4 uppercase">{app.tagline}</p>
                <p class="text-brand-slate text-[15px] leading-relaxed mb-8 flex-grow">
                  {app.description}
                </p>

                <!-- Dynamic Action Links -->
                <div class="mt-auto">
                  <a href={app.actionUrl} class="inline-flex items-center gap-2 font-bold text-sm text-brand-navy hover:text-brand-gold transition-colors">
                    {app.actionLabel}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>
