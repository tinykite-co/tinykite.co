---
import Layout from '../../layouts/Layout.astro';
import { PASSAGES } from '../../data/typeracer/passages';

const pageTitle = "11+ TypeRacer | Classic Literature P2P & Multi-Bot Typing Arena | TinyKite";
const pageDescription = "100% ad-free TypeRacer built for 11+ preparation. Speed-type authentic classic literature from Project Gutenberg with peer-to-peer multiplayer, realistic bot racers, and newline Q&A typing drills.";

const initialPassage = PASSAGES[0];
const initialWords = initialPassage.text.split(' ');
---

<Layout title={pageTitle} description={pageDescription}>
  <style is:inline>
    .tk-typeracer-root {
      font-family: 'Satoshi', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    #qa-followup-view,
    #grand-results-view,
    #library-modal,
    #vocab-drawer,
    #typing-error-tag,
    #qa-error-tag {
      display: none;
    }
    .tr-track-surface {
      background: linear-gradient(180deg, #0e1526 0%, #080c16 100%);
      position: relative;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.5);
    }
    .tr-finish-line {
      position: absolute;
      right: 20px;
      top: 0;
      bottom: 0;
      width: 14px;
      background: repeating-conic-gradient(#ffffff 0 90deg, #111827 0 180deg) 0 0/8px 8px;
      opacity: 0.8;
      z-index: 2;
      border-left: 1px solid rgba(255, 255, 255, 0.4);
      border-right: 1px solid rgba(255, 255, 255, 0.4);
    }
    .tr-word-done {
      color: #10b981;
      font-weight: 500;
    }
    .tr-word-current {
      background: rgba(255, 178, 60, 0.18);
      border-radius: 4px;
      padding: 0 4px;
      box-shadow: 0 0 0 1px rgba(255, 178, 60, 0.4);
    }
    .tr-char-correct {
      color: #10b981;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: #10b981;
      text-decoration-thickness: 2px;
    }
    .tr-char-error {
      background-color: rgba(244, 63, 94, 0.25);
      color: #e11d48;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: #e11d48;
      text-decoration-thickness: 2px;
      border-radius: 2px;
    }
    .tr-char-pending {
      color: inherit;
    }
    .tr-word-upcoming {
      color: #64748b;
    }
    .dark .tr-word-upcoming {
      color: #94a3b8;
    }
    .tr-racer-transition {
      transition: left 0.12s linear;
    }
    @keyframes pulse-gold {
      0%, 100% { box-shadow: 0 0 0 0 rgba(255, 178, 60, 0.4); }
      50% { box-shadow: 0 0 0 6px rgba(255, 178, 60, 0); }
    }
    .pulse-gold {
      animation: pulse-gold 2s infinite;
    }
  </style>

  <main class="tk-typeracer-root min-h-screen bg-brand-cream dark:bg-brand-navy pt-5 pb-16 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <!-- TOP BAR: 100% Ad-Free Guarantee Banner -->
      <div class="mb-3.5 flex flex-wrap items-center justify-between gap-2 bg-white/80 dark:bg-brand-navy-light/80 backdrop-blur-md border border-brand-mist dark:border-white/10 rounded-2xl px-4 py-2 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-semibold text-brand-navy dark:text-brand-cream">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-black">✓</span>
          <span><strong class="text-emerald-600 dark:text-emerald-400">100% Ad-Free</strong> • Project Gutenberg 11+ Classic Literature TypeRacer</span>
        </div>
        <div class="flex items-center gap-2">
          <button id="btn-open-library" type="button" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors border border-brand-mist dark:border-white/10">
            📚 Books (<span id="library-count">{PASSAGES.length}</span>)
          </button>
          <button id="btn-toggle-sound" type="button" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors border border-brand-mist dark:border-white/10">
            <span id="sound-icon">🔊</span> <span id="sound-label" class="hidden sm:inline">Sound</span>
          </button>
        </div>
      </div>

      <!-- MAIN UNIFIED GAME CARD -->
      <div id="arena-container" class="bg-white dark:bg-brand-navy-light border border-brand-mist dark:border-white/10 rounded-3xl p-4 sm:p-6 shadow-md relative">

        <!-- 1. Citation & Control Strip -->
        <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-brand-mist dark:border-white/10 pb-3 mb-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="text-2xl shrink-0">📖</span>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 id="passage-title" class="text-base font-bold text-brand-navy dark:text-brand-cream truncate">
                  {initialPassage.title}
                </h2>
                <span id="passage-difficulty" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                  {initialPassage.difficulty}
                </span>
                <span id="race-mode-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-brand-gold/20 text-amber-800 dark:text-brand-gold">
                  📖 11+ Context (Passage + Q&A)
                </span>
              </div>
              <p id="passage-author" class="text-xs text-brand-slate dark:text-gray-400 truncate">
                by {initialPassage.author} ({initialPassage.year}) • {initialPassage.chapter}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-1.5 sm:gap-2">
            <button id="btn-toggle-vocab" type="button" class="px-2 py-1 text-xs font-semibold rounded-lg bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors flex items-center gap-1">
              <span>💡</span> Vocab (<span id="vocab-count">{initialPassage.vocabulary.length}</span>)
            </button>
            <button id="btn-next-passage" type="button" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy hover:opacity-90 active:scale-95 transition-all flex items-center gap-1">
              <span>🎲 Next Book</span>
            </button>
            <a id="passage-gutenberg-link" href={initialPassage.gutenbergUrl} target="_blank" rel="noopener noreferrer" class="px-2 py-1 text-xs font-semibold rounded-lg bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:text-brand-gold transition-colors inline-flex items-center gap-1" title="Read full book on Gutenberg.org">
              <span>#<span id="passage-gutenberg-id">{initialPassage.gutenbergId}</span></span> ↗
            </a>
          </div>
        </div>

        <!-- Vocabulary Popover Drawer -->
        <div id="vocab-drawer" class="mb-3 bg-brand-cream/80 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-xs">
          <h4 class="font-bold text-brand-navy dark:text-brand-cream mb-1.5 flex items-center gap-1">
            <span>✨</span> 11+ Vocabulary in this passage:
          </h4>
          <div id="vocab-list" class="grid sm:grid-cols-3 gap-2">
            {initialPassage.vocabulary.map(v => (
              <div class="p-2 rounded-xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10">
                <span class="font-bold text-brand-navy dark:text-brand-cream">{v.word}:</span>
                <span class="text-brand-slate dark:text-gray-300 ml-1">{v.definition}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- ============================================ -->
        <!-- PHASE 1: 4-LANE MULTIPLAYER / BOT RACING     -->
        <!-- ============================================ -->
        <div id="typing-race-view">

          <!-- Matchmaking Lobby & Peer Status Strip -->
          <div id="lobby-bar" class="mb-2 px-3 py-1.5 rounded-xl bg-brand-navy/5 dark:bg-white/5 border border-brand-mist dark:border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2">
              <span id="lobby-pulse-icon" class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              <span id="lobby-status-text" class="font-bold text-brand-navy dark:text-brand-cream">
                🚦 Matchmaking: Waiting for other racers... (<span id="lobby-timer-num">5</span>s)
              </span>
              <span id="lobby-racers-summary" class="hidden sm:inline text-brand-slate dark:text-gray-400">
                • 1 Player (You) + 3 Bots queued
              </span>
            </div>
            <div class="flex items-center gap-1.5">
              <button id="btn-start-race-now" type="button" class="px-2 py-0.5 rounded-lg text-xs font-black bg-brand-gold text-brand-navy hover:opacity-90 active:scale-95 transition-all">
                ⚡ Start Now
              </button>
              <button id="btn-invite-link" type="button" class="px-2 py-0.5 rounded-lg text-xs font-semibold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-all flex items-center gap-1">
                <span>🔗</span> <span id="invite-btn-label">Invite Friend</span>
              </button>
            </div>
          </div>

          <!-- 4-Lane Race Track -->
          <div class="tr-track-surface p-2.5 space-y-1.5 overflow-hidden mb-3">
            <div class="tr-finish-line"></div>

            <!-- LANE 0: YOU (Player) -->
            <div class="relative flex items-center h-7 z-10">
              <div class="absolute inset-x-0 h-0.5 bg-amber-400/20 rounded-full"></div>
              <div id="racer-0" class="tr-racer-transition absolute left-0 flex items-center gap-1 select-none" style="left: 0%;">
                <span class="text-lg filter drop-shadow">🏎️</span>
                <span id="racer-0-wpm" class="text-[9px] font-black px-1.5 py-0.2 rounded-full bg-brand-gold text-brand-navy whitespace-nowrap shadow-sm">
                  0 WPM
                </span>
                <span class="text-[9px] font-bold text-white bg-amber-600/90 px-1 py-0.2 rounded">You</span>
                <span id="racer-0-medal" class="hidden text-xs">🥇</span>
              </div>
            </div>

            <!-- LANE 1: RACER 2 (Peer or Bot 1) -->
            <div class="relative flex items-center h-7 z-10 border-t border-dashed border-white/10 pt-0.5">
              <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
              <div id="racer-1" class="tr-racer-transition absolute left-0 flex items-center gap-1 select-none" style="left: 0%;">
                <span id="racer-1-avatar" class="text-base filter drop-shadow">🏎️</span>
                <span id="racer-1-wpm" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1 py-0.2 rounded whitespace-nowrap">
                  0 WPM
                </span>
                <span id="racer-1-name" class="text-[9px] font-medium text-slate-400 bg-black/40 px-1 py-0.2 rounded truncate max-w-[90px]">
                  Cadence_Pro
                </span>
                <span id="racer-1-badge" class="text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded">BOT</span>
                <span id="racer-1-medal" class="hidden text-xs">🥈</span>
              </div>
            </div>

            <!-- LANE 2: RACER 3 (Peer or Bot 2) -->
            <div class="relative flex items-center h-7 z-10 border-t border-dashed border-white/10 pt-0.5">
              <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
              <div id="racer-2" class="tr-racer-transition absolute left-0 flex items-center gap-1 select-none" style="left: 0%;">
                <span id="racer-2-avatar" class="text-base filter drop-shadow">🚗</span>
                <span id="racer-2-wpm" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1 py-0.2 rounded whitespace-nowrap">
                  0 WPM
                </span>
                <span id="racer-2-name" class="text-[9px] font-medium text-slate-400 bg-black/40 px-1 py-0.2 rounded truncate max-w-[90px]">
                  Oliver_T
                </span>
                <span id="racer-2-badge" class="text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded">BOT</span>
                <span id="racer-2-medal" class="hidden text-xs">🥉</span>
              </div>
            </div>

            <!-- LANE 3: RACER 4 (Peer or Bot 3) -->
            <div class="relative flex items-center h-7 z-10 border-t border-dashed border-white/10 pt-0.5">
              <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
              <div id="racer-3" class="tr-racer-transition absolute left-0 flex items-center gap-1 select-none" style="left: 0%;">
                <span id="racer-3-avatar" class="text-base filter drop-shadow">🚕</span>
                <span id="racer-3-wpm" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1 py-0.2 rounded whitespace-nowrap">
                  0 WPM
                </span>
                <span id="racer-3-name" class="text-[9px] font-medium text-slate-400 bg-black/40 px-1 py-0.2 rounded truncate max-w-[90px]">
                  Jane_Eyre
                </span>
                <span id="racer-3-badge" class="text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded">BOT</span>
                <span id="racer-3-medal" class="hidden text-xs"></span>
              </div>
            </div>

          </div>

          <!-- Live HUD Strip -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-3.5 py-2 bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-xl text-xs font-semibold mb-3">
            <div class="flex items-center gap-3 sm:gap-4 flex-wrap">
              <div class="flex items-center gap-1">
                <span class="text-brand-slate dark:text-gray-400">Position:</span>
                <span id="hud-rank" class="px-2 py-0.5 rounded-md font-black bg-brand-gold text-brand-navy">
                  1st / 4
                </span>
              </div>
              <div>Speed: <strong id="hud-wpm" class="text-sm font-black text-brand-navy dark:text-brand-cream">0</strong> WPM</div>
              <div>Accuracy: <strong id="hud-accuracy" class="text-sm font-black text-emerald-600 dark:text-emerald-400">100</strong>%</div>
              <div>Time: <strong id="hud-time" class="text-sm font-black text-brand-navy dark:text-brand-cream">0:00</strong></div>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
              <div class="flex items-center gap-1">
                <span class="text-brand-slate dark:text-gray-400 text-[11px]">Mode:</span>
                <select id="mode-select" class="bg-transparent font-bold text-brand-navy dark:text-brand-gold cursor-pointer text-xs focus:outline-none">
                  <option value="random" selected>🎲 Random Q&A (50%)</option>
                  <option value="always">📖 Always with Q&A</option>
                  <option value="sprint">⚡ Speed Sprint Only</option>
                </select>
              </div>
              <div>Progress: <strong id="hud-progress" class="text-sm font-black text-brand-gold">0</strong>%</div>
            </div>
          </div>

          <!-- Passage Words Display Box -->
          <div id="passage-display" class="p-4 sm:p-5 bg-brand-cream/40 dark:bg-white/[0.02] border border-brand-mist dark:border-white/10 rounded-2xl text-base sm:text-lg leading-relaxed tracking-wide select-none mb-3 min-h-[90px]">
            {initialWords.map((word, idx) => (
              idx === 0 ? (
                <span class="tr-word-current"><span class="tr-char-pending">{word}</span></span>
              ) : (
                <span class="tr-word-upcoming"> {word}</span>
              )
            ))}
          </div>

          <!-- Typing Input Field -->
          <div class="relative">
            <input
              id="typing-input"
              type="text"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="Click here and type to race..."
              class="w-full px-4 py-3 text-base sm:text-lg rounded-xl bg-white dark:bg-brand-navy border-2 border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all shadow-inner"
            />
            <div class="mt-1.5 flex items-center justify-between text-xs text-brand-slate dark:text-gray-400 px-1">
              <span>💡 Press <kbd class="px-1 py-0.2 rounded bg-brand-cream dark:bg-white/10 font-mono text-[10px] border border-brand-mist dark:border-white/10">Space</kbd> after each word. Starts on first keypress.</span>
              <span id="typing-error-tag" class="text-rose-500 font-bold">Incorrect letter! Press Backspace.</span>
            </div>
          </div>

        </div>

        <!-- ============================================ -->
        <!-- PHASE 2: 11+ CONTEXT Q&A TYPING FOLLOW-UP    -->
        <!-- ============================================ -->
        <div id="qa-followup-view">
          <div class="mb-3.5 bg-brand-gold/15 border border-brand-gold/40 rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-2.5">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl">📖</span>
              <div>
                <h3 class="font-bold text-sm text-brand-navy dark:text-brand-cream flex items-center gap-2">
                  <span>Race Finished in <span id="qa-user-rank-badge" class="px-2 py-0.2 rounded bg-brand-gold text-brand-navy font-black text-xs">1st Place!</span></span>
                  <span class="text-xs text-brand-slate dark:text-gray-400 font-normal">(Speed: <strong id="qa-finish-wpm" class="text-emerald-600 dark:text-emerald-400">0</strong> WPM)</span>
                </h3>
                <p class="text-xs text-brand-slate dark:text-gray-400">
                  Follow-Up Context Drill: Type the Question & Answer to practice newlines (Enter ↵) and dialogue.
                </p>
              </div>
            </div>
            <button id="btn-skip-qa" type="button" class="px-3 py-1 rounded-xl text-xs font-bold bg-white dark:bg-white/10 border border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream hover:bg-brand-cream/60 dark:hover:bg-white/20 transition-all flex items-center gap-1">
              <span>Skip to Results ➔</span>
            </button>
          </div>

          <!-- Q&A Typing Card -->
          <div class="bg-white dark:bg-brand-navy border-2 border-brand-gold/70 rounded-2xl p-4 sm:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-black uppercase tracking-wider text-brand-gold flex items-center gap-1">
                <span>✨</span> 11+ Comprehension & Format Typing
              </span>
              <span id="qa-newline-cue" class="text-xs font-bold px-2 py-0.5 rounded-full bg-brand-teal/15 text-brand-teal dark:text-emerald-300">
                ⌨️ Type line 1, then press Enter ↵
              </span>
            </div>

            <!-- Q&A Target Text Display with Newline Support -->
            <div id="qa-display-box" class="p-4 bg-brand-cream/40 dark:bg-white/[0.03] border border-brand-mist dark:border-white/10 rounded-xl text-base sm:text-lg leading-relaxed select-none mb-3 font-mono">
              <div id="qa-line-1" class="mb-2"></div>
              <div id="qa-line-2"></div>
            </div>

            <!-- Q&A Typing Input -->
            <div class="relative">
              <input
                id="qa-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Type the question above and press Enter..."
                class="w-full px-4 py-2.5 text-base rounded-xl bg-brand-cream/30 dark:bg-brand-navy-light border border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all"
              />
              <div class="mt-1.5 flex items-center justify-between text-xs text-brand-slate dark:text-gray-400 px-1">
                <span id="qa-instruction-label">Type the Question first. When finished, press <strong>Enter ↵</strong> to type the Answer.</span>
                <span id="qa-error-tag" class="text-rose-500 font-bold">Incorrect letter! Press Backspace.</span>
              </div>
            </div>

            <!-- Context Note Card (Revealed upon finishing Q&A) -->
            <div id="qa-context-reveal" class="hidden mt-3 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-xs text-emerald-900 dark:text-emerald-200">
              <div class="font-black text-xs uppercase tracking-wider mb-1 flex items-center gap-1">
                <span>🎓</span> 11+ Context Note:
              </div>
              <p id="qa-context-note-text" class="italic leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- ============================================ -->
        <!-- PHASE 3: 4-RACER PODIUM & GRAND RESULTS      -->
        <!-- ============================================ -->
        <div id="grand-results-view">
          <div class="text-center py-2 mb-3">
            <span id="results-badge-icon" class="text-4xl inline-block mb-1 animate-bounce">🏆</span>
            <span id="results-rank-pill" class="block mx-auto w-fit px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-brand-gold text-brand-navy mb-1">
              1st Place Victory!
            </span>
            <h2 class="text-2xl font-black text-brand-navy dark:text-brand-cream tracking-tight mb-0.5">
              Race Completed!
            </h2>
            <p id="results-subtitle" class="text-xs text-brand-slate dark:text-gray-300 max-w-md mx-auto">
              Superb performance across speed typing, peer competition, and 11+ classic literature.
            </p>
          </div>

          <!-- 4-Racer Leaderboard Podium Grid -->
          <div class="mb-4 bg-brand-cream/50 dark:bg-white/[0.03] border border-brand-mist dark:border-white/10 rounded-2xl p-3 sm:p-4">
            <h4 class="font-black text-xs uppercase tracking-wider text-brand-navy dark:text-brand-cream mb-2 flex items-center gap-1.5">
              <span>🏁</span> Official Race Finish Board:
            </h4>
            <div id="podium-grid" class="space-y-1.5">
              <!-- Dynamically populated 4 racers -->
            </div>
          </div>

          <!-- Player Performance 4-Stat Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-2.5 text-center">
              <span class="block text-[10px] font-black uppercase tracking-wider text-brand-slate dark:text-gray-400">Typing Speed</span>
              <span id="final-wpm" class="text-xl font-black text-brand-navy dark:text-brand-cream">0</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">WPM</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-2.5 text-center">
