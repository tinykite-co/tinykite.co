    function switchAppTab(tab) {
      const activeClass = 'px-5 py-2 rounded-full text-xs font-bold transition-all bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy shadow-sm';
      const inactiveClass = 'px-5 py-2 rounded-full text-xs font-bold transition-all text-brand-slate dark:text-gray-300 hover:text-brand-navy dark:hover:text-white';

      if (tabBtnArena) tabBtnArena.className = tab === 'arena' ? activeClass : inactiveClass;
      if (tabBtnLessons) tabBtnLessons.className = tab === 'lessons' ? activeClass : inactiveClass;
