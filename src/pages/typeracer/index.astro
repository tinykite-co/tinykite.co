    function switchAppTab(tab) {
      currentAppTab = tab;
      const activeClass = 'px-5 py-2 rounded-full text-xs font-bold transition-all bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500';
      const inactiveClass = 'px-5 py-2 rounded-full text-xs font-bold transition-all text-slate-700 dark:text-gray-300 hover:text-brand-navy dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500';

      if (tabBtnArena) {
        tabBtnArena.className = tab === 'arena' ? activeClass : inactiveClass;
        tabBtnArena.setAttribute('aria-selected', tab === 'arena' ? 'true' : 'false');
      }
      if (tabBtnLessons) {
        tabBtnLessons.className = tab === 'lessons' ? activeClass : inactiveClass;
        tabBtnLessons.setAttribute('aria-selected', tab === 'lessons' ? 'true' : 'false');
      }
      if (tabBtnLibrary) {
        tabBtnLibrary.className = tab === 'library' ? activeClass : inactiveClass;
        tabBtnLibrary.setAttribute('aria-selected', tab === 'library' ? 'true' : 'false');
      }

      if (tabArenaView) tabArenaView.style.display = tab === 'arena' ? 'block' : 'none';
      if (tabLessonsView) tabLessonsView.style.display = tab === 'lessons' ? 'block' : 'none';
      if (tabLibraryView) tabLibraryView.style.display = tab === 'library' ? 'block' : 'none';

      if (tab === 'lessons') {
        renderCurriculumGrid();
        loadLesson(currentLessonIndex);
      } else if (tab === 'library') {
        renderFullLibrary();
      }
    }

    if (tabBtnArena) tabBtnArena.addEventListener('click', () => switchAppTab('arena'));
    if (tabBtnLessons) tabBtnLessons.addEventListener('click', () => switchAppTab('lessons'));
    if (tabBtnLibrary) tabBtnLibrary.addEventListener('click', () => switchAppTab('library'));

    // Mode Selector Handler
    if (modeSelect) {
      modeSelect.addEventListener('change', function() {
        followupMode = modeSelect.value;
        determineQAMode();
      });
    }

    function determineQAMode() {
      if (followupMode === 'always') currentRaceHasQA = true;
      else if (followupMode === 'sprint') currentRaceHasQA = false;
      else currentRaceHasQA = Math.random() < 0.5;

      if (raceModeBadge) {
        if (currentRaceHasQA) {
          raceModeBadge.textContent = '📖 11+ Context (Passage + Q&A)';
          raceModeBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-brand-gold/25 text-amber-950 dark:text-amber-200';
        } else {
          raceModeBadge.textContent = '⚡ Speed Sprint (Passage Only)';
          raceModeBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-900 dark:bg-blue-900/40 dark:text-blue-300';
        }
      }
    }

    // Load Passage
    let botSimulationInterval = null;
    let lobbyCountdownInterval = null;

    function loadPassage(index, announceP2P = true) {
      currentPassageIndex = index;
      currentPassage = passages[currentPassageIndex];
      words = currentPassage.text.split(' ');
      currentWordIndex = 0;
      currentInput = '';
      isRaceActive = false;
      isRaceFinished = false;
      raceStartTime = 0;
      raceEndTime = 0;
      totalKeystrokes = 0;
      errorKeystrokes = 0;
      rankCounter = 1;

      determineQAMode();

      if (hudTimerInterval) clearInterval(hudTimerInterval);
      if (botSimulationInterval) clearInterval(botSimulationInterval);
      if (lobbyCountdownInterval) clearInterval(lobbyCountdownInterval);

      if (typingRaceView) typingRaceView.style.display = 'block';
      if (qaFollowupView) qaFollowupView.style.display = 'none';
      if (grandResultsView) grandResultsView.style.display = 'none';
      if (vocabDrawer) vocabDrawer.style.display = 'none';

      if (passageTitle) passageTitle.textContent = currentPassage.title;
      if (passageAuthor) passageAuthor.textContent = 'by ' + currentPassage.author + ' (' + currentPassage.year + ') • ' + currentPassage.chapter;
      if (passageDifficulty) {
        passageDifficulty.textContent = currentPassage.difficulty;
        if (currentPassage.difficulty === 'Foundation') {
          passageDifficulty.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-300';
        } else if (currentPassage.difficulty === 'Standard 11+') {
          passageDifficulty.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-900 dark:bg-blue-900/40 dark:text-blue-300';
        } else {
          passageDifficulty.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-purple-100 text-purple-900 dark:bg-purple-900/40 dark:text-purple-300';
        }
      }
      if (passageGutenbergLink) {
        passageGutenbergLink.href = currentPassage.gutenbergUrl;
        passageGutenbergLink.innerHTML = '<span>#' + currentPassage.gutenbergId + '</span> ↗';
      }

      if (vocabCount) vocabCount.textContent = currentPassage.vocabulary.length.toString();
      if (vocabList) {
        vocabList.innerHTML = currentPassage.vocabulary.map(function(v) {
          return '<div class="p-2.5 rounded-xl bg-white dark:bg-white/5 border border-black/[0.04] dark:border-white/[0.06]">' +
            '<span class="font-bold text-slate-900 dark:text-slate-100">' + v.word + ':</span>' +
            '<span class="text-slate-600 dark:text-gray-300 ml-1">' + v.definition + '</span>' +
            '</div>';
        }).join('');
      }

      racers[0].progress = 0;
      racers[0].currentWpm = 0;
      racers[0].rank = null;
      racers[0].finishTime = null;

      const playerRacerEl = document.getElementById('racer-0');
      const playerWpmEl = document.getElementById('racer-0-wpm');
      const playerMedalEl = document.getElementById('racer-0-medal');
      if (playerRacerEl) playerRacerEl.style.left = '0%';
      if (playerWpmEl) playerWpmEl.textContent = '0 WPM';
      if (playerMedalEl) playerMedalEl.classList.add('hidden');

      randomizeBots();

      if (hudWpm) hudWpm.textContent = '0';
      if (hudAccuracy) hudAccuracy.textContent = '100';
      if (hudTime) hudTime.textContent = '0:00';
      if (hudProgress) hudProgress.textContent = '0';
      if (hudRank) hudRank.textContent = '1st / 4';

      if (typingInput) {
        typingInput.value = '';
        typingInput.disabled = false;
        typingInput.placeholder = "Click here and type to race...";
        typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
        try {
          typingInput.focus({ preventScroll: true });
        } catch (e) {}
      }
      if (typingErrorTag) typingErrorTag.style.display = 'none';

      renderPassageWords();
      startLobbyMatchmaking();

      if (announceP2P) {
        sendP2PMessage({
          type: 'LOBBY_JOIN',
          name: localRacerName,
          avatar: localRacerAvatar,
          passageIndex: currentPassageIndex
        });
      }
    }

    function startLobbyMatchmaking() {
      let lobbyCountdownSeconds = 5;
      if (lobbyBar) lobbyBar.style.display = 'flex';
      if (lobbyTimerNum) lobbyTimerNum.textContent = '5';
      if (lobbyStatusText) lobbyStatusText.innerHTML = 'Matchmaking: Waiting for other racers... (<span id="lobby-timer-num">5</span>s)';

      lobbyCountdownInterval = setInterval(function() {
        lobbyCountdownSeconds--;
        const timerEl = document.getElementById('lobby-timer-num');
        if (timerEl) timerEl.textContent = lobbyCountdownSeconds.toString();

        if (lobbyCountdownSeconds <= 0) {
          endLobbyCountdown();
        }
      }, 1000);
    }

    function endLobbyCountdown() {
      if (lobbyCountdownInterval) clearInterval(lobbyCountdownInterval);
      if (lobbyStatusText) lobbyStatusText.innerHTML = '🏁 Race in Progress! Type the text below.';
    }

    if (btnStartRaceNow) {
      btnStartRaceNow.addEventListener('click', function() {
        endLobbyCountdown();
        if (typingInput) {
          try {
            typingInput.focus({ preventScroll: true });
          } catch (e) {}
        }
      });
    }

    if (btnInviteLink) {
      btnInviteLink.addEventListener('click', function() {
        const url = window.location.origin + window.location.pathname + '?room=' + (localRacerId.slice(-4));
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function() {
            if (inviteBtnLabel) inviteBtnLabel.textContent = 'Copied Link!';
            setTimeout(function() {
              if (inviteBtnLabel) inviteBtnLabel.textContent = 'Invite Friend';
            }, 2000);
          });
        }
      });
    }

    function renderPassageWords() {
      if (!passageDisplay) return;

      const wordsHtml = words.map(function(word, wIdx) {
        if (wIdx < currentWordIndex) {
          return '<span class="tr-word-done">' + escapeHtml(word) + '</span>';
        } else if (wIdx === currentWordIndex) {
          const target = word;
          const typed = currentInput;
          let charsHtml = '';
          let isError = false;

          for (let i = 0; i < target.length; i++) {
            if (i < typed.length) {
              if (typed[i] === target[i] && !isError) {
                charsHtml += '<span class="tr-char-correct">' + escapeHtml(target[i]) + '</span>';
              } else {
                isError = true;
                charsHtml += '<span class="tr-char-error">' + escapeHtml(target[i]) + '</span>';
              }
            } else {
              charsHtml += '<span class="tr-char-pending">' + escapeHtml(target[i]) + '</span>';
            }
          }

          if (typed.length > target.length) {
            const extra = typed.slice(target.length);
            charsHtml += '<span class="tr-char-error line-through">' + escapeHtml(extra) + '</span>';
          }

          return '<span class="tr-word-current">' + charsHtml + '</span>';
        } else {
          return '<span class="tr-word-upcoming">' + escapeHtml(word) + '</span>';
        }
      }).join(' ');

      passageDisplay.innerHTML = wordsHtml;
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // --- Race Arena Typing Handler (BACKSPACE REQUIRED ON ERROR) ---
    if (typingInput) {
      typingInput.addEventListener('keydown', function(e) {
        if (!isRaceActive && !isRaceFinished && e.key.length === 1) {
          startRace();
        }

        if (e.key === ' ' && isRaceActive) {
          const currentTargetWord = words[currentWordIndex];
          const typedVal = typingInput.value.trim();

          if (typedVal === currentTargetWord) {
            e.preventDefault();
            sound.playKeyClick();
            currentWordIndex++;
            currentInput = '';
            typingInput.value = '';
            totalKeystrokes++;

            if (currentWordIndex >= words.length) {
              finishRace();
              return;
            }

            renderPassageWords();
            updateRaceStats();
          }
        }
      });

      typingInput.addEventListener('input', function() {
        if (!isRaceActive && !isRaceFinished && typingInput.value.length > 0) {
          startRace();
        }

        currentInput = typingInput.value;
        const currentTargetWord = words[currentWordIndex] || '';

        // Practice Mode: Check error and enforce Backspace
        if (currentTargetWord.startsWith(currentInput)) {
          sound.playKeyClick();
          typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.style.display = 'none';
        } else {
          sound.playError();
          errorKeystrokes++;
          typingInput.classList.add('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.style.display = 'inline';
        }

        totalKeystrokes++;
        renderPassageWords();
        updateRaceStats();
      });
    }

    function startRace() {
      if (isRaceActive) return;
      isRaceActive = true;
      raceStartTime = Date.now();
      endLobbyCountdown();

      hudTimerInterval = setInterval(updateRaceStats, 200);
      botSimulationInterval = setInterval(updateBots, 100);
    }

    function updateRaceStats() {
      if (!isRaceActive && !isRaceFinished) return;

      const elapsedSec = Math.max(0.1, (Date.now() - raceStartTime) / 1000);
      const minutes = elapsedSec / 60;

      let typedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        typedChars += words[i].length + 1;
      }
      typedChars += currentInput.length;

      const calculatedWpm = Math.max(0, Math.round((typedChars / 5) / minutes));
      racers[0].currentWpm = calculatedWpm;

      const accuracy = totalKeystrokes > 0
        ? Math.max(0, Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100))
        : 100;

      const totalPassageChars = Math.max(1, currentPassage.text.length);
      const progress = Math.min(100, Math.round((typedChars / totalPassageChars) * 100));
      racers[0].progress = progress;

      if (hudWpm) hudWpm.textContent = calculatedWpm.toString();
      if (hudAccuracy) hudAccuracy.textContent = accuracy.toString();
      if (hudProgress) hudProgress.textContent = progress.toString();

      const mins = Math.floor(elapsedSec / 60);
      const secs = Math.floor(elapsedSec % 60);
      if (hudTime) hudTime.textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;

      const playerRacerEl = document.getElementById('racer-0');
      const playerWpmEl = document.getElementById('racer-0-wpm');
      if (playerRacerEl) playerRacerEl.style.left = Math.min(92, progress * 0.92) + '%';
      if (playerWpmEl) playerWpmEl.textContent = calculatedWpm + ' WPM';

      updateRaceRankings();

      // Realtime cross-tab P2P progress broadcast
      sendP2PMessage({
        type: 'PROGRESS',
        name: localRacerName,
        avatar: localRacerAvatar,
        progress: progress,
        wpm: calculatedWpm,
        rank: racers[0].rank
      });
    }

    function updateBots() {
      if (!isRaceActive) return;

      const elapsedMinutes = (Date.now() - raceStartTime) / 60000;
      const totalCharsInPassage = currentPassage.text.length;

      for (let i = 1; i <= 3; i++) {
        const bot = racers[i];
        if (bot.isPeer) continue; // Peer movement is handled live by P2P messages!
        if (bot.progress >= 100) continue;

        const variation = 1 + (Math.sin((Date.now() / 1000) + i) * 0.12);
        const effectiveWpm = bot.targetWpm * variation;
        bot.currentWpm = Math.round(effectiveWpm);

        const charsTyped = (effectiveWpm * 5) * elapsedMinutes;
        bot.progress = Math.min(100, (charsTyped / totalCharsInPassage) * 100);

        const racerEl = document.getElementById('racer-' + i);
        const wpmEl = document.getElementById('racer-' + i + '-wpm');
        if (racerEl) racerEl.style.left = Math.min(92, bot.progress * 0.92) + '%';
        if (wpmEl) wpmEl.textContent = bot.currentWpm + ' WPM';

        if (bot.progress >= 100 && !bot.rank) {
          bot.rank = rankCounter++;
          bot.finishTime = Date.now();
          const medalEl = document.getElementById('racer-' + i + '-medal');
          if (medalEl) {
            const medals = { 1: '🥇', 2: '🥈', 3: '🥉' };
            medalEl.textContent = medals[bot.rank] || '';
            medalEl.classList.remove('hidden');
          }
        }
      }

      updateRaceRankings();
    }

    function updateRaceRankings() {
      const sorted = racers.slice().sort(function(a, b) {
        if (a.rank && b.rank) return a.rank - b.rank;
        if (a.rank) return -1;
        if (b.rank) return 1;
        return b.progress - a.progress;
      });

      const playerCurrentRank = sorted.findIndex(r => r.isPlayer) + 1;
      if (hudRank) {
        const labels = { 1: '1st', 2: '2nd', 3: '3rd', 4: '4th' };
        hudRank.textContent = (labels[playerCurrentRank] || playerCurrentRank + 'th') + ' / 4';
      }
    }

    function finishRace() {
      isRaceActive = false;
      isRaceFinished = true;
      raceEndTime = Date.now();
      if (hudTimerInterval) clearInterval(hudTimerInterval);

      if (!racers[0].rank) {
        racers[0].rank = rankCounter++;
        racers[0].finishTime = raceEndTime;
        const playerMedalEl = document.getElementById('racer-0-medal');
        if (playerMedalEl) {
          const medals = { 1: '🥇', 2: '🥈', 3: '🥉' };
          playerMedalEl.textContent = medals[racers[0].rank] || '';
          playerMedalEl.classList.remove('hidden');
        }
      }

      // Broadcast finish to peer
      sendP2PMessage({
        type: 'FINISH',
        wpm: racers[0].currentWpm,
        rank: racers[0].rank
      });

      updateCareerStats(racers[0].currentWpm, racers[0].rank === 1);

      if (currentRaceHasQA && currentPassage.qaFollowup) {
        startQAFollowup();
      } else {
        sound.playFinishChime(racers[0].rank === 1);
        showGrandResults(racers[0].currentWpm, 100, racers[0].rank);
      }
    }

    // --- Q&A Followup Engine ---
    let qaStage = 1;
    let qaTargetQ = '';
    let qaTargetA = '';
    let qaTypedQ = '';
    let qaTypedA = '';

    function startQAFollowup() {
      sound.playFinishChime(racers[0].rank === 1);
      if (typingRaceView) typingRaceView.style.display = 'none';
      if (qaFollowupView) qaFollowupView.style.display = 'block';

      const qa = currentPassage.qaFollowup;
      qaTargetQ = qa.question;
      qaTargetA = qa.answer;
      qaTypedQ = '';
      qaTypedA = '';
      qaStage = 1;

      if (qaUserRankBadge) {
        const labels = { 1: '1st Place!', 2: '2nd Place!', 3: '3rd Place!', 4: '4th Place' };
        qaUserRankBadge.textContent = labels[racers[0].rank] || racers[0].rank + 'th';
      }
      if (qaFinishWpm) qaFinishWpm.textContent = racers[0].currentWpm.toString();

      if (qaNewlineCue) {
        qaNewlineCue.textContent = '⌨️ Type Question, then press Enter ↵';
        qaNewlineCue.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-teal-100 text-teal-900 dark:bg-teal-950/50 dark:text-teal-300';
      }
      if (qaInstructionLabel) {
        qaInstructionLabel.innerHTML = 'Type Question first. When finished, press <strong>Enter ↵</strong> to type Answer.';
      }

      renderQALines();

      if (qaInput) {
        qaInput.value = '';
        qaInput.disabled = false;
        qaInput.placeholder = "Type: " + qaTargetQ.slice(0, 30) + "...";
        try {
          qaInput.focus({ preventScroll: true });
