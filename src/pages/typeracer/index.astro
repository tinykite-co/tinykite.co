---
import Layout from '../../layouts/Layout.astro';
import { PASSAGES } from '../../data/typeracer/passages';

const pageTitle = "11+ TypeRacer | Gutenberg Classic Literature Speed & Comprehension | TinyKite";
const pageDescription = "Ad-free TypeRacer built for 11+ preparation. Speed-type authentic classic literature passages from Project Gutenberg and master 11+ comprehension and vocabulary with interactive typing drills.";

const initialPassage = PASSAGES[0];
const initialWords = initialPassage.text.split(' ');
---

<Layout title={pageTitle} description={pageDescription}>
  <style is:inline>
    .tk-typeracer-root {
      font-family: 'Satoshi', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    #question-challenge-view,
    #grand-results-view,
    #library-modal,
    #vocab-drawer,
    #hint-box,
    #answer-feedback,
    #btn-reveal-answer,
    #typing-error-tag {
      display: none;
    }
    .tr-track-surface {
      background: linear-gradient(180deg, #0e1526 0%, #080c16 100%);
      position: relative;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.5);
    }
    .tr-finish-line {
      position: absolute;
      right: 24px;
      top: 0;
      bottom: 0;
      width: 14px;
      background: repeating-conic-gradient(#ffffff 0 90deg, #111827 0 180deg) 0 0/8px 8px;
      opacity: 0.75;
      z-index: 2;
      border-left: 1px solid rgba(255, 255, 255, 0.4);
      border-right: 1px solid rgba(255, 255, 255, 0.4);
    }
    .tr-word-done {
      color: #10b981;
      font-weight: 500;
    }
    .tr-word-current {
      background: rgba(255, 178, 60, 0.18);
      border-radius: 4px;
      padding: 0 4px;
      box-shadow: 0 0 0 1px rgba(255, 178, 60, 0.4);
    }
    .tr-char-correct {
      color: #10b981;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: #10b981;
      text-decoration-thickness: 2px;
    }
    .tr-char-error {
      background-color: rgba(244, 63, 94, 0.25);
      color: #e11d48;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: #e11d48;
      text-decoration-thickness: 2px;
      border-radius: 2px;
    }
    .tr-char-pending {
      color: inherit;
    }
    .tr-word-upcoming {
      color: #64748b;
    }
    .dark .tr-word-upcoming {
      color: #94a3b8;
    }
  </style>

  <main class="tk-typeracer-root min-h-screen bg-brand-cream dark:bg-brand-navy pt-6 pb-16 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <!-- TOP BAR: 100% Ad-Free Guarantee Banner -->
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2 bg-white/80 dark:bg-brand-navy-light/80 backdrop-blur-md border border-brand-mist dark:border-white/10 rounded-2xl px-4 py-2 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-semibold text-brand-navy dark:text-brand-cream">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-black">✓</span>
          <span><strong class="text-emerald-600 dark:text-emerald-400">100% Ad-Free</strong> • Project Gutenberg 11+ Classic Literature TypeRacer</span>
        </div>
        <div class="flex items-center gap-2">
          <button id="btn-open-library" type="button" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors border border-brand-mist dark:border-white/10">
            📚 Books (<span id="library-count">{PASSAGES.length}</span>)
          </button>
          <button id="btn-toggle-sound" type="button" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors border border-brand-mist dark:border-white/10">
            <span id="sound-icon">🔊</span> <span id="sound-label" class="hidden sm:inline">Sound</span>
          </button>
        </div>
      </div>

      <!-- MAIN UNIFIED GAME CARD -->
      <div id="arena-container" class="bg-white dark:bg-brand-navy-light border border-brand-mist dark:border-white/10 rounded-3xl p-5 sm:p-6 shadow-md relative">

        <!-- 1. Citation & Control Strip -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-brand-mist dark:border-white/10 pb-3 mb-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="text-2xl shrink-0">📖</span>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 id="passage-title" class="text-base font-bold text-brand-navy dark:text-brand-cream truncate">
                  {initialPassage.title}
                </h2>
                <span id="passage-difficulty" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                  {initialPassage.difficulty}
                </span>
              </div>
              <p id="passage-author" class="text-xs text-brand-slate dark:text-gray-400 truncate">
                by {initialPassage.author} ({initialPassage.year})
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button id="btn-toggle-vocab" type="button" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors flex items-center gap-1">
              <span>💡</span> Vocab (<span id="vocab-count">{initialPassage.vocabulary.length}</span>)
            </button>
            <button id="btn-next-passage" type="button" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy hover:opacity-90 active:scale-95 transition-all flex items-center gap-1">
              <span>🎲 Next Book</span>
            </button>
            <a id="passage-gutenberg-link" href={initialPassage.gutenbergUrl} target="_blank" rel="noopener noreferrer" class="px-2 py-1 text-xs font-semibold rounded-lg bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:text-brand-gold transition-colors inline-flex items-center gap-1" title="Read full book on Gutenberg.org">
              <span>#<span id="passage-gutenberg-id">{initialPassage.gutenbergId}</span></span> ↗
            </a>
          </div>
        </div>

        <!-- Vocabulary Popover Drawer -->
        <div id="vocab-drawer" class="mb-3 bg-brand-cream/80 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-xs">
          <h4 class="font-bold text-brand-navy dark:text-brand-cream mb-1.5 flex items-center gap-1">
            <span>✨</span> 11+ Vocabulary in this passage:
          </h4>
          <div id="vocab-list" class="grid sm:grid-cols-3 gap-2">
            {initialPassage.vocabulary.map(v => (
              <div class="p-2 rounded-xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10">
                <span class="font-bold text-brand-navy dark:text-brand-cream">{v.word}:</span>
                <span class="text-brand-slate dark:text-gray-300 ml-1">{v.definition}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- ============================================ -->
        <!-- PHASE 1: TYPING RACE VIEW                    -->
        <!-- ============================================ -->
        <div id="typing-race-view">

          <!-- 2. Integrated Race Track -->
          <div class="tr-track-surface p-3 space-y-2.5 overflow-hidden mb-3">
            <div class="tr-finish-line"></div>

            <!-- LANE 1: PLAYER -->
            <div class="relative flex items-center h-10 z-10">
              <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
              <div id="player-racer" class="absolute left-0 transition-all duration-100 ease-out flex items-center gap-1 select-none" style="left: 0%;">
                <span class="text-xl filter drop-shadow">🏎️</span>
                <span id="player-wpm-pill" class="text-[10px] font-black px-1.5 py-0.5 rounded-full bg-brand-gold text-brand-navy whitespace-nowrap shadow-sm">
                  0 WPM
                </span>
                <span class="text-[9px] font-bold text-white bg-slate-800/90 px-1 py-0.2 rounded">You</span>
              </div>
            </div>

            <!-- LANE 2: PACER BOT -->
            <div id="pacer-lane" class="relative flex items-center h-8 z-10 border-t border-dashed border-white/10 pt-1">
              <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
              <div id="pacer-racer" class="absolute left-0 transition-all duration-150 ease-linear flex items-center gap-1 select-none" style="left: 0%;">
                <span class="text-base filter drop-shadow">🤖</span>
                <span id="pacer-label" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1 py-0.2 rounded whitespace-nowrap">
                  Pacer 45 WPM
                </span>
              </div>
            </div>
          </div>

          <!-- 3. Slim Live HUD Strip -->
          <div class="flex flex-wrap items-center justify-between gap-3 px-3.5 py-2 bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-xl text-xs font-semibold mb-3">
            <div class="flex items-center gap-4">
              <div>Speed: <strong id="hud-wpm" class="text-sm font-black text-brand-navy dark:text-brand-cream">0</strong> WPM</div>
              <div>Accuracy: <strong id="hud-accuracy" class="text-sm font-black text-emerald-600 dark:text-emerald-400">100</strong>%</div>
              <div>Time: <strong id="hud-time" class="text-sm font-black text-brand-navy dark:text-brand-cream">0:00</strong></div>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-1">
                <span class="text-brand-slate dark:text-gray-400 text-[11px]">Pacer:</span>
                <select id="pacer-select" class="bg-transparent font-bold text-brand-navy dark:text-brand-gold cursor-pointer text-xs focus:outline-none">
                  <option value="0">Off (Solo)</option>
                  <option value="30">30 WPM (Foundation)</option>
                  <option value="45" selected>45 WPM (11+ Goal)</option>
                  <option value="60">60 WPM (Advanced)</option>
                  <option value="80">80 WPM (Scholar)</option>
                </select>
              </div>
              <div>Progress: <strong id="hud-progress" class="text-sm font-black text-brand-gold">0</strong>%</div>
            </div>
          </div>

          <!-- 4. Passage Words Display Box (Pre-rendered for zero-delay instant display) -->
          <div id="passage-display" class="p-4 sm:p-5 bg-brand-cream/40 dark:bg-white/[0.02] border border-brand-mist dark:border-white/10 rounded-2xl text-base sm:text-lg leading-relaxed tracking-wide select-none mb-3 min-h-[90px]">
            {initialWords.map((word, idx) => (
              idx === 0 ? (
                <span class="tr-word-current"><span class="tr-char-pending">{word}</span></span>
              ) : (
                <span class="tr-word-upcoming"> {word}</span>
              )
            ))}
          </div>

          <!-- 5. Typing Input Field -->
          <div class="relative">
            <input
              id="typing-input"
              type="text"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="Click here and type to race..."
              class="w-full px-4 py-3 text-base sm:text-lg rounded-xl bg-white dark:bg-brand-navy border-2 border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all shadow-inner"
            />
            <div class="mt-1.5 flex items-center justify-between text-xs text-brand-slate dark:text-gray-400 px-1">
              <span>💡 Press <kbd class="px-1 py-0.2 rounded bg-brand-cream dark:bg-white/10 font-mono text-[10px] border border-brand-mist dark:border-white/10">Space</kbd> after each word. Starts on first keypress.</span>
              <span id="typing-error-tag" class="text-rose-500 font-bold">Incorrect letter! Press Backspace.</span>
            </div>
          </div>

        </div>

        <!-- ============================================ -->
        <!-- PHASE 2: 11+ QUESTION CHALLENGE VIEW         -->
        <!-- ============================================ -->
        <div id="question-challenge-view">
          <div class="mb-4 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl">🏁</span>
              <div>
                <h3 class="font-bold text-sm text-brand-navy dark:text-brand-cream">
                  Race Complete! Speed: <span id="finish-race-wpm" class="text-emerald-600 dark:text-emerald-400 font-black">0</span> WPM (<span id="finish-race-acc" class="font-bold">100%</span> Acc)
                </h3>
                <p class="text-xs text-brand-slate dark:text-gray-400">
                  Pit Stop Challenge: Type the answers to these 11+ questions about the text!
                </p>
              </div>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-black bg-brand-gold text-brand-navy">
              11+ Comprehension Sprint
            </span>
          </div>

          <!-- Sticky Passage Reference -->
          <div class="mb-4 bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3.5">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-black uppercase tracking-wider text-brand-slate dark:text-gray-400 flex items-center gap-1">
                <span>📖</span> Reference Passage:
              </span>
              <span class="text-[11px] text-brand-slate dark:text-gray-400">Refer back to find exact answers</span>
            </div>
            <p id="ref-passage-text" class="text-xs sm:text-sm text-brand-navy dark:text-brand-cream leading-relaxed italic">
              "{initialPassage.text}"
            </p>
          </div>

          <!-- Active Question Card -->
          <div id="question-card" class="bg-white dark:bg-brand-navy border-2 border-brand-gold/60 rounded-2xl p-4 sm:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-2.5">
              <span id="question-step" class="text-xs font-black uppercase tracking-wider text-brand-gold">
                Question 1 of 3
              </span>
              <span id="question-type-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-teal/15 text-brand-teal dark:text-emerald-300">
                Vocabulary in Context
              </span>
            </div>

            <h3 id="question-prompt" class="text-base font-bold text-brand-navy dark:text-brand-cream mb-3">
              <!-- Prompt text -->
            </h3>

            <form id="question-form" class="space-y-3">
              <div class="relative">
                <input
                  id="question-input"
                  type="text"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder="Type your answer here and press Enter..."
                  class="w-full px-4 py-2.5 text-base rounded-xl bg-brand-cream/40 dark:bg-brand-navy-light border border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all"
                />
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3">
                <button type="button" id="btn-show-hint" class="text-xs font-semibold text-brand-slate dark:text-gray-400 hover:text-brand-gold transition-colors flex items-center gap-1">
                  <span>💡</span> <span id="hint-text-label">Need a hint?</span>
                </button>

                <div class="flex items-center gap-2">
                  <button type="button" id="btn-reveal-answer" class="text-xs font-semibold text-brand-slate dark:text-gray-400 hover:text-rose-500 transition-colors">
                    Reveal Answer
                  </button>
                  <button type="submit" id="btn-submit-answer" class="px-4 py-2 bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy text-xs sm:text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all shadow-sm">
                    Submit Answer ↵
                  </button>
                </div>
              </div>

              <div id="hint-box" class="p-2.5 bg-amber-500/10 border border-amber-500/20 rounded-xl text-xs text-amber-700 dark:text-amber-300">
                <span class="font-bold">Clue:</span> <span id="hint-content"></span>
              </div>

              <div id="answer-feedback" class="p-3.5 rounded-xl text-xs sm:text-sm transition-all">
                <div class="flex items-start gap-2">
                  <span id="feedback-icon" class="text-base"></span>
                  <div>
                    <h4 id="feedback-title" class="font-bold"></h4>
                    <p id="feedback-explanation" class="text-xs mt-0.5 leading-relaxed opacity-90"></p>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- ============================================ -->
        <!-- PHASE 3: GRAND RESULTS SCREEN                -->
        <!-- ============================================ -->
        <div id="grand-results-view">
          <div class="text-center py-3">
            <span id="results-badge-icon" class="text-4xl inline-block mb-1.5 animate-bounce">🏆</span>
            <span id="results-rank-pill" class="block mx-auto w-fit px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-brand-gold text-brand-navy mb-1.5">
              11+ Scholarship Grandmaster
            </span>
            <h2 class="text-2xl font-black text-brand-navy dark:text-brand-cream tracking-tight mb-1">
              Race Completed!
            </h2>
            <p id="results-subtitle" class="text-xs text-brand-slate dark:text-gray-300 max-w-md mx-auto">
              Superb performance across speed typing and 11+ English comprehension.
            </p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5">
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[10px] font-black uppercase tracking-wider text-brand-slate dark:text-gray-400">Typing Speed</span>
              <span id="final-wpm" class="text-2xl font-black text-brand-navy dark:text-brand-cream">0</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">WPM</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[10px] font-black uppercase tracking-wider text-brand-slate dark:text-gray-400">Accuracy</span>
              <span id="final-accuracy" class="text-2xl font-black text-emerald-600 dark:text-emerald-400">100</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">%</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[10px] font-black uppercase tracking-wider text-brand-slate dark:text-gray-400">11+ Questions</span>
              <span id="final-questions" class="text-2xl font-black text-brand-gold">3/3</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">Correct</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[10px] font-black uppercase tracking-wider text-brand-slate dark:text-gray-400">Total Time</span>
              <span id="final-time" class="text-2xl font-black text-brand-navy dark:text-brand-cream">0s</span>
            </div>
          </div>

          <!-- Vocabulary Revision Box -->
          <div class="mb-5 bg-brand-cream/40 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3.5">
            <h4 class="font-bold text-xs text-brand-navy dark:text-brand-cream mb-2 flex items-center gap-1.5">
              <span>📚</span> Vocabulary Revision for this Book:
            </h4>
            <div id="results-vocab-grid" class="grid sm:grid-cols-3 gap-2">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-2.5">
            <button id="btn-results-next" type="button" class="px-5 py-2.5 bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy text-xs sm:text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all shadow-md">
              🚀 Next 11+ Race
            </button>
            <button id="btn-results-retry" type="button" class="px-4 py-2.5 bg-white dark:bg-white/10 border border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream text-xs sm:text-sm font-bold rounded-xl hover:bg-brand-cream/60 dark:hover:bg-white/20 active:scale-95 transition-all">
              🔁 Retry Passage
            </button>
            <button id="btn-share-score" type="button" class="px-4 py-2.5 bg-brand-teal text-white text-xs sm:text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all flex items-center gap-1.5">
              <span>📋</span> <span id="share-btn-text">Share Score</span>
            </button>
            <a id="results-gutenberg-btn" href="#" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 bg-brand-cream dark:bg-white/5 text-brand-navy dark:text-brand-cream border border-brand-mist dark:border-white/10 text-xs sm:text-sm font-bold rounded-xl hover:text-brand-gold transition-colors inline-flex items-center gap-1">
              <span>📖 Full Book</span> ↗
            </a>
          </div>
        </div>

      </div>

      <!-- CAREER STATS FOOTER STRIP -->
      <div class="mt-4 bg-white/80 dark:bg-brand-navy-light/80 backdrop-blur-md border border-brand-mist dark:border-white/10 rounded-2xl p-3 sm:p-4 flex flex-wrap items-center justify-between gap-3 text-xs font-semibold text-brand-navy dark:text-brand-cream shadow-sm">
        <div class="flex flex-wrap items-center gap-3 sm:gap-5">
          <span class="text-brand-slate dark:text-gray-400 uppercase tracking-wider font-bold">Your Career:</span>
          <div>Races: <strong id="career-races">0</strong></div>
          <div>Best Speed: <strong id="career-best-wpm" class="text-emerald-600 dark:text-emerald-400">0 WPM</strong></div>
          <div>Average Speed: <strong id="career-avg-wpm">0 WPM</strong></div>
          <div>11+ Solved: <strong id="career-questions" class="text-brand-gold">0</strong></div>
        </div>
        <button id="btn-reset-career" type="button" class="text-brand-slate dark:text-gray-400 hover:text-rose-500 transition-colors text-[11px]">
          Reset Stats
        </button>
      </div>

    </div>
  </main>

  <!-- BOOK LIBRARY MODAL -->
  <div id="library-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-brand-navy border border-brand-mist dark:border-white/10 rounded-3xl w-full max-w-2xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden">
      <div class="p-4 border-b border-brand-mist dark:border-white/10 flex items-center justify-between">
        <div>
          <h3 class="text-base sm:text-lg font-black text-brand-navy dark:text-brand-cream">
            Project Gutenberg 11+ Library
          </h3>
          <p class="text-xs text-brand-slate dark:text-gray-400">
            Select any classic book to race and test comprehension.
          </p>
        </div>
        <button id="btn-close-library" type="button" class="w-8 h-8 rounded-full bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream flex items-center justify-center hover:bg-brand-gold/20 font-bold transition-colors">
          ✕
        </button>
      </div>

      <div class="p-3 border-b border-brand-mist dark:border-white/10 bg-brand-cream/30 dark:bg-white/[0.02] flex flex-wrap items-center justify-between gap-2.5">
        <input
          id="library-search"
          type="text"
          placeholder="Search by book title or author..."
          class="flex-1 min-w-[180px] px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-brand-navy-light border border-brand-mist dark:border-white/10 text-brand-navy dark:text-brand-cream focus:outline-none focus:border-brand-gold"
        />
        <div class="flex items-center gap-1 text-xs">
          <button type="button" class="lib-filter-btn px-2 py-1 rounded-lg font-bold bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy" data-filter="all">All</button>
          <button type="button" class="lib-filter-btn px-2 py-1 rounded-lg font-semibold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20" data-filter="Foundation">Foundation</button>
          <button type="button" class="lib-filter-btn px-2 py-1 rounded-lg font-semibold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20" data-filter="Standard 11+">Standard 11+</button>
          <button type="button" class="lib-filter-btn px-2 py-1 rounded-lg font-semibold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20" data-filter="Advanced 11+">Advanced 11+</button>
        </div>
