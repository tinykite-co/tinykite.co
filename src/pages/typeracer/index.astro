---
import Layout from '../../layouts/Layout.astro';
import { PASSAGES } from '../../data/typeracer/passages';

const pageTitle = "11+ TypeRacer | Gutenberg Classic Literature Speed & Comprehension | TinyKite";
const pageDescription = "Ad-free TypeRacer built for 11+ preparation. Speed-type authentic classic literature passages from Project Gutenberg and master 11+ comprehension and vocabulary with interactive typing drills.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-brand-cream dark:bg-brand-navy pt-24 pb-20 transition-colors duration-300">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <!-- Ad-Free & 11+ Gutenberg Top Pill Banner -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 bg-white/80 dark:bg-brand-navy-light/80 backdrop-blur-md border border-brand-mist dark:border-white/10 rounded-2xl px-5 py-3 shadow-sm">
        <div class="flex items-center gap-2.5 text-xs sm:text-sm font-semibold text-brand-navy dark:text-brand-cream">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 text-xs font-bold">✓</span>
          <span><strong class="text-emerald-600 dark:text-emerald-400">100% Ad-Free</strong> • Authentic 11+ literature from Project Gutenberg</span>
        </div>
        <div class="flex items-center gap-2">
          <button id="btn-open-library" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors">
            📚 Book Library (<span id="library-count">{PASSAGES.length}</span>)
          </button>
          <button id="btn-toggle-sound" class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-bold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors" title="Toggle Sound">
            <span id="sound-icon">🔊</span> <span id="sound-label" class="hidden sm:inline">Sound On</span>
          </button>
        </div>
      </div>

      <!-- App Title & Setup Controls -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-gold/20 text-brand-navy dark:text-brand-gold text-xs font-bold uppercase tracking-wider mb-2">
            🏎️ 11+ Speed & Comprehension
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-brand-navy dark:text-brand-cream tracking-tight">
            Literature <span class="text-brand-gold">TypeRacer</span>
          </h1>
          <p class="text-sm text-brand-slate dark:text-gray-300 mt-1 max-w-xl">
            Race classic texts tested in GL & CEM 11+ exams. Speed-type the paragraph, then answer comprehension questions by typing!
          </p>
        </div>

        <!-- Controls: Pacer and Next Button -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5 bg-white dark:bg-brand-navy-light border border-brand-mist dark:border-white/10 rounded-xl px-3 py-2 text-xs font-semibold text-brand-navy dark:text-brand-cream shadow-sm">
            <span class="text-brand-slate dark:text-gray-400">Pacer:</span>
            <select id="pacer-select" class="bg-transparent font-bold text-brand-navy dark:text-brand-gold focus:outline-none cursor-pointer">
              <option value="0">Solo (Off)</option>
              <option value="30">Pacer: 30 WPM (Foundation)</option>
              <option value="45" selected>Pacer: 45 WPM (11+ Goal)</option>
              <option value="60">Pacer: 60 WPM (Advanced)</option>
              <option value="80">Pacer: 80 WPM (Scholar)</option>
            </select>
          </div>

          <button id="btn-next-passage" class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy text-xs sm:text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all shadow-sm">
            <span>🎲 Random Book</span>
          </button>
        </div>
      </div>

      <!-- THE RACE TRACK -->
      <div class="mb-6 bg-white dark:bg-brand-navy-light border border-brand-mist dark:border-white/10 rounded-3xl p-5 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400 mb-3 px-1">
          <span class="flex items-center gap-1.5">🚦 Start Line</span>
          <span id="race-status-text" class="text-brand-teal dark:text-brand-gold">Ready to Race</span>
          <span class="flex items-center gap-1.5">🏁 Finish Line</span>
        </div>

        <div class="relative bg-slate-900/90 dark:bg-black/60 rounded-2xl p-4 border border-slate-800 space-y-4 overflow-hidden">
          <!-- Road Asphalt Grid / Finish Line Marker -->
          <div class="absolute right-12 top-0 bottom-0 w-3 bg-[repeating-conic-gradient(#fff_0_90deg,#000_0_180deg)] bg-[length:8px_8px] opacity-40 z-0"></div>

          <!-- LANE 1: PLAYER -->
          <div class="relative flex items-center h-12 z-10">
            <div class="absolute inset-x-0 h-1 bg-white/10 rounded-full"></div>
            <!-- Player Vehicle / Runner -->
            <div id="player-racer" class="absolute left-0 -translate-y-1 transition-all duration-100 ease-out flex flex-col items-center select-none" style="left: 0%;">
              <!-- Floating Live WPM Tag -->
              <span id="player-wpm-pill" class="text-[10px] font-black px-1.5 py-0.5 rounded-full bg-brand-gold text-brand-navy whitespace-nowrap shadow-sm mb-0.5">
                0 WPM
              </span>
              <div class="flex items-center gap-1">
                <span class="text-2xl filter drop-shadow">🏎️</span>
                <span class="text-[10px] font-bold text-white bg-slate-800/80 px-1 rounded">You</span>
              </div>
            </div>
          </div>

          <!-- LANE 2: PACER BOT -->
          <div id="pacer-lane" class="relative flex items-center h-10 z-10 border-t border-dashed border-white/10 pt-2">
            <div class="absolute inset-x-0 h-1 bg-white/10 rounded-full"></div>
            <!-- Pacer Vehicle -->
            <div id="pacer-racer" class="absolute left-0 transition-all duration-150 ease-linear flex items-center gap-1 select-none" style="left: 0%;">
              <span class="text-xl filter drop-shadow">🤖</span>
              <span id="pacer-label" class="text-[10px] font-semibold text-slate-300 bg-slate-800/80 px-1 rounded whitespace-nowrap">
                Pacer 45 WPM
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- MAIN ARENA: TYPING PARAGRAPH OR QUESTIONS -->
      <div id="arena-container" class="bg-white dark:bg-brand-navy-light border border-brand-mist dark:border-white/10 rounded-3xl p-6 sm:p-8 shadow-sm relative transition-all">

        <!-- Citation Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-brand-mist dark:border-white/10 pb-4 mb-5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-brand-gold/15 flex items-center justify-center text-xl">
              📖
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 id="passage-title" class="text-lg font-bold text-brand-navy dark:text-brand-cream leading-tight">
                  The Secret Garden
                </h2>
                <span id="passage-difficulty" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                  Foundation
                </span>
              </div>
              <p id="passage-author" class="text-xs text-brand-slate dark:text-gray-400">
                by Frances Hodgson Burnett (1911) • Chapter 5
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button id="btn-toggle-vocab" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors flex items-center gap-1">
              <span>💡</span> 11+ Vocab (<span id="vocab-count">3</span>)
            </button>
            <a id="passage-gutenberg-link" href="https://www.gutenberg.org/ebooks/113" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:text-brand-gold transition-colors inline-flex items-center gap-1" title="Read full book free on Gutenberg.org">
              <span>Gutenberg #<span id="passage-gutenberg-id">113</span></span> ↗
            </a>
          </div>
        </div>

        <!-- Vocabulary Popover (Toggleable) -->
        <div id="vocab-drawer" class="hidden mb-5 bg-brand-cream/80 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-4 text-xs">
          <h4 class="font-bold text-brand-navy dark:text-brand-cream mb-2 flex items-center gap-1">
            <span>✨</span> Key 11+ Words in This Text:
          </h4>
          <div id="vocab-list" class="grid sm:grid-cols-3 gap-2">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- PHASE 1: TYPING RACE VIEW -->
        <div id="typing-race-view">
          <!-- Live HUD Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            <div class="bg-brand-cream/50 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Speed</span>
              <span id="hud-wpm" class="text-2xl font-black text-brand-navy dark:text-brand-cream">0</span>
              <span class="text-[10px] text-brand-slate dark:text-gray-400 font-bold ml-0.5">WPM</span>
            </div>
            <div class="bg-brand-cream/50 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Accuracy</span>
              <span id="hud-accuracy" class="text-2xl font-black text-emerald-600 dark:text-emerald-400">100</span>
              <span class="text-[10px] text-brand-slate dark:text-gray-400 font-bold ml-0.5">%</span>
            </div>
            <div class="bg-brand-cream/50 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Time</span>
              <span id="hud-time" class="text-2xl font-black text-brand-navy dark:text-brand-cream">0:00</span>
            </div>
            <div class="bg-brand-cream/50 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-3 text-center">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Progress</span>
              <span id="hud-progress" class="text-2xl font-black text-brand-gold">0</span>
              <span class="text-[10px] text-brand-slate dark:text-gray-400 font-bold ml-0.5">%</span>
            </div>
          </div>

          <!-- Passage Text Display Area -->
          <div id="passage-display" class="relative min-h-[130px] p-5 sm:p-6 bg-brand-cream/30 dark:bg-white/[0.03] border border-brand-mist dark:border-white/10 rounded-2xl text-lg sm:text-xl md:text-2xl leading-relaxed tracking-wide font-normal select-none mb-6 font-sans">
            <!-- Dynamic Words rendered here -->
          </div>

          <!-- Typing Input Box -->
          <div class="relative">
            <input
              id="typing-input"
              type="text"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="Start typing the passage here to begin the race..."
              class="w-full px-5 py-4 text-lg sm:text-xl rounded-2xl bg-white dark:bg-brand-navy border-2 border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all shadow-inner font-sans"
            />
            <div id="input-helper" class="mt-2 flex items-center justify-between text-xs text-brand-slate dark:text-gray-400 px-1">
              <span>💡 Tip: Press <kbd class="px-1.5 py-0.5 rounded bg-brand-cream dark:bg-white/10 font-mono text-[10px] border border-brand-mist dark:border-white/10">Space</kbd> after each word to advance. Timer starts on first letter.</span>
              <span id="typing-error-tag" class="hidden text-rose-500 font-bold">Incorrect letter! Press Backspace to fix.</span>
            </div>
          </div>
        </div>

        <!-- PHASE 2: 11+ QUESTION CHALLENGE VIEW (Initially Hidden) -->
        <div id="question-challenge-view" class="hidden">
          <!-- Race Finish Banner -->
          <div class="mb-6 bg-gradient-to-r from-emerald-500/10 via-brand-gold/10 to-transparent border border-emerald-500/30 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🏁</span>
              <div>
                <h3 class="font-bold text-base text-brand-navy dark:text-brand-cream">
                  Race Complete! Speed: <span id="finish-race-wpm" class="text-emerald-600 dark:text-emerald-400 font-black">0</span> WPM (<span id="finish-race-acc">100%</span> Acc)
                </h3>
                <p class="text-xs text-brand-slate dark:text-gray-400">
                  Pit Stop Challenge: Type the answers to these 11+ exam questions about the passage!
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-gold text-brand-navy">
                Phase 2: 11+ Comprehension
              </span>
            </div>
          </div>

          <!-- Sticky Text Reference Card -->
          <div class="mb-6 bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400 flex items-center gap-1">
                <span>📖</span> Reference Passage:
              </span>
              <span class="text-[11px] text-brand-slate dark:text-gray-400">Refer back to find your answers</span>
            </div>
            <p id="ref-passage-text" class="text-sm sm:text-base text-brand-navy dark:text-brand-cream leading-relaxed font-sans italic">
              <!-- Text mirrored here -->
            </p>
          </div>

          <!-- Active Question Card -->
          <div id="question-card" class="bg-white dark:bg-brand-navy border-2 border-brand-gold/50 rounded-2xl p-6 shadow-sm">
            <div class="flex items-center justify-between mb-3">
              <span id="question-step" class="text-xs font-bold uppercase tracking-wider text-brand-gold">
                Question 1 of 3
              </span>
              <span id="question-type-badge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-teal/15 text-brand-teal dark:text-emerald-300">
                Vocabulary in Context
              </span>
            </div>

            <h3 id="question-prompt" class="text-lg sm:text-xl font-bold text-brand-navy dark:text-brand-cream mb-4">
              <!-- Prompt text -->
            </h3>

            <!-- Question Input Box -->
            <form id="question-form" class="space-y-4">
              <div class="relative">
                <input
                  id="question-input"
                  type="text"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder="Type your answer here and press Enter..."
                  class="w-full px-5 py-3.5 text-base sm:text-lg rounded-xl bg-brand-cream/50 dark:bg-brand-navy-light border border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all font-sans"
                />
              </div>

              <!-- Question Action Bar -->
              <div class="flex flex-wrap items-center justify-between gap-3">
                <button type="button" id="btn-show-hint" class="text-xs font-semibold text-brand-slate dark:text-gray-400 hover:text-brand-gold transition-colors flex items-center gap-1">
                  <span>💡</span> <span id="hint-text-label">Need a hint?</span>
                </button>

                <div class="flex items-center gap-2">
                  <button type="button" id="btn-reveal-answer" class="hidden text-xs font-semibold text-brand-slate dark:text-gray-400 hover:text-rose-500 transition-colors">
                    Reveal Answer
                  </button>
                  <button type="submit" id="btn-submit-answer" class="px-5 py-2.5 bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all shadow-sm">
                    Submit Answer ↵
                  </button>
                </div>
              </div>

              <!-- Hint Display -->
              <div id="hint-box" class="hidden mt-2 p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-xs text-amber-700 dark:text-amber-300">
                <span class="font-bold">Clue:</span> <span id="hint-content"></span>
              </div>

              <!-- Answer Feedback Box -->
              <div id="answer-feedback" class="hidden p-4 rounded-xl text-sm transition-all">
                <div class="flex items-start gap-2.5">
                  <span id="feedback-icon" class="text-lg"></span>
                  <div>
                    <h4 id="feedback-title" class="font-bold"></h4>
                    <p id="feedback-explanation" class="text-xs mt-1 leading-relaxed opacity-90"></p>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- PHASE 3: GRAND RESULTS & SCORECARD (Initially Hidden) -->
        <div id="grand-results-view" class="hidden">
          <div class="text-center py-6">
            <span id="results-badge-icon" class="text-5xl sm:text-6xl inline-block mb-3 animate-bounce">🏆</span>
            <span id="results-rank-pill" class="block mx-auto w-fit px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand-gold text-brand-navy mb-2">
              11+ Scholarship Grandmaster
            </span>
            <h2 class="text-2xl sm:text-4xl font-black text-brand-navy dark:text-brand-cream tracking-tight mb-2">
              Race Completed!
            </h2>
            <p id="results-subtitle" class="text-sm text-brand-slate dark:text-gray-300 max-w-lg mx-auto">
              Superb performance across speed typing and 11+ English comprehension.
            </p>
          </div>

          <!-- Score Metrics Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-4 text-center">
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Typing Speed</span>
              <span id="final-wpm" class="text-3xl font-black text-brand-navy dark:text-brand-cream">58</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">WPM</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-4 text-center">
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Accuracy</span>
              <span id="final-accuracy" class="text-3xl font-black text-emerald-600 dark:text-emerald-400">98</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">%</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-4 text-center">
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">11+ Questions</span>
              <span id="final-questions" class="text-3xl font-black text-brand-gold">3/3</span>
              <span class="text-xs text-brand-slate dark:text-gray-400 font-bold ml-0.5">Correct</span>
            </div>
            <div class="bg-brand-cream/60 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-4 text-center">
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-slate dark:text-gray-400">Total Time</span>
              <span id="final-time" class="text-3xl font-black text-brand-navy dark:text-brand-cream">46s</span>
            </div>
          </div>

          <!-- Vocabulary Reinforcement Card -->
          <div class="mb-8 bg-brand-cream/40 dark:bg-white/5 border border-brand-mist dark:border-white/10 rounded-2xl p-5">
            <h4 class="font-bold text-sm text-brand-navy dark:text-brand-cream mb-3 flex items-center gap-2">
              <span>📚</span> Vocabulary Revision for this Book:
            </h4>
            <div id="results-vocab-grid" class="grid sm:grid-cols-3 gap-3">
              <!-- Dynamically filled with words & definitions -->
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-3">
            <button id="btn-results-next" class="px-6 py-3 bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy font-bold rounded-2xl hover:opacity-90 active:scale-95 transition-all shadow-md">
              🚀 Next 11+ Race
            </button>
            <button id="btn-results-retry" class="px-6 py-3 bg-white dark:bg-white/10 border border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream font-bold rounded-2xl hover:bg-brand-cream/60 dark:hover:bg-white/20 active:scale-95 transition-all">
              🔁 Retry This Passage
            </button>
            <button id="btn-share-score" class="px-5 py-3 bg-brand-teal text-white font-bold rounded-2xl hover:opacity-90 active:scale-95 transition-all flex items-center gap-2">
              <span>📋</span> <span id="share-btn-text">Share Score</span>
            </button>
            <a id="results-gutenberg-btn" href="#" target="_blank" rel="noopener noreferrer" class="px-5 py-3 bg-brand-cream dark:bg-white/5 text-brand-navy dark:text-brand-cream border border-brand-mist dark:border-white/10 font-bold rounded-2xl hover:text-brand-gold transition-colors inline-flex items-center gap-1.5">
              <span>📖 Full Gutenberg Book</span> ↗
            </a>
          </div>
        </div>

      </div>

      <!-- Lifetime Career Stats Footer Strip -->
      <div class="mt-8 bg-white/70 dark:bg-brand-navy-light/70 backdrop-blur-md border border-brand-mist dark:border-white/10 rounded-2xl p-4 sm:p-5 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-brand-navy dark:text-brand-cream shadow-sm">
        <div class="flex items-center gap-6">
          <span class="text-brand-slate dark:text-gray-400 uppercase tracking-wider font-bold">Your Career:</span>
          <div>Races: <strong id="career-races" class="text-brand-navy dark:text-brand-cream">0</strong></div>
          <div>Best Speed: <strong id="career-best-wpm" class="text-emerald-600 dark:text-emerald-400">0 WPM</strong></div>
          <div>Average Speed: <strong id="career-avg-wpm" class="text-brand-navy dark:text-brand-cream">0 WPM</strong></div>
          <div>11+ Solved: <strong id="career-questions" class="text-brand-gold">0</strong></div>
        </div>
        <button id="btn-reset-career" class="text-brand-slate dark:text-gray-400 hover:text-rose-500 transition-colors text-[11px]">
          Reset Stats
        </button>
      </div>

      <!-- Explanatory 11+ Gutenberg Guide Section -->
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        <div class="bg-white/60 dark:bg-brand-navy-light/50 border border-brand-mist dark:border-white/10 rounded-2xl p-6">
          <div class="text-2xl mb-2">📜</div>
