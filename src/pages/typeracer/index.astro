    }

    // --- Load and Initialize Race ---
    function loadPassage(index) {
      currentPassageIndex = index;
      currentPassage = passages[currentPassageIndex];
      words = currentPassage.text.split(' ');
      currentWordIndex = 0;
      currentInput = '';
      isRaceActive = false;
      isRaceFinished = false;
      raceStartTime = 0;
      raceEndTime = 0;
      totalKeystrokes = 0;
      errorKeystrokes = 0;
      rankCounter = 1;

      determineQAMode();

      if (hudTimerInterval) clearInterval(hudTimerInterval);
      if (botSimulationInterval) clearInterval(botSimulationInterval);
      if (lobbyCountdownInterval) clearInterval(lobbyCountdownInterval);

      if (typingRaceView) typingRaceView.style.display = 'block';
      if (qaFollowupView) qaFollowupView.style.display = 'none';
      if (grandResultsView) grandResultsView.style.display = 'none';
      if (vocabDrawer) vocabDrawer.style.display = 'none';

      if (passageTitle) passageTitle.textContent = currentPassage.title;
      if (passageAuthor) passageAuthor.textContent = 'by ' + currentPassage.author + ' (' + currentPassage.year + ') • ' + currentPassage.chapter;
      if (passageDifficulty) {
        passageDifficulty.textContent = currentPassage.difficulty;
        if (currentPassage.difficulty === 'Foundation') {
          passageDifficulty.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
        } else if (currentPassage.difficulty === 'Standard 11+') {
          passageDifficulty.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300';
        } else {
          passageDifficulty.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300';
        }
      }
      if (passageGutenbergLink) {
        passageGutenbergLink.href = currentPassage.gutenbergUrl;
        passageGutenbergLink.innerHTML = '<span>#' + currentPassage.gutenbergId + '</span> ↗';
      }

      if (vocabCount) vocabCount.textContent = currentPassage.vocabulary.length.toString();
      if (vocabList) {
        vocabList.innerHTML = currentPassage.vocabulary.map(function(v) {
          return '<div class="p-2.5 rounded-xl bg-white dark:bg-white/5 border border-black/[0.04] dark:border-white/[0.06]">' +
            '<span class="font-bold text-brand-navy dark:text-brand-cream">' + v.word + ':</span>' +
            '<span class="text-brand-slate dark:text-gray-300 ml-1">' + v.definition + '</span>' +
            '</div>';
        }).join('');
      }

      racers[0].progress = 0;
      racers[0].currentWpm = 0;
      racers[0].rank = null;
      racers[0].finishTime = null;

      const playerRacerEl = document.getElementById('racer-0');
      const playerWpmEl = document.getElementById('racer-0-wpm');
      const playerMedalEl = document.getElementById('racer-0-medal');
      if (playerRacerEl) playerRacerEl.style.left = '0%';
      if (playerWpmEl) playerWpmEl.textContent = '0 WPM';
      if (playerMedalEl) playerMedalEl.classList.add('hidden');

      randomizeBots();

      if (hudWpm) hudWpm.textContent = '0';
      if (hudAccuracy) hudAccuracy.textContent = '100';
      if (hudTime) hudTime.textContent = '0:00';
      if (hudProgress) hudProgress.textContent = '0';
      if (hudRank) hudRank.textContent = '1st / 4';

      if (typingInput) {
        typingInput.value = '';
        typingInput.disabled = false;
        typingInput.placeholder = "Click here and type to race...";
        typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
        try {
          typingInput.focus({ preventScroll: true });
        } catch (e) {}
      }
      if (typingErrorTag) typingErrorTag.style.display = 'none';

      renderPassageWords();
      startLobbyMatchmaking();

      if (p2pChannel) {
        p2pChannel.postMessage({
          type: 'LOBBY_JOIN',
          senderId: localRacerId,
          name: 'Player',
          avatar: '🏎️',
          passageId: currentPassage.id
        });
      }
    }

    // --- Matchmaking Lobby Countdown ---
    function startLobbyMatchmaking() {
      isLobbyActive = true;
      lobbyCountdownSeconds = 5;
      if (lobbyBar) lobbyBar.style.display = 'flex';
      if (lobbyTimerNum) lobbyTimerNum.textContent = '5';
      if (lobbyStatusText) lobbyStatusText.innerHTML = 'Matchmaking: Waiting for other racers... (<span id="lobby-timer-num">5</span>s)';

      lobbyCountdownInterval = setInterval(function() {
        lobbyCountdownSeconds--;
        const timerEl = document.getElementById('lobby-timer-num');
        if (timerEl) timerEl.textContent = lobbyCountdownSeconds.toString();

        if (lobbyCountdownSeconds <= 0) {
          endLobbyCountdown();
        }
      }, 1000);
    }

    function endLobbyCountdown() {
      if (lobbyCountdownInterval) clearInterval(lobbyCountdownInterval);
      isLobbyActive = false;
      if (lobbyStatusText) lobbyStatusText.innerHTML = '🏁 Race in Progress! Type the text below.';
    }

    if (btnStartRaceNow) {
      btnStartRaceNow.addEventListener('click', function() {
        endLobbyCountdown();
        if (typingInput) {
          try {
            typingInput.focus({ preventScroll: true });
          } catch (e) {}
        }
      });
    }

    if (btnInviteLink) {
      btnInviteLink.addEventListener('click', function() {
        const url = window.location.origin + window.location.pathname + '?room=' + (localRacerId.slice(-4));
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function() {
            if (inviteBtnLabel) inviteBtnLabel.textContent = 'Copied Link!';
            setTimeout(function() {
              if (inviteBtnLabel) inviteBtnLabel.textContent = 'Invite Friend';
            }, 2000);
          });
        }
      });
    }

    // --- Render Passage Letter-by-Letter Display ---
    function renderPassageWords() {
      if (!passageDisplay) return;

      const wordsHtml = words.map(function(word, wIdx) {
        if (wIdx < currentWordIndex) {
          return '<span class="tr-word-done">' + escapeHtml(word) + '</span>';
        } else if (wIdx === currentWordIndex) {
          const target = word;
          const typed = currentInput;
          let charsHtml = '';
          let isError = false;

          for (let i = 0; i < target.length; i++) {
            if (i < typed.length) {
              if (typed[i] === target[i] && !isError) {
                charsHtml += '<span class="tr-char-correct">' + escapeHtml(target[i]) + '</span>';
              } else {
                isError = true;
                charsHtml += '<span class="tr-char-error">' + escapeHtml(target[i]) + '</span>';
              }
            } else {
              charsHtml += '<span class="tr-char-pending">' + escapeHtml(target[i]) + '</span>';
            }
          }

          if (typed.length > target.length) {
            const extra = typed.slice(target.length);
            charsHtml += '<span class="tr-char-error line-through">' + escapeHtml(extra) + '</span>';
          }

          return '<span class="tr-word-current">' + charsHtml + '</span>';
        } else {
          return '<span class="tr-word-upcoming">' + escapeHtml(word) + '</span>';
        }
      }).join(' ');

      passageDisplay.innerHTML = wordsHtml;
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // --- Typing Input Event Handler ---
    if (typingInput) {
      typingInput.addEventListener('keydown', function(e) {
        if (!isRaceActive && !isRaceFinished && e.key.length === 1) {
          startRace();
        }

        if (e.key === ' ' && isRaceActive) {
          const currentTargetWord = words[currentWordIndex];
          const typedVal = typingInput.value.trim();

          if (typedVal === currentTargetWord) {
            e.preventDefault();
            sound.playKeyClick();
            currentWordIndex++;
            currentInput = '';
            typingInput.value = '';
            totalKeystrokes++;

            if (currentWordIndex >= words.length) {
              finishRace();
              return;
            }

            renderPassageWords();
            updateRaceMetrics();
            return;
          }
        }
      });

      typingInput.addEventListener('input', function() {
        if (!isRaceActive && !isRaceFinished) {
          startRace();
        }

        currentInput = typingInput.value;
        const currentTargetWord = words[currentWordIndex] || '';

        totalKeystrokes++;

        const isPrefixMatch = currentTargetWord.startsWith(currentInput);
        if (!isPrefixMatch) {
          errorKeystrokes++;
          sound.playError();
          typingInput.classList.add('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.style.display = 'inline';
        } else {
          sound.playKeyClick();
          typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.style.display = 'none';
        }

        if (currentWordIndex === words.length - 1 && currentInput === currentTargetWord) {
          finishRace();
          return;
        }

        renderPassageWords();
        updateRaceMetrics();
      });
    }

    // --- Start Race & Run Bots ---
    function startRace() {
      if (isRaceActive) return;
      isRaceActive = true;
      raceStartTime = Date.now();
      endLobbyCountdown();

      hudTimerInterval = window.setInterval(function() {
        const elapsedSec = Math.floor((Date.now() - raceStartTime) / 1000);
        const mins = Math.floor(elapsedSec / 60);
        const secs = elapsedSec % 60;
        if (hudTime) hudTime.textContent = mins + ':' + secs.toString().padStart(2, '0');
        updateLiveWpm(elapsedSec);
      }, 250);

      startBotSimulation();
    }

    function startBotSimulation() {
      const totalChars = currentPassage.text.length;

      botSimulationInterval = window.setInterval(function() {
        if (!isRaceActive && isRaceFinished) return;
        const now = Date.now();
        const elapsedSec = (now - raceStartTime) / 1000;

        for (let i = 1; i <= 3; i++) {
          const bot = racers[i];
          if (bot.isPeer || bot.rank !== null) continue;

          if (elapsedSec * 1000 < bot.startDelay) continue;

          if (Math.random() < 0.08) {
            bot.jitter = 0.88 + Math.random() * 0.24;
          }

          const effectiveWpm = bot.targetWpm * bot.jitter;
          const charsPerSec = (effectiveWpm * 5) / 60;
          const progressDelta = (charsPerSec * 0.1 / totalChars) * 100;
          bot.progress = Math.min(100, bot.progress + progressDelta);

          const wordsTyped = (bot.progress / 100) * totalChars / 5;
          const botElapsedMinutes = Math.max(0.05, (now - (raceStartTime + bot.startDelay)) / 60000);
          bot.currentWpm = Math.round(wordsTyped / botElapsedMinutes);

          const racerEl = document.getElementById('racer-' + i);
          const wpmEl = document.getElementById('racer-' + i + '-wpm');
          if (racerEl) racerEl.style.left = Math.min(92, bot.progress * 0.92) + '%';
          if (wpmEl) wpmEl.textContent = bot.currentWpm + ' WPM';

          if (bot.progress >= 100 && bot.rank === null) {
            bot.rank = rankCounter++;
            bot.finishTime = now;
            const medalEl = document.getElementById('racer-' + i + '-medal');
            if (medalEl) {
              medalEl.classList.remove('hidden');
              const medals = { 1: '🥇', 2: '🥈', 3: '🥉', 4: '4th' };
              medalEl.textContent = medals[bot.rank] || '';
            }
          }
        }

        updateLiveRank();
      }, 100);
    }

    function updateLiveWpm(elapsedSec) {
      if (elapsedSec <= 0) return;
      let typedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        typedChars += words[i].length + 1;
      }
      typedChars += Math.min(currentInput.length, words[currentWordIndex] ? words[currentWordIndex].length : 0);

      const wordsTyped = typedChars / 5;
      const minutes = elapsedSec / 60;
      const wpm = Math.round(wordsTyped / minutes);

      racers[0].currentWpm = Math.max(0, wpm);
      if (hudWpm) hudWpm.textContent = Math.max(0, wpm).toString();
      const playerWpmPill = document.getElementById('racer-0-wpm');
      if (playerWpmPill) playerWpmPill.textContent = Math.max(0, wpm) + ' WPM';
    }

    function updateRaceMetrics() {
      const totalChars = currentPassage.text.length;
      let completedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        completedChars += words[i].length + 1;
      }
      completedChars += Math.min(currentInput.length, words[currentWordIndex] ? words[currentWordIndex].length : 0);

      const pct = Math.min(100, Math.round((completedChars / totalChars) * 100));
      racers[0].progress = pct;
      if (hudProgress) hudProgress.textContent = pct.toString();

      const playerRacer = document.getElementById('racer-0');
      if (playerRacer) {
        playerRacer.style.left = Math.min(92, (pct / 100) * 92) + '%';
      }

      if (totalKeystrokes > 0 && hudAccuracy) {
        const acc = Math.max(0, Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100));
        hudAccuracy.textContent = acc.toString();
      }

      updateLiveRank();
      broadcastMyProgress(pct, racers[0].currentWpm, racers[0].rank);
    }

    function updateLiveRank() {
      const sorted = racers.slice().sort((a, b) => b.progress - a.progress);
      const playerPos = sorted.findIndex(r => r.isPlayer) + 1;
      const suffix = { 1: 'st', 2: 'nd', 3: 'rd', 4: 'th' }[playerPos] || 'th';
      if (hudRank) {
        hudRank.textContent = playerPos + suffix + ' / 4';
        if (playerPos === 1) {
          hudRank.className = 'px-2.5 py-0.5 rounded-lg font-black bg-brand-gold text-brand-navy shadow-sm';
        } else if (playerPos === 2) {
          hudRank.className = 'px-2.5 py-0.5 rounded-lg font-black bg-slate-200 text-slate-800';
        } else {
          hudRank.className = 'px-2.5 py-0.5 rounded-lg font-black bg-amber-800/20 text-amber-900 dark:text-amber-300';
        }
      }
    }

    function finishRace() {
      isRaceActive = false;
      isRaceFinished = true;
      raceEndTime = Date.now();

      if (hudTimerInterval) clearInterval(hudTimerInterval);

      racers[0].progress = 100;
      racers[0].rank = rankCounter++;
      racers[0].finishTime = raceEndTime;

      const playerRacer = document.getElementById('racer-0');
      const playerMedal = document.getElementById('racer-0-medal');
      if (playerRacer) playerRacer.style.left = '92%';
      if (playerMedal) {
        playerMedal.classList.remove('hidden');
        const medals = { 1: '🥇', 2: '🥈', 3: '🥉', 4: '4th' };
        playerMedal.textContent = medals[racers[0].rank] || '';
      }

      sound.playFinishChime(racers[0].rank === 1);

      const elapsedSeconds = Math.max(1, (raceEndTime - raceStartTime) / 1000);
      const totalWords = currentPassage.text.length / 5;
      const rawWpm = Math.round((totalWords / elapsedSeconds) * 60);
      const wpm = Math.min(240, rawWpm); // realistic clamp
      const accuracy = totalKeystrokes > 0 ? Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100) : 100;
      racers[0].currentWpm = wpm;

      broadcastMyProgress(100, wpm, racers[0].rank);

      const stats = getCareerStats();
      stats.races++;
      stats.totalWpm += wpm;
      if (racers[0].rank === 1) stats.victories = (stats.victories || 0) + 1;
      if (wpm > stats.bestWpm) stats.bestWpm = wpm;
      saveCareerStats(stats);
      updateCareerUI();

      setTimeout(function() {
        if (currentRaceHasQA && currentPassage.qaFollowup) {
          startQAFollowupPhase(wpm, accuracy, racers[0].rank);
        } else {
          showGrandResults(wpm, accuracy, racers[0].rank);
        }
      }, 1000);
    }

    // ============================================
    // PHASE 2: 11+ CONTEXT Q&A TYPING DRILL
    // ============================================
    let qaTargetQ = '';
    let qaTargetA = '';
    let qaStage = 1;
    let qaTypedQ = '';
    let qaTypedA = '';

    function startQAFollowupPhase(wpm, acc, rank) {
      if (typingRaceView) typingRaceView.style.display = 'none';
      if (qaFollowupView) qaFollowupView.style.display = 'block';

      const rankLabels = { 1: '1st Place! 🥇', 2: '2nd Place! 🥈', 3: '3rd Place! 🥉', 4: '4th Place' };
      if (qaUserRankBadge) qaUserRankBadge.textContent = rankLabels[rank] || rank + 'th';
      if (qaFinishWpm) qaFinishWpm.textContent = wpm.toString();

      const qa = currentPassage.qaFollowup || {
        question: "What main theme is highlighted in this classic passage?",
        answer: "Character resilience and keen observation.",
        contextNote: "Authentic 11+ classic literature extract from Project Gutenberg."
      };

      qaTargetQ = 'Q: ' + qa.question;
      qaTargetA = 'A: ' + qa.answer;
      qaStage = 1;
      qaTypedQ = '';
      qaTypedA = '';

      if (qaContextReveal) qaContextReveal.classList.add('hidden');
      if (qaErrorTag) qaErrorTag.style.display = 'none';
      if (qaNewlineCue) {
        qaNewlineCue.textContent = '⌨️ Type Question, then press Enter ↵';
        qaNewlineCue.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-brand-teal/15 text-brand-teal dark:text-emerald-300';
      }
      if (qaInstructionLabel) {
        qaInstructionLabel.innerHTML = 'Type the Question first. When finished, press <strong>Enter ↵</strong> to type the Answer.';
      }

      renderQALines();

      if (qaInput) {
        qaInput.value = '';
        qaInput.disabled = false;
        qaInput.placeholder = "Type: " + qaTargetQ.slice(0, 30) + "...";
        try {
          qaInput.focus({ preventScroll: true });
        } catch (e) {}
      }
    }

    function renderQALines() {
      if (!qaLine1 || !qaLine2) return;

      // Line 1: Question
      let qHtml = '';
      let qError = false;
      for (let i = 0; i < qaTargetQ.length; i++) {
        if (i < qaTypedQ.length) {
          if (qaTypedQ[i] === qaTargetQ[i] && !qError) {
            qHtml += '<span class="text-emerald-600 dark:text-emerald-400 font-bold">' + escapeHtml(qaTargetQ[i]) + '</span>';
          } else {
            qError = true;
            qHtml += '<span class="text-rose-600 bg-rose-100 dark:bg-rose-900/40 font-bold underline">' + escapeHtml(qaTargetQ[i]) + '</span>';
          }
        } else if (i === qaTypedQ.length && qaStage === 1) {
          qHtml += '<span class="bg-amber-300 dark:bg-amber-500/40 text-brand-navy dark:text-brand-cream font-bold underline">' + escapeHtml(qaTargetQ[i]) + '</span>';
        } else {
          qHtml += '<span class="text-slate-400 dark:text-gray-500">' + escapeHtml(qaTargetQ[i]) + '</span>';
        }
      }
      if (qaStage === 1 && qaTypedQ === qaTargetQ) {
        qHtml += ' <span class="px-2 py-0.5 rounded-md bg-brand-gold text-brand-navy font-black text-xs animate-bounce ml-2 shadow-sm">↵ Press Enter</span>';
      }
      qaLine1.innerHTML = qHtml;

      // Line 2: Answer
      let aHtml = '';
      let aError = false;
      for (let i = 0; i < qaTargetA.length; i++) {
        if (qaStage < 2) {
          aHtml += '<span class="text-slate-400 dark:text-gray-600 opacity-60">' + escapeHtml(qaTargetA[i]) + '</span>';
        } else {
          if (i < qaTypedA.length) {
            if (qaTypedA[i] === qaTargetA[i] && !aError) {
              aHtml += '<span class="text-emerald-600 dark:text-emerald-400 font-bold">' + escapeHtml(qaTargetA[i]) + '</span>';
            } else {
              aError = true;
              aHtml += '<span class="text-rose-600 bg-rose-100 dark:bg-rose-900/40 font-bold underline">' + escapeHtml(qaTargetA[i]) + '</span>';
            }
          } else if (i === qaTypedA.length && qaStage === 2) {
            aHtml += '<span class="bg-amber-300 dark:bg-amber-500/40 text-brand-navy dark:text-brand-cream font-bold underline">' + escapeHtml(qaTargetA[i]) + '</span>';
          } else {
            aHtml += '<span class="text-slate-400 dark:text-gray-500">' + escapeHtml(qaTargetA[i]) + '</span>';
          }
        }
      }
      qaLine2.innerHTML = aHtml;
    }

    if (qaInput) {
      qaInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (qaStage === 1 && qaTypedQ === qaTargetQ) {
            sound.playReturnClick();
            qaStage = 2;
            qaInput.value = '';
            qaTypedA = '';
            if (qaNewlineCue) {
              qaNewlineCue.textContent = '↵ Enter registered! Now type the Answer:';
              qaNewlineCue.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            }
            if (qaInstructionLabel) {
              qaInstructionLabel.innerHTML = 'Now type the Answer line.';
            }
            qaInput.placeholder = "Type: " + qaTargetA.slice(0, 30) + "...";
            renderQALines();
            return;
          }
        }
      });

      qaInput.addEventListener('input', function() {
        const val = qaInput.value;

        if (qaStage === 1) {
          qaTypedQ = val;
          const target = qaTargetQ;
          if (target.startsWith(val)) {
            sound.playKeyClick();
            if (qaErrorTag) qaErrorTag.style.display = 'none';
            qaInput.classList.remove('border-rose-500');
          } else {
            sound.playError();
            if (qaErrorTag) qaErrorTag.style.display = 'inline';
            qaInput.classList.add('border-rose-500');
          }

          if (val === target) {
            if (qaNewlineCue) {
              qaNewlineCue.textContent = '↵ Great! Press Enter to move to Line 2';
              qaNewlineCue.className = 'text-xs font-black px-2.5 py-0.5 rounded-full bg-brand-gold text-brand-navy animate-pulse';
            }
          }
          renderQALines();
        } else if (qaStage === 2) {
          qaTypedA = val;
          const target = qaTargetA;
          if (target.startsWith(val)) {
            sound.playKeyClick();
            if (qaErrorTag) qaErrorTag.style.display = 'none';
            qaInput.classList.remove('border-rose-500');
          } else {
            sound.playError();
            if (qaErrorTag) qaErrorTag.style.display = 'inline';
            qaInput.classList.add('border-rose-500');
          }

          renderQALines();

          if (val === target) {
            qaStage = 3;
            sound.playFinishChime(true);
            qaInput.disabled = true;

            const qa = currentPassage.qaFollowup;
            if (qaContextReveal && qaContextNoteText && qa) {
              qaContextNoteText.textContent = qa.contextNote;
              qaContextReveal.classList.remove('hidden');
            }

            if (qaNewlineCue) {
              qaNewlineCue.textContent = '✓ 11+ Context Complete!';
              qaNewlineCue.className = 'text-xs font-black px-2.5 py-0.5 rounded-full bg-emerald-500 text-white';
            }

            setTimeout(function() {
              showGrandResults(racers[0].currentWpm, 100, racers[0].rank);
            }, 1800);
          }
        }
      });
    }

    if (btnSkipQa) {
      btnSkipQa.addEventListener('click', function() {
        showGrandResults(racers[0].currentWpm, 100, racers[0].rank);
      });
    }

    // ============================================
    // PHASE 3: 4-RACER PODIUM & GRAND RESULTS
    // ============================================
    let lastWpmScore = 0;

    function showGrandResults(wpm, acc, rank) {
      if (typingRaceView) typingRaceView.style.display = 'none';
      if (qaFollowupView) qaFollowupView.style.display = 'none';
      if (grandResultsView) grandResultsView.style.display = 'block';

      lastWpmScore = wpm;
      const totalElapsedSec = Math.round((Date.now() - raceStartTime) / 1000);

      if (finalWpm) finalWpm.textContent = wpm.toString();
      if (finalAccuracy) finalAccuracy.textContent = acc.toString();
      if (finalPodiumRank) {
        const labels = { 1: '1st', 2: '2nd', 3: '3rd', 4: '4th' };
        finalPodiumRank.textContent = labels[rank] || rank.toString();
      }
      if (finalTime) finalTime.textContent = totalElapsedSec + 's';

      let rankTitle = '🥉 11+ Race Contender';
      let rankIcon = '🎖️';
      if (rank === 1) {
        rankTitle = '🏆 1st Place Champion!';
        rankIcon = '🏆';
      } else if (rank === 2) {
        rankTitle = '🥈 2nd Place Podium Finisher';
        rankIcon = '🥈';
      } else if (rank === 3) {
        rankTitle = '🥉 3rd Place Bronze Finish';
        rankIcon = '🥉';
      }

      if (resultsRankPill) resultsRankPill.textContent = rankTitle;
      if (resultsBadgeIcon) resultsBadgeIcon.textContent = rankIcon;

      // Populate 4-Racer Podium Board
      if (podiumGrid) {
        const sorted = racers.slice().sort(function(a, b) {
          if (a.rank && b.rank) return a.rank - b.rank;
          if (a.rank) return -1;
          if (b.rank) return 1;
          return b.progress - a.progress;
        });

        podiumGrid.innerHTML = sorted.map(function(racer, index) {
          const pos = index + 1;
          const medals = { 1: '🥇 1st', 2: '🥈 2nd', 3: '🥉 3rd', 4: '4th' };
          const isYou = racer.isPlayer;

          return '<div class="flex items-center justify-between p-2.5 rounded-xl ' + 
            (isYou ? 'bg-brand-gold/20 border border-brand-gold font-bold shadow-sm' : 'bg-white dark:bg-white/5 border border-black/[0.04] dark:border-white/[0.06]') + 
            ' text-xs">' +
            '<div class="flex items-center gap-2.5">' +
              '<span class="font-black w-14 text-brand-navy dark:text-brand-cream">' + (medals[pos] || pos + 'th') + '</span>' +
              '<span class="text-base">' + racer.avatar + '</span>' +
              '<span class="font-bold text-brand-navy dark:text-brand-cream">' + racer.name + (isYou ? ' (You)' : '') + '</span>' +
              '<span class="text-[9px] px-1.5 py-0.2 rounded font-bold ' + (isYou ? 'bg-brand-gold text-brand-navy' : (racer.isPeer ? 'bg-emerald-500/20 text-emerald-600' : 'bg-slate-200 dark:bg-white/10 text-slate-600 dark:text-gray-300')) + '">' + (isYou ? 'YOU' : (racer.isPeer ? 'PEER' : 'BOT')) + '</span>' +
            '</div>' +
            '<div class="flex items-center gap-3">' +
              '<span class="text-brand-slate dark:text-gray-400 font-mono font-semibold">' + (racer.currentWpm || racer.targetWpm || wpm) + ' WPM</span>' +
              '<span class="text-emerald-600 dark:text-emerald-400 font-black">' + (pos === 1 ? 'WINNER' : 'Finished') + '</span>' +
            '</div>' +
          '</div>';
        }).join('');
      }

      // Dynamic Speed Recommendation for Typing Academy
      let recText = '';
      let targetLessonId = 0;
      if (wpm < 38) {
        recText = 'You typed at ' + wpm + ' WPM. We recommend starting with Level 1: Home Row Foundation to build ergonomic finger placement and break 45+ WPM (the 11+ benchmark).';
        targetLessonId = 0;
      } else if (wpm < 62) {
        recText = 'Great typing speed (' + wpm + ' WPM)! We recommend Level 2: 11+ Punctuation & Newlines to master speech quotes and Enter transitions without hesitation.';
        targetLessonId = 5; // Level 2
      } else {
        recText = 'Master speed (' + wpm + ' WPM)! You are faster than 90% of students. Sharpen Level 3: Classical Literature Speed Sprints for elite fluency.';
        targetLessonId = 9; // Level 3
      }

      if (recommendationText) recommendationText.textContent = recText;
      if (btnGotoRecommendedLesson) {
        btnGotoRecommendedLesson.onclick = function() {
          currentLessonIndex = targetLessonId;
          switchAppTab('lessons');
        };
      }

      if (resultsVocabGrid) {
        resultsVocabGrid.innerHTML = currentPassage.vocabulary.map(function(v) {
          return '<div class="p-2.5 rounded-xl bg-white dark:bg-white/5 border border-black/[0.04] dark:border-white/[0.06]">' +
            '<span class="font-bold text-brand-navy dark:text-brand-cream block text-xs uppercase tracking-wider mb-0.5">' + v.word + '</span>' +
            '<span class="text-xs text-brand-slate dark:text-gray-300 leading-snug">' + v.definition + '</span>' +
            '</div>';
        }).join('');
