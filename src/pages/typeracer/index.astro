    // --- Virtual Keyboard Mapping Helpers ---
    function findVirtualKeyEl(key) {
      if (!key) return null;
      if (key === ' ') return document.querySelector('.vkey-3d[data-key=" "]');
      if (key === 'Enter') return document.querySelector('.vkey-3d[data-key="enter"]');
      if (key === 'Backspace') return document.querySelector('.vkey-3d[data-key="bksp"]');

      const lower = key.toLowerCase();
      let el = document.querySelector('.vkey-3d[data-key="' + lower + '"]');
      if (el) return el;

      const shiftMap = {
        '!': '1', '@': '2', '#': '3', '$': '4', '%': '5', '^': '6', '&': '7', '*': '8', '(': '9', ')': '0',
        '_': '-', '+': '=', '{': '[', '}': ']', '|': '\\', ':': ';', '"': "'", '<': ',', '>': '.', '?': '/'
      };
      if (shiftMap[key]) {
        return document.querySelector('.vkey-3d[data-key="' + shiftMap[key] + '"]');
      }

      if (key >= 'A' && key <= 'Z') {
        return document.querySelector('.vkey-3d[data-key="' + key.toLowerCase() + '"]');
      }

      return null;
    }

    function pressKeycapVisual(key) {
      const el = findVirtualKeyEl(key);
      if (el) {
        el.classList.add('vkey-pressed');
        setTimeout(() => el.classList.remove('vkey-pressed'), 120);
      }
    }

    function triggerKeycapError(key) {
      const el = findVirtualKeyEl(key);
      if (el) {
        el.classList.add('vkey-error');
        setTimeout(() => el.classList.remove('vkey-error'), 300);
      }
    }

    function getFingerForChar(char) {
      if (char === ' ') return 'thumb';
      const c = char.toLowerCase();
      if ('`~1!qaz'.includes(c)) return 'left-pinky';
      if ('2@wsx'.includes(c)) return 'left-ring';
      if ('3#edc'.includes(c)) return 'left-middle';
      if ('4$5%rfvtgb'.includes(c)) return 'left-index';
      if ('6^7&yhnujm'.includes(c)) return 'right-index';
      if ('8*ik,<'.includes(c)) return 'right-middle';
      if ('9(ol.>'.includes(c)) return 'right-ring';
      if ('0)-_=+p[{]}\\|;:/?\'"'.includes(c) || c === 'enter') return 'right-pinky';
      return 'left-index';
    }

    function getFingerDescription(fingerKey, char) {
      const map = {
        'left-pinky': 'Left Pinky',
        'left-ring': 'Left Ring',
        'left-middle': 'Left Middle',
        'left-index': 'Left Index' + (char === 'f' || char === 'F' ? ' (Home Bump)' : ''),
        'right-index': 'Right Index' + (char === 'j' || char === 'J' ? ' (Home Bump)' : ''),
        'right-middle': 'Right Middle',
        'right-ring': 'Right Ring',
        'right-pinky': 'Right Pinky',
        'thumb': 'Either Thumb on Spacebar'
      };
      return map[fingerKey] || 'Index Finger';
    }

    function updateVirtualKeyboardHighlight() {
      const allKeys = document.querySelectorAll('.vkey-3d');
      allKeys.forEach(k => {
        k.classList.remove('vkey-active', 'vkey-shift-active');
      });

      const allChips = document.querySelectorAll('[id^="finger-chip-"]');
      allChips.forEach(c => {
        c.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold border border-black/[0.08] dark:border-white/[0.1] bg-white/60 dark:bg-white/5 text-slate-700 dark:text-slate-300 transition-all';
      });

      if (lessonTypedIndex >= lessonTargetText.length) return;

      const nextChar = lessonTargetText[lessonTypedIndex];
      if (!nextChar) return;

      const targetEl = findVirtualKeyEl(nextChar);
      if (targetEl) {
        targetEl.classList.add('vkey-active');
      }

      const isShiftNeeded = (nextChar >= 'A' && nextChar <= 'Z') || '~!@#$%^&*()_+{}|:"<>?'.includes(nextChar);
      if (isShiftNeeded) {
        const finger = targetEl ? targetEl.getAttribute('data-finger') : '';
        const isLeftHand = finger && finger.startsWith('left');
        const shiftKeyId = isLeftHand ? 'vkey-shift-right' : 'vkey-shift-left';
        const shiftEl = document.getElementById(shiftKeyId);
        if (shiftEl) shiftEl.classList.add('vkey-shift-active');
      }

      const fingerKey = targetEl ? targetEl.getAttribute('data-finger') : getFingerForChar(nextChar);
      const fingerDesc = getFingerDescription(fingerKey, nextChar);

      const hudTargetKeyPill = document.getElementById('hud-target-key-pill');
      const hudTargetFingerDesc = document.getElementById('hud-target-finger-desc');
      if (hudTargetKeyPill) {
        hudTargetKeyPill.textContent = nextChar === ' ' ? 'Space' : nextChar;
      }
      if (hudTargetFingerDesc) {
        hudTargetFingerDesc.textContent = fingerDesc;
      }

      if (fingerKey) {
        const chip = document.getElementById('finger-chip-' + fingerKey);
        if (chip) {
          chip.className = 'px-2 py-0.5 rounded-md text-[10px] font-black border border-amber-500 bg-brand-gold text-slate-950 shadow-md ring-2 ring-amber-300 scale-105 transition-all';
        }
      }
    }

    // --- Strict Academy Typing Mechanics (WRONG KEY DOES NOT ADVANCE; NO BACKSPACE REQUIRED) ---
    function handleLessonKey(key) {
      if (lessonTypedIndex >= lessonTargetText.length) return;

      const expectedChar = lessonTargetText[lessonTypedIndex];
      if (!expectedChar) return;

      if (!lessonStartTime) lessonStartTime = Date.now();

      // If user pressed Backspace in Academy mode
      if (key === 'Backspace') {
        sound.playError();
        showLessonError('No backspace needed! Just press the correct key: "' + (expectedChar === ' ' ? 'Spacebar' : expectedChar) + '"');
        return;
      }

      if (key === expectedChar) {
        // CORRECT KEY: Advance forward!
        lessonTotalKeys++;
        lessonTypedIndex++;
        sound.playKeyClick();
        pressKeycapVisual(key);

        if (lessonErrorTag) lessonErrorTag.style.display = 'none';

        if (lessonTypedIndex >= lessonTargetText.length) {
          finishCurrentLesson();
          return;
        }

        renderLessonDisplay();
        updateVirtualKeyboardHighlight();
      } else {
        // INCORRECT KEY: DO NOT ADVANCE!
        lessonTotalKeys++;
        lessonKeyErrors++;
        sound.playError();
        triggerKeycapError(key);

        const cursorChar = document.getElementById('lesson-active-cursor-char');
        if (cursorChar) {
          cursorChar.classList.remove('animate-pulse');
          cursorChar.classList.add('bg-rose-500', 'text-white', 'ring-rose-400', 'animate-shake');
          setTimeout(() => {
            if (cursorChar) {
              cursorChar.classList.remove('bg-rose-500', 'text-white', 'ring-rose-400', 'animate-shake');
              cursorChar.classList.add('bg-brand-gold', 'text-slate-950', 'ring-amber-300', 'animate-pulse');
            }
          }, 350);
        }

        const expectedDisplay = expectedChar === ' ' ? 'Spacebar' : expectedChar;
        showLessonError('Incorrect key! Strike "' + expectedDisplay + '" to advance.');
        announceSrAlert('Incorrect key. Strike ' + expectedDisplay);
      }

      updateLessonAccuracy();
    }

    function showLessonError(msg) {
      if (lessonErrorTag && lessonErrorMsg) {
        lessonErrorMsg.textContent = msg;
        lessonErrorTag.style.display = 'flex';
      }
    }

    function updateLessonAccuracy() {
      if (lessonTotalKeys > 0 && lessonHudAcc) {
        const acc = Math.max(0, Math.round(((lessonTotalKeys - lessonKeyErrors) / lessonTotalKeys) * 100));
        lessonHudAcc.textContent = acc + '%';
      }
    }

    function finishCurrentLesson() {
      sound.playFinishChime(true);

      const elapsedSec = Math.max(1, Math.round((Date.now() - (lessonStartTime || Date.now())) / 1000));
      const wpm = Math.round((lessonTotalKeys / 5) / (elapsedSec / 60));
      const acc = Math.max(0, Math.round(((lessonTotalKeys - lessonKeyErrors) / Math.max(1, lessonTotalKeys)) * 100));

      let stars = '⭐⭐⭐';
      if (acc < 85) stars = '⭐';
      else if (acc < 95) stars = '⭐⭐';

      const modalTitle = document.getElementById('lesson-complete-title');
      const modalStars = document.getElementById('lesson-complete-stars');
      const modalWpm = document.getElementById('lesson-complete-wpm');
      const modalAcc = document.getElementById('lesson-complete-acc');
      const modal = document.getElementById('lesson-complete-modal');

      if (modalTitle) modalTitle.textContent = 'Lesson ' + (currentLessonIndex + 1) + ' Complete!';
      if (modalStars) modalStars.textContent = stars;
      if (modalWpm) modalWpm.textContent = wpm.toString();
      if (modalAcc) modalAcc.textContent = acc.toString();

      if (modal) modal.classList.remove('hidden');

      const nextBtn = document.getElementById('btn-lesson-complete-next');
      if (nextBtn) {
        nextBtn.onclick = function() {
          if (modal) modal.classList.add('hidden');
          if (currentLessonIndex + 1 < LESSONS.length) {
            loadLesson(currentLessonIndex + 1);
          } else {
            alert("🎉 Outstanding! You have completed all 12 lessons of the Free Typing Academy!");
          }
        };
      }

      const retryBtn = document.getElementById('btn-lesson-complete-retry');
      if (retryBtn) {
        retryBtn.onclick = function() {
          if (modal) modal.classList.add('hidden');
          loadLesson(currentLessonIndex);
        };
      }
    }

    // Input listeners for Academy drill
    if (lessonDrillCard && lessonDrillInput) {
      lessonDrillCard.addEventListener('click', function() {
        try {
          lessonDrillInput.focus({ preventScroll: true });
        } catch (e) {}
      });

      lessonDrillInput.addEventListener('keydown', function(e) {
        if (e.key === 'Tab' || e.key === 'Escape') return;
        e.preventDefault();
        handleLessonKey(e.key);
      });
    }

    // Window keyboard listener when Lessons tab is active
    window.addEventListener('keydown', function(e) {
      if (currentAppTab === 'lessons') {
        if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) {
          if (document.activeElement !== lessonDrillInput) {
            return;
          }
        }
        if (e.key === 'Tab' || e.key === 'Escape' || e.ctrlKey || e.altKey || e.metaKey) return;
        e.preventDefault();
        handleLessonKey(e.key);
      }
    });

    function renderCurriculumGrid() {
      if (!lessonsCurriculumGrid) return;

      lessonsCurriculumGrid.innerHTML = LESSONS.map(function(lesson, idx) {
        const isCurrent = idx === currentLessonIndex;
        return '<div class="refraction-btn p-3.5 rounded-2xl border transition-all cursor-pointer ' + 
          (isCurrent ? 'bg-amber-400/20 border-brand-gold shadow-sm ring-1 ring-amber-400' : 'bg-white dark:bg-white/5 border-black/[0.05] dark:border-white/[0.08] hover:border-brand-gold/60') + 
          '" onclick="window.__loadLessonFromCard(' + idx + ')" role="button" tabindex="0">' +
          '<div class="flex items-center justify-between mb-1">' +
            '<span class="text-[10px] font-black uppercase tracking-wider text-amber-700 dark:text-brand-gold">' + lesson.level + '</span>' +
            '<span class="text-xs font-bold text-slate-500">Lesson ' + (idx + 1) + '</span>' +
          '</div>' +
          '<h4 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-slate-100 mb-1">' + lesson.title + '</h4>' +
          '<p class="text-[11px] text-slate-600 dark:text-gray-400 line-clamp-1">' + lesson.tip + '</p>' +
        '</div>';
      }).join('');
    }

    window.__loadLessonFromCard = function(idx) {
      loadLesson(idx);
    };

    // ========================================================
    // SECTION 3: 18 GUTENBERG BOOKS DIRECT LIBRARY
    // ========================================================
    const libraryFullGrid = document.getElementById('library-full-grid');
    const libraryDirectSearch = document.getElementById('library-direct-search');

    function renderFullLibrary() {
      if (!libraryFullGrid) return;
      const q = (libraryDirectSearch ? libraryDirectSearch.value : '').toLowerCase().trim();

      const filtered = passages.filter(function(p) {
        return !q || p.title.toLowerCase().includes(q) || p.author.toLowerCase().includes(q);
      });

      libraryFullGrid.innerHTML = filtered.map(function(p) {
        const origIdx = passages.findIndex(item => item.id === p.id);
        const isCurrent = origIdx === currentPassageIndex;

        return '<div class="refraction-panel p-4 rounded-2xl border transition-all flex flex-wrap items-center justify-between gap-3 ' +
          (isCurrent
            ? 'bg-amber-400/15 border-brand-gold shadow-sm'
            : 'bg-white dark:bg-white/5 border-black/[0.05] dark:border-white/[0.08] hover:border-brand-gold/50') + '">' +
          '<div class="min-w-0 flex-1">' +
            '<div class="flex items-center gap-2 flex-wrap mb-1">' +
              '<h4 class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 font-serif-literary">' + p.title + '</h4>' +
              '<span class="px-2 py-0.2 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-gray-300">' + p.difficulty + '</span>' +
              (isCurrent ? '<span class="px-2 py-0.2 rounded-full text-[10px] font-black bg-brand-gold text-slate-950">Current Book</span>' : '') +
            '</div>' +
            '<p class="text-xs text-slate-600 dark:text-gray-400 mb-2">by ' + p.author + ' (' + p.year + ') • ' + p.chapter + '</p>' +
            '<p class="text-xs text-slate-700 dark:text-gray-300 line-clamp-2 italic font-serif-literary">"' + p.text + '"</p>' +
          '</div>' +
          '<div class="flex items-center gap-2">' +
            '<button type="button" class="refraction-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-900 dark:bg-brand-gold text-white dark:text-slate-950 hover:opacity-90 active:scale-95 transition-all shadow-sm" onclick="window.__selectBookFromLibrary(' + origIdx + ')">' +
              (isCurrent ? 'Racing Now' : 'Race This Book') +
            '</button>' +
            '<a href="' + p.gutenbergUrl + '" target="_blank" rel="noopener noreferrer" class="refraction-btn px-2.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-black/[0.08] dark:border-white/[0.1] hover:text-amber-700 transition-colors inline-flex items-center gap-1" title="Read on Project Gutenberg">' +
              '#' + p.gutenbergId + ' ↗' +
            '</a>' +
          '</div>' +
        '</div>';
      }).join('');
    }

    window.__selectBookFromLibrary = function(origIdx) {
      loadPassage(origIdx);
      switchAppTab('arena');
    };

    if (libraryDirectSearch) {
      libraryDirectSearch.addEventListener('input', renderFullLibrary);
    }

    // --- Career Stats LocalStorage ---
    function getCareerStats() {
      try {
        const raw = localStorage.getItem('tinykite_typeracer_career');
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      return { races: 0, victories: 0, bestWpm: 0, totalWpmSum: 0 };
    }

    function updateCareerStats(wpm, isWin) {
      const stats = getCareerStats();
      stats.races++;
      if (isWin) stats.victories++;
      if (wpm > stats.bestWpm) stats.bestWpm = wpm;
      stats.totalWpmSum += wpm;
      localStorage.setItem('tinykite_typeracer_career', JSON.stringify(stats));
      updateCareerUI();
    }

    function updateCareerUI() {
      const stats = getCareerStats();
      const avg = stats.races > 0 ? Math.round(stats.totalWpmSum / stats.races) : 0;
      const elRaces = document.getElementById('career-races');
      const elWins = document.getElementById('career-victories');
      const elBest = document.getElementById('career-best-wpm');
      const elAvg = document.getElementById('career-avg-wpm');

      if (elRaces) elRaces.textContent = stats.races.toString();
      if (elWins) elWins.textContent = stats.victories.toString();
      if (elBest) elBest.textContent = stats.bestWpm + ' WPM';
      if (elAvg) elAvg.textContent = avg + ' WPM';
    }

    const btnResetCareer = document.getElementById('btn-reset-career');
    if (btnResetCareer) {
      btnResetCareer.addEventListener('click', function() {
        if (confirm('Reset all career racing stats?')) {
          localStorage.removeItem('tinykite_typeracer_career');
          updateCareerUI();
        }
      });
    }

    // --- Initial Boot ---
    updateCareerUI();
    loadPassage(currentPassageIndex);
  </script>
</Layout>
