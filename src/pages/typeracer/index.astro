    }

    // Email capture handling (100% Free)
    if (emailCaptureForm && studentEmailInput) {
      const savedEmail = localStorage.getItem('tinykite_typeracer_student_email');
      if (savedEmail) {
        studentEmailInput.value = savedEmail;
        const submitBtn = emailCaptureForm.querySelector('button');
        if (submitBtn) submitBtn.textContent = '✓ Saved';
      }

      emailCaptureForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const val = studentEmailInput.value.trim();
        if (val) {
          localStorage.setItem('tinykite_typeracer_student_email', val);
          const submitBtn = emailCaptureForm.querySelector('button');
          if (submitBtn) {
            submitBtn.textContent = '✓ Progress Saved!';
            submitBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-bold bg-emerald-500 text-white whitespace-nowrap shadow-sm';
          }
          const studentTag = document.getElementById('academy-student-tag');
          if (studentTag) studentTag.textContent = '✓ Synced to ' + val;
        }
      });
    }

    // --- Action Button Handlers ---
