  <!-- Passages Data defined for client script -->
  <script is:inline define:vars={{ initialPassages: PASSAGES }}>
    window.__11P_PASSAGES__ = initialPassages;
  </script>

  <!-- Complete TypeRacer & Academy Engine Script -->
  <script is:inline>
    // --- Web Audio Sound Engine ---
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }

      init() {
        if (!this.ctx && typeof window !== 'undefined') {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) this.ctx = new AudioContextClass();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume().catch(() => {});
        }
      }

      playKeyClick() {
        if (!this.enabled) return;
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(640, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(120, this.ctx.currentTime + 0.04);
          gain.gain.setValueAtTime(0.09, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.04);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.04);
        } catch (e) {}
      }

      playReturnClick() {
        if (!this.enabled) return;
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(880, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(440, this.ctx.currentTime + 0.15);
          gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.15);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.15);
        } catch (e) {}
      }

      playError() {
        if (!this.enabled) return;
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(140, this.ctx.currentTime);
          gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.08);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.08);
        } catch (e) {}
      }

      playFinishChime(isVictory = false) {
        if (!this.enabled) return;
        try {
          this.init();
          if (!this.ctx) return;
          const notes = isVictory ? [523.25, 659.25, 783.99, 1046.50] : [440, 554.37, 659.25];
          notes.forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.1);
            gain.gain.setValueAtTime(0.15, this.ctx.currentTime + idx * 0.1);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + idx * 0.1 + 0.3);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(this.ctx.currentTime + idx * 0.1);
            osc.stop(this.ctx.currentTime + idx * 0.1 + 0.3);
          });
        } catch (e) {}
      }
    }

    const sound = new SoundEngine();

    // --- Screen Reader Accessibility Helpers ---
    function announceSrStatus(msg) {
      const el = document.getElementById('academy-sr-status');
      if (el) el.textContent = msg;
    }
    function announceSrAlert(msg) {
      const el = document.getElementById('academy-sr-alert');
      if (el) el.textContent = msg;
    }

    // --- Passages Data ---
    const passages = window.__11P_PASSAGES__ || [];
    let currentPassageIndex = 0;
    let currentPassage = passages[0];

    // --- Race Arena State ---
    let words = [];
    let currentWordIndex = 0;
    let currentInput = '';
    let isRaceActive = false;
    let isRaceFinished = false;
    let raceStartTime = 0;
    let raceEndTime = 0;
    let totalKeystrokes = 0;
    let errorKeystrokes = 0;
    let hudTimerInterval = null;
    let rankCounter = 1;
    let followupMode = 'random';
    let currentRaceHasQA = true;

    // --- 4-Lane Racers Configuration ---
    const localRacerId = 'player_' + Math.random().toString(36).substring(2, 9);
    const localRacerName = 'Player_' + localRacerId.slice(-4);
    const localRacerAvatar = '🏎️';

    const racers = [
      { id: 'player', name: 'You', avatar: '🏎️', isPlayer: true, progress: 0, currentWpm: 0, rank: null, finishTime: null },
      { id: 'bot-1', name: 'Cadence_Pro', avatar: '🏎️', isBot: true, isPeer: false, targetWpm: 65, progress: 0, currentWpm: 0, rank: null, finishTime: null },
      { id: 'bot-2', name: 'Oliver_T', avatar: '🚗', isBot: true, isPeer: false, targetWpm: 48, progress: 0, currentWpm: 0, rank: null, finishTime: null },
      { id: 'bot-3', name: 'Jane_Eyre', avatar: '🚕', isBot: true, isPeer: false, targetWpm: 78, progress: 0, currentWpm: 0, rank: null, finishTime: null }
    ];

    function getRandomHumanWpm() {
      const r = Math.random();
      if (r < 0.20) return Math.floor(32 + Math.random() * 13);
      if (r < 0.75) return Math.floor(45 + Math.random() * 30);
      if (r < 0.95) return Math.floor(75 + Math.random() * 25);
      return Math.floor(100 + Math.random() * 18);
    }

    const botAvatars = ['🏎️', '🚗', '🚕', '🚙', '🚀', '⚡', '🚴'];
    const botNames = ['Grammar_Hero', 'Pip_Gargery', 'Elizabeth_B', 'Sherlock_H', 'Eyre_Typist', 'Classic_Cadence', '11Plus_Scholar', 'Speedy_Scrooge', 'Alice_Liddell'];

    function randomizeBots() {
      for (let i = 1; i <= 3; i++) {
        if (racers[i].isPeer) continue; // Preserve live connected peer!

        racers[i].targetWpm = getRandomHumanWpm();
        racers[i].progress = 0;
        racers[i].currentWpm = 0;
        racers[i].rank = null;
        racers[i].finishTime = null;
        racers[i].name = botNames[Math.floor(Math.random() * botNames.length)];
        racers[i].avatar = botAvatars[Math.floor(Math.random() * botAvatars.length)];

        const nameEl = document.getElementById('racer-' + i + '-name');
        const avatarEl = document.getElementById('racer-' + i + '-avatar');
        const badgeEl = document.getElementById('racer-' + i + '-badge');
        const wpmEl = document.getElementById('racer-' + i + '-wpm');
        const medalEl = document.getElementById('racer-' + i + '-medal');
        const racerEl = document.getElementById('racer-' + i);

        if (nameEl) nameEl.textContent = racers[i].name;
        if (avatarEl) avatarEl.textContent = racers[i].avatar;
        if (badgeEl) {
          badgeEl.textContent = 'BOT';
          badgeEl.className = 'text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded';
        }
        if (wpmEl) wpmEl.textContent = '0 WPM';
        if (medalEl) medalEl.classList.add('hidden');
        if (racerEl) racerEl.style.left = '0%';
      }
    }

    // --- Cross-Tab P2P Multiplayer Networking (BroadcastChannel + LocalStorage fallback) ---
    let p2pBroadcast = null;
    let activePeerId = null;

    try {
      if (typeof BroadcastChannel !== 'undefined') {
        p2pBroadcast = new BroadcastChannel('tk_typeracer_p2p_v2');
        p2pBroadcast.onmessage = function(e) {
          handleP2PPayload(e.data);
        };
      }
    } catch (e) {}

    window.addEventListener('storage', function(e) {
      if (e.key === 'tk_typeracer_p2p_signal' && e.newValue) {
        try {
          const data = JSON.parse(e.newValue);
          handleP2PPayload(data);
        } catch (err) {}
      }
    });

    function sendP2PMessage(data) {
      data.senderId = localRacerId;
      data.timestamp = Date.now();
      if (p2pBroadcast) {
        try { p2pBroadcast.postMessage(data); } catch (e) {}
      }
      try {
        localStorage.setItem('tk_typeracer_p2p_signal', JSON.stringify(data));
      } catch (e) {}
    }

    function handleP2PPayload(data) {
      if (!data || data.senderId === localRacerId) return;

      if (data.type === 'LOBBY_JOIN') {
        activePeerId = data.senderId;
        promoteLaneToPeer(1, data.name || 'Peer Racer', data.avatar || '🏎️');

        sendP2PMessage({
          type: 'LOBBY_ACK',
          targetId: data.senderId,
          name: localRacerName,
          avatar: localRacerAvatar,
          passageIndex: currentPassageIndex
        });

        updateLobbyPeerCount(2);
      } else if (data.type === 'LOBBY_ACK') {
        activePeerId = data.senderId;
        promoteLaneToPeer(1, data.name || 'Peer Racer', data.avatar || '🏎️');

        if (!isRaceActive && data.passageIndex !== undefined && data.passageIndex !== currentPassageIndex) {
          loadPassage(data.passageIndex, false);
        }

        updateLobbyPeerCount(2);
      } else if (data.type === 'PROGRESS') {
        if (!activePeerId) {
          activePeerId = data.senderId;
          promoteLaneToPeer(1, data.name || 'Peer Racer', data.avatar || '🏎️');
        }
        if (data.senderId === activePeerId) {
          if (!racers[1].isPeer) promoteLaneToPeer(1, data.name || 'Peer Racer', data.avatar || '🏎️');
          updatePeerRacerProgress(1, data.progress, data.wpm, data.rank);
        }
      } else if (data.type === 'FINISH') {
        if (!activePeerId) {
          activePeerId = data.senderId;
          promoteLaneToPeer(1, data.name || 'Peer Racer', data.avatar || '🏎️');
        }
        if (data.senderId === activePeerId) {
          handlePeerFinish(1, data.wpm, data.rank);
        }
      }
    }

    function promoteLaneToPeer(laneIdx, name, avatar) {
      racers[laneIdx].isBot = false;
      racers[laneIdx].isPeer = true;
      racers[laneIdx].id = activePeerId;
      racers[laneIdx].name = name;
      racers[laneIdx].avatar = avatar;

      const nameEl = document.getElementById('racer-' + laneIdx + '-name');
      const avatarEl = document.getElementById('racer-' + laneIdx + '-avatar');
      const badgeEl = document.getElementById('racer-' + laneIdx + '-badge');

      if (nameEl) nameEl.textContent = name;
      if (avatarEl) avatarEl.textContent = avatar;
      if (badgeEl) {
        badgeEl.textContent = 'PEER · LIVE';
        badgeEl.className = 'text-[8px] font-black text-white bg-emerald-600 px-1.5 py-0.5 rounded shadow-sm animate-pulse';
      }
    }

    function updatePeerRacerProgress(laneIdx, progress, wpm, rank) {
      racers[laneIdx].progress = progress;
      racers[laneIdx].currentWpm = wpm;

      const racerEl = document.getElementById('racer-' + laneIdx);
      const wpmEl = document.getElementById('racer-' + laneIdx + '-wpm');
      if (racerEl) racerEl.style.left = Math.min(92, progress * 0.92) + '%';
      if (wpmEl) wpmEl.textContent = wpm + ' WPM';

      updateRaceRankings();
    }

