  <!-- TypeRacer Client Application Script -->
  <script>
    import type { Passage, Question } from '../../data/typeracer/passages';

    declare global {
      interface Window {
        __11P_PASSAGES__: Passage[];
      }
    }

    // --- Web Audio API Synth Sound Engine ---
    class SoundEngine {
      private ctx: AudioContext | null = null;
      public enabled: boolean = true;

      private init() {
        if (!this.ctx && typeof window !== 'undefined') {
          const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (AudioContextClass) {
            this.ctx = new AudioContextClass();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      public playKeyClick() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(580, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(320, this.ctx.currentTime + 0.03);
          gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.03);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.03);
        } catch {
          // ignore audio failure
        }
      }

      public playError() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(140, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(90, this.ctx.currentTime + 0.12);
          gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.12);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.12);
        } catch {
          // ignore
        }
      }

      public playFinishChime() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
          notes.forEach((freq, idx) => {
            if (!this.ctx) return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.08);
            gain.gain.setValueAtTime(0.15, this.ctx.currentTime + idx * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + idx * 0.08 + 0.35);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(this.ctx.currentTime + idx * 0.08);
            osc.stop(this.ctx.currentTime + idx * 0.08 + 0.35);
          });
        } catch {
          // ignore
        }
      }

      public playCorrect() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const notes = [587.33, 880]; // D5, A5
          notes.forEach((freq, idx) => {
            if (!this.ctx) return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.1);
            gain.gain.setValueAtTime(0.14, this.ctx.currentTime + idx * 0.1);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + idx * 0.1 + 0.25);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(this.ctx.currentTime + idx * 0.1);
            osc.stop(this.ctx.currentTime + idx * 0.1 + 0.25);
          });
        } catch {
          // ignore
        }
      }
    }

    const sound = new SoundEngine();

    // --- State Variables ---
    const passages: Passage[] = window.__11P_PASSAGES__ || [];
    let currentPassageIndex = Math.floor(Math.random() * passages.length);
    let currentPassage: Passage = passages[currentPassageIndex];

    let words: string[] = [];
    let currentWordIndex = 0;
    let currentInput = '';
    let isRaceActive = false;
    let isRaceFinished = false;
    let raceStartTime = 0;
    let raceEndTime = 0;
    let totalKeystrokes = 0;
    let errorKeystrokes = 0;
    let hudTimerInterval: number | null = null;
    let pacerInterval: number | null = null;
    let pacerProgress = 0; // 0 to 100%
    let pacerWpm = 45;

    // Phase 2 Questions State
    let currentQuestionIndex = 0;
    let questionsAnsweredCorrectly = 0;
    let questionAttemptCount = 0;

    // Career Stats
    interface CareerStats {
      races: number;
      bestWpm: number;
      totalWpm: number;
      questionsSolved: number;
    }

    function getCareerStats(): CareerStats {
      try {
        const data = localStorage.getItem('tinykite_typeracer_career');
        if (data) return JSON.parse(data);
      } catch {}
      return { races: 0, bestWpm: 0, totalWpm: 0, questionsSolved: 0 };
    }

    function saveCareerStats(stats: CareerStats) {
      try {
        localStorage.setItem('tinykite_typeracer_career', JSON.stringify(stats));
      } catch {}
    }

    function updateCareerUI() {
      const stats = getCareerStats();
      const racesEl = document.getElementById('career-races');
      const bestEl = document.getElementById('career-best-wpm');
      const avgEl = document.getElementById('career-avg-wpm');
      const qEl = document.getElementById('career-questions');

      if (racesEl) racesEl.textContent = stats.races.toString();
      if (bestEl) bestEl.textContent = `${stats.bestWpm} WPM`;
      if (avgEl) {
        const avg = stats.races > 0 ? Math.round(stats.totalWpm / stats.races) : 0;
        avgEl.textContent = `${avg} WPM`;
      }
      if (qEl) qEl.textContent = stats.questionsSolved.toString();
    }

    // --- DOM Elements ---
    const passageTitle = document.getElementById('passage-title');
    const passageAuthor = document.getElementById('passage-author');
    const passageDifficulty = document.getElementById('passage-difficulty');
    const passageGutenbergId = document.getElementById('passage-gutenberg-id');
    const passageGutenbergLink = document.getElementById('passage-gutenberg-link') as HTMLAnchorElement | null;
    const passageDisplay = document.getElementById('passage-display');
    const typingInput = document.getElementById('typing-input') as HTMLInputElement | null;
    const typingErrorTag = document.getElementById('typing-error-tag');
    const raceStatusText = document.getElementById('race-status-text');
    const playerRacer = document.getElementById('player-racer');
    const playerWpmPill = document.getElementById('player-wpm-pill');
    const pacerRacer = document.getElementById('pacer-racer');
    const pacerLane = document.getElementById('pacer-lane');
    const pacerLabel = document.getElementById('pacer-label');
    const pacerSelect = document.getElementById('pacer-select') as HTMLSelectElement | null;
    const hudWpm = document.getElementById('hud-wpm');
    const hudAccuracy = document.getElementById('hud-accuracy');
    const hudTime = document.getElementById('hud-time');
    const hudProgress = document.getElementById('hud-progress');

    // Vocab Elements
    const btnToggleVocab = document.getElementById('btn-toggle-vocab');
    const vocabDrawer = document.getElementById('vocab-drawer');
    const vocabList = document.getElementById('vocab-list');
    const vocabCount = document.getElementById('vocab-count');

    // Views
    const typingRaceView = document.getElementById('typing-race-view');
    const questionChallengeView = document.getElementById('question-challenge-view');
    const grandResultsView = document.getElementById('grand-results-view');

    // Question Challenge Elements
    const refPassageText = document.getElementById('ref-passage-text');
    const finishRaceWpm = document.getElementById('finish-race-wpm');
    const finishRaceAcc = document.getElementById('finish-race-acc');
    const questionStep = document.getElementById('question-step');
    const questionTypeBadge = document.getElementById('question-type-badge');
    const questionPrompt = document.getElementById('question-prompt');
    const questionInput = document.getElementById('question-input') as HTMLInputElement | null;
    const questionForm = document.getElementById('question-form');
    const btnShowHint = document.getElementById('btn-show-hint');
    const hintBox = document.getElementById('hint-box');
    const hintContent = document.getElementById('hint-content');
    const answerFeedback = document.getElementById('answer-feedback');
    const feedbackIcon = document.getElementById('feedback-icon');
    const feedbackTitle = document.getElementById('feedback-title');
    const feedbackExplanation = document.getElementById('feedback-explanation');
    const btnRevealAnswer = document.getElementById('btn-reveal-answer');
    const btnSubmitAnswer = document.getElementById('btn-submit-answer');

    // Grand Results Elements
    const finalWpm = document.getElementById('final-wpm');
    const finalAccuracy = document.getElementById('final-accuracy');
    const finalQuestions = document.getElementById('final-questions');
    const finalTime = document.getElementById('final-time');
    const resultsVocabGrid = document.getElementById('results-vocab-grid');
    const resultsRankPill = document.getElementById('results-rank-pill');
    const resultsBadgeIcon = document.getElementById('results-badge-icon');
    const resultsGutenbergBtn = document.getElementById('results-gutenberg-btn') as HTMLAnchorElement | null;
    const btnResultsNext = document.getElementById('btn-results-next');
    const btnResultsRetry = document.getElementById('btn-results-retry');
    const btnShareScore = document.getElementById('btn-share-score');
    const shareBtnText = document.getElementById('share-btn-text');

    // Library Modal Elements
    const btnOpenLibrary = document.getElementById('btn-open-library');
    const btnCloseLibrary = document.getElementById('btn-close-library');
    const libraryModal = document.getElementById('library-modal');
    const libraryCardsContainer = document.getElementById('library-cards-container');
    const librarySearch = document.getElementById('library-search') as HTMLInputElement | null;
    const libFilterBtns = document.querySelectorAll('.lib-filter-btn');

    // Audio SFX UI
    const btnToggleSound = document.getElementById('btn-toggle-sound');
    const soundIcon = document.getElementById('sound-icon');
    const soundLabel = document.getElementById('sound-label');

    // Random Book Button
    const btnNextPassage = document.getElementById('btn-next-passage');

    // --- Sound Settings Persistence ---
    const savedSound = localStorage.getItem('tinykite_typeracer_sound');
    if (savedSound === 'off') {
      sound.enabled = false;
      if (soundIcon) soundIcon.textContent = '🔇';
      if (soundLabel) soundLabel.textContent = 'Muted';
    }

    if (btnToggleSound) {
      btnToggleSound.addEventListener('click', () => {
        sound.enabled = !sound.enabled;
        localStorage.setItem('tinykite_typeracer_sound', sound.enabled ? 'on' : 'off');
        if (soundIcon) soundIcon.textContent = sound.enabled ? '🔊' : '🔇';
        if (soundLabel) soundLabel.textContent = sound.enabled ? 'Sound On' : 'Muted';
      });
    }

    // --- Reset Career Stats ---
    const btnResetCareer = document.getElementById('btn-reset-career');
    if (btnResetCareer) {
      btnResetCareer.addEventListener('click', () => {
        if (confirm("Reset your 11+ TypeRacer career stats?")) {
          saveCareerStats({ races: 0, bestWpm: 0, totalWpm: 0, questionsSolved: 0 });
          updateCareerUI();
        }
      });
    }

    // --- Initialize / Render Current Passage ---
    function loadPassage(index: number) {
      currentPassageIndex = index;
      currentPassage = passages[currentPassageIndex];
      words = currentPassage.text.split(' ');
      currentWordIndex = 0;
      currentInput = '';
      isRaceActive = false;
      isRaceFinished = false;
      raceStartTime = 0;
      raceEndTime = 0;
      totalKeystrokes = 0;
      errorKeystrokes = 0;
      pacerProgress = 0;

      if (hudTimerInterval) clearInterval(hudTimerInterval);
      if (pacerInterval) clearInterval(pacerInterval);

      // Views
      if (typingRaceView) typingRaceView.classList.remove('hidden');
      if (questionChallengeView) questionChallengeView.classList.add('hidden');
      if (grandResultsView) grandResultsView.classList.add('hidden');

      // Update Citation
      if (passageTitle) passageTitle.textContent = currentPassage.title;
      if (passageAuthor) passageAuthor.textContent = `by ${currentPassage.author} (${currentPassage.year}) • ${currentPassage.chapter}`;
      if (passageDifficulty) {
        passageDifficulty.textContent = currentPassage.difficulty;
        if (currentPassage.difficulty === 'Foundation') {
          passageDifficulty.className = 'px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
        } else if (currentPassage.difficulty === 'Standard 11+') {
          passageDifficulty.className = 'px-2 py-0.5 rounded-full text-[11px] font-bold bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300';
        } else {
          passageDifficulty.className = 'px-2 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300';
        }
      }
      if (passageGutenbergId) passageGutenbergId.textContent = currentPassage.gutenbergId.toString();
      if (passageGutenbergLink) passageGutenbergLink.href = currentPassage.gutenbergUrl;

      // Update Vocab Drawer
      if (vocabCount) vocabCount.textContent = currentPassage.vocabulary.length.toString();
      if (vocabList) {
        vocabList.innerHTML = currentPassage.vocabulary.map(v => `
          <div class="p-2 rounded-xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10">
            <span class="font-bold text-brand-navy dark:text-brand-cream">${v.word}:</span>
            <span class="text-brand-slate dark:text-gray-300 ml-1">${v.definition}</span>
          </div>
        `).join('');
      }

      // Reset HUD & Track
      if (hudWpm) hudWpm.textContent = '0';
      if (hudAccuracy) hudAccuracy.textContent = '100';
      if (hudTime) hudTime.textContent = '0:00';
      if (hudProgress) hudProgress.textContent = '0';
      if (playerRacer) playerRacer.style.left = '0%';
      if (playerWpmPill) playerWpmPill.textContent = '0 WPM';
      if (pacerRacer) pacerRacer.style.left = '0%';
      if (raceStatusText) raceStatusText.textContent = 'Ready to Race';

      // Reset Input
      if (typingInput) {
        typingInput.value = '';
        typingInput.disabled = false;
        typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
        typingInput.focus();
      }
      if (typingErrorTag) typingErrorTag.classList.add('hidden');

      renderPassageWords();
    }

    // --- Render Passage Letter-by-Letter Display ---
    function renderPassageWords() {
      if (!passageDisplay) return;

      const wordsHtml = words.map((word, wIdx) => {
        if (wIdx < currentWordIndex) {
          // Completed word
          return `<span class="text-brand-teal dark:text-emerald-400 font-medium">${escapeHtml(word)}</span>`;
        } else if (wIdx === currentWordIndex) {
          // Current active word: render character breakdown
          const target = word;
          const typed = currentInput;
          let charsHtml = '';

          // Compare typed characters against target
          let isError = false;
          for (let i = 0; i < target.length; i++) {
            if (i < typed.length) {
              if (typed[i] === target[i] && !isError) {
                // Correctly typed character
                charsHtml += `<span class="text-brand-teal dark:text-emerald-400 font-bold underline decoration-brand-teal/50 decoration-2">${escapeHtml(target[i])}</span>`;
              } else {
                // First error or continued error
                isError = true;
                charsHtml += `<span class="bg-rose-500/20 text-rose-600 dark:text-rose-400 font-bold underline decoration-rose-500 decoration-2">${escapeHtml(target[i])}</span>`;
              }
            } else {
              // Untyped remaining characters in current word
              charsHtml += `<span class="text-brand-navy dark:text-brand-cream">${escapeHtml(target[i])}</span>`;
            }
          }

          // If typed is longer than target word (extra erroneous characters)
          if (typed.length > target.length) {
            const extra = typed.slice(target.length);
            charsHtml += `<span class="bg-rose-500/30 text-rose-700 dark:text-rose-300 font-bold line-through">${escapeHtml(extra)}</span>`;
          }

          return `<span class="inline-block px-1 py-0.5 rounded bg-brand-gold/15 dark:bg-brand-gold/10 ring-1 ring-brand-gold/30">${charsHtml}</span>`;
        } else {
          // Upcoming word
          return `<span class="text-brand-navy/60 dark:text-gray-300">${escapeHtml(word)}</span>`;
        }
      }).join(' ');

      passageDisplay.innerHTML = wordsHtml;
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // --- Typing Input Event Handler ---
    if (typingInput) {
      typingInput.addEventListener('keydown', (e) => {
        // Start race timer on first non-modifier keystroke
        if (!isRaceActive && !isRaceFinished && e.key.length === 1) {
          startRace();
        }

        // Space bar handling
        if (e.key === ' ' && isRaceActive) {
          const currentTargetWord = words[currentWordIndex];
          const typedVal = typingInput.value.trim();

          // If word matches target exactly, advance!
          if (typedVal === currentTargetWord) {
            e.preventDefault();
            sound.playKeyClick();
            currentWordIndex++;
            currentInput = '';
            typingInput.value = '';
            totalKeystrokes++;

            // If this was the last word, finish!
            if (currentWordIndex >= words.length) {
              finishRace();
              return;
            }

            renderPassageWords();
            updateRaceMetrics();
            return;
          }
        }
      });

      typingInput.addEventListener('input', () => {
        if (!isRaceActive && !isRaceFinished) {
          startRace();
        }

        currentInput = typingInput.value;
        const currentTargetWord = words[currentWordIndex];

        // Track keystrokes
        totalKeystrokes++;

        // Check if current input matches the target prefix
        const isPrefixMatch = currentTargetWord.startsWith(currentInput);
        if (!isPrefixMatch) {
          errorKeystrokes++;
          sound.playError();
          typingInput.classList.add('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.classList.remove('hidden');
        } else {
          sound.playKeyClick();
          typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.classList.add('hidden');
        }

        // Check if final word is completed (no space required on last word)
        if (currentWordIndex === words.length - 1 && currentInput === currentTargetWord) {
          finishRace();
          return;
        }

        renderPassageWords();
        updateRaceMetrics();
      });
    }

    // --- Race Lifecycle Functions ---
    function startRace() {
      isRaceActive = true;
      raceStartTime = Date.now();
      if (raceStatusText) raceStatusText.textContent = '🏁 Racing!';

      // Live HUD Timer
      hudTimerInterval = window.setInterval(() => {
        const elapsedSec = Math.floor((Date.now() - raceStartTime) / 1000);
        const mins = Math.floor(elapsedSec / 60);
        const secs = elapsedSec % 60;
        if (hudTime) hudTime.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
        updateLiveWpm(elapsedSec);
      }, 300);

      // Start Pacer Bot
      startPacer();
    }

    function startPacer() {
      if (pacerWpm <= 0) {
        if (pacerLane) pacerLane.classList.add('hidden');
        return;
      }
      if (pacerLane) pacerLane.classList.remove('hidden');
      if (pacerLabel) pacerLabel.textContent = `Pacer ${pacerWpm} WPM`;

      // Total characters in passage
      const totalChars = currentPassage.text.length;
      // Target characters per second = (WPM * 5) / 60
      const charsPerSec = (pacerWpm * 5) / 60;
      const totalPacerSeconds = totalChars / charsPerSec;

      pacerInterval = window.setInterval(() => {
        if (!isRaceActive) return;
        const elapsed = (Date.now() - raceStartTime) / 1000;
        pacerProgress = Math.min(100, (elapsed / totalPacerSeconds) * 100);
        if (pacerRacer) pacerRacer.style.left = `${Math.min(92, pacerProgress * 0.92)}%`;
      }, 100);
    }

    function updateLiveWpm(elapsedSec: number) {
      if (elapsedSec <= 0) return;
      // Characters typed in completed words + current matched characters
      let typedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        typedChars += words[i].length + 1; // word + space
      }
      typedChars += Math.min(currentInput.length, words[currentWordIndex]?.length || 0);

      const wordsTyped = typedChars / 5;
      const minutes = elapsedSec / 60;
      const wpm = Math.round(wordsTyped / minutes);

      if (hudWpm) hudWpm.textContent = Math.max(0, wpm).toString();
      if (playerWpmPill) playerWpmPill.textContent = `${Math.max(0, wpm)} WPM`;
    }

    function updateRaceMetrics() {
      const totalChars = currentPassage.text.length;
      let completedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        completedChars += words[i].length + 1;
      }
      completedChars += Math.min(currentInput.length, words[currentWordIndex]?.length || 0);

      const pct = Math.min(100, Math.round((completedChars / totalChars) * 100));
      if (hudProgress) hudProgress.textContent = pct.toString();

      // Update racer car position (capped at ~92% so it stays within track)
      if (playerRacer) {
        playerRacer.style.left = `${Math.min(92, (pct / 100) * 92)}%`;
      }

      // Accuracy
      if (totalKeystrokes > 0 && hudAccuracy) {
        const acc = Math.max(0, Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100));
        hudAccuracy.textContent = acc.toString();
      }
    }

    function finishRace() {
      isRaceActive = false;
      isRaceFinished = true;
      raceEndTime = Date.now();

      if (hudTimerInterval) clearInterval(hudTimerInterval);
      if (pacerInterval) clearInterval(pacerInterval);

      sound.playFinishChime();

      if (playerRacer) playerRacer.style.left = '92%';
      if (raceStatusText) raceStatusText.textContent = '🏁 Finished!';

      const elapsedSeconds = Math.max(1, (raceEndTime - raceStartTime) / 1000);
      const totalWords = currentPassage.text.length / 5;
      const wpm = Math.round((totalWords / elapsedSeconds) * 60);
      const accuracy = totalKeystrokes > 0 ? Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100) : 100;

      // Transition to Phase 2: 11+ Question Challenge Sprint after brief celebration!
      setTimeout(() => {
        startQuestionPhase(wpm, accuracy);
      }, 1200);
    }

    // --- PHASE 2: 11+ QUESTION CHALLENGE ---
    let raceWpmResult = 0;
    let raceAccResult = 100;

    function startQuestionPhase(wpm: number, acc: number) {
      raceWpmResult = wpm;
      raceAccResult = acc;

      if (typingRaceView) typingRaceView.classList.add('hidden');
      if (questionChallengeView) questionChallengeView.classList.remove('hidden');

      if (finishRaceWpm) finishRaceWpm.textContent = wpm.toString();
      if (finishRaceAcc) finishRaceAcc.textContent = `${acc}%`;
      if (refPassageText) refPassageText.textContent = `"${currentPassage.text}"`;

      currentQuestionIndex = 0;
      questionsAnsweredCorrectly = 0;
      questionAttemptCount = 0;

      loadQuestion(0);
    }

    function loadQuestion(index: number) {
      currentQuestionIndex = index;
      const q = currentPassage.questions[currentQuestionIndex];
      questionAttemptCount = 0;

      if (questionStep) questionStep.textContent = `Question ${index + 1} of ${currentPassage.questions.length}`;
      if (questionTypeBadge) {
        const typeLabels: Record<string, string> = {
          vocabulary: 'Vocabulary in Context',
          retrieval: 'Fact Retrieval',
          inference: '11+ Inference & Deduction',
          grammar: 'Grammar & Literary Devices'
        };
        questionTypeBadge.textContent = typeLabels[q.type] || '11+ Comprehension';
      }
      if (questionPrompt) questionPrompt.textContent = q.question;

      if (questionInput) {
        questionInput.value = '';
        questionInput.disabled = false;
        questionInput.focus();
      }

      if (hintBox) hintBox.classList.add('hidden');
      if (hintContent) hintContent.textContent = q.hint;
      if (btnRevealAnswer) btnRevealAnswer.classList.add('hidden');
      if (answerFeedback) answerFeedback.classList.add('hidden');
      if (btnSubmitAnswer) {
        btnSubmitAnswer.textContent = 'Submit Answer ↵';
        btnSubmitAnswer.disabled = false;
      }
    }

    if (btnShowHint) {
      btnShowHint.addEventListener('click', () => {
        if (hintBox) hintBox.classList.toggle('hidden');
      });
    }

    function normalizeAnswer(str: string): string {
      return str.trim().toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, ' ');
    }

    if (questionForm) {
      questionForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!questionInput) return;

        const typedAnswer = questionInput.value;
        if (!typedAnswer.trim()) return;

        const q = currentPassage.questions[currentQuestionIndex];
        const normalizedInput = normalizeAnswer(typedAnswer);
        const normalizedTarget = normalizeAnswer(q.answer);
        const normalizedAcceptable = q.acceptableAnswers.map(a => normalizeAnswer(a));

        const isMatch = normalizedInput === normalizedTarget || normalizedAcceptable.includes(normalizedInput);

        if (isMatch) {
          // Correct answer!
          sound.playCorrect();
          questionsAnsweredCorrectly++;
          showFeedback(true, "✓ Correct! (+100 pts)", q.explanation);

          // Update career stats for questions
          const stats = getCareerStats();
          stats.questionsSolved++;
          saveCareerStats(stats);
          updateCareerUI();

          questionInput.disabled = true;
          if (btnSubmitAnswer) btnSubmitAnswer.disabled = true;

          setTimeout(() => {
            if (currentQuestionIndex + 1 < currentPassage.questions.length) {
              loadQuestion(currentQuestionIndex + 1);
            } else {
              showGrandResults();
            }
          }, 1800);
        } else {
          // Incorrect
          sound.playError();
          questionAttemptCount++;
          showFeedback(false, "Not quite right!", `Check the passage carefully and try again. Hint: ${q.hint}`);
          if (btnRevealAnswer) btnRevealAnswer.classList.remove('hidden');
        }
      });
    }

    if (btnRevealAnswer) {
      btnRevealAnswer.addEventListener('click', () => {
        const q = currentPassage.questions[currentQuestionIndex];
        showFeedback(false, `The answer is: "${q.answer}"`, q.explanation);
        if (btnSubmitAnswer) {
          btnSubmitAnswer.textContent = 'Next Question →';
          btnSubmitAnswer.disabled = false;
          btnSubmitAnswer.onclick = () => {
            btnSubmitAnswer.onclick = null;
            if (currentQuestionIndex + 1 < currentPassage.questions.length) {
              loadQuestion(currentQuestionIndex + 1);
            } else {
              showGrandResults();
            }
          };
        }
      });
    }

    function showFeedback(isCorrect: boolean, title: string, explanation: string) {
      if (!answerFeedback || !feedbackIcon || !feedbackTitle || !feedbackExplanation) return;

      answerFeedback.classList.remove('hidden', 'bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-800', 'dark:text-emerald-200', 'bg-rose-500/10', 'border-rose-500/30', 'text-rose-800', 'dark:text-rose-200');

      if (isCorrect) {
        answerFeedback.classList.add('bg-emerald-500/10', 'border', 'border-emerald-500/30', 'text-emerald-800', 'dark:text-emerald-200');
        feedbackIcon.textContent = '🌟';
      } else {
        answerFeedback.classList.add('bg-rose-500/10', 'border', 'border-rose-500/30', 'text-rose-800', 'dark:text-rose-200');
        feedbackIcon.textContent = '⚠️';
      }

      feedbackTitle.textContent = title;
      feedbackExplanation.textContent = explanation;
    }

    // --- PHASE 3: GRAND RESULTS SCREEN ---
    function showGrandResults() {
      if (questionChallengeView) questionChallengeView.classList.add('hidden');
      if (grandResultsView) grandResultsView.classList.remove('hidden');

      const totalElapsedSec = Math.round((Date.now() - raceStartTime) / 1000);

      if (finalWpm) finalWpm.textContent = raceWpmResult.toString();
      if (finalAccuracy) finalAccuracy.textContent = raceAccResult.toString();
      if (finalQuestions) finalQuestions.textContent = `${questionsAnsweredCorrectly}/${currentPassage.questions.length}`;
      if (finalTime) finalTime.textContent = `${totalElapsedSec}s`;

      // Determine 11+ Award Tier
      let rankTitle = '🥉 Junior 11+ Cadet';
      let rankIcon = '🎖️';
      if (raceWpmResult >= 50 && raceAccResult >= 95 && questionsAnsweredCorrectly === currentPassage.questions.length) {
        rankTitle = '🏆 11+ Scholarship Grandmaster';
        rankIcon = '🏆';
      } else if (raceWpmResult >= 38 && raceAccResult >= 90 && questionsAnsweredCorrectly >= 2) {
        rankTitle = '🥇 Grammar School Ready';
        rankIcon = '🥇';
      } else if (raceWpmResult >= 28 && raceAccResult >= 85) {
        rankTitle = '🥈 11+ Speed Apprentice';
        rankIcon = '🥈';
      }

      if (resultsRankPill) resultsRankPill.textContent = rankTitle;
      if (resultsBadgeIcon) resultsBadgeIcon.textContent = rankIcon;

      // Populate Vocabulary Grid
      if (resultsVocabGrid) {
        resultsVocabGrid.innerHTML = currentPassage.vocabulary.map(v => `
          <div class="p-3 rounded-xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10">
            <span class="font-bold text-brand-navy dark:text-brand-cream block text-xs uppercase tracking-wider mb-1">${v.word}</span>
            <span class="text-xs text-brand-slate dark:text-gray-300 leading-snug">${v.definition}</span>
          </div>
        `).join('');
      }

      if (resultsGutenbergBtn) {
        resultsGutenbergBtn.href = currentPassage.gutenbergUrl;
      }

      // Save Lifetime Stats
      const stats = getCareerStats();
      stats.races++;
      stats.totalWpm += raceWpmResult;
      if (raceWpmResult > stats.bestWpm) stats.bestWpm = raceWpmResult;
      saveCareerStats(stats);
      updateCareerUI();
    }

    // --- Action Button Listeners ---
    if (btnResultsNext || btnNextPassage) {
      const nextFn = () => {
        let nextIdx = Math.floor(Math.random() * passages.length);
        if (nextIdx === currentPassageIndex && passages.length > 1) {
          nextIdx = (nextIdx + 1) % passages.length;
        }
        loadPassage(nextIdx);
      };
      if (btnResultsNext) btnResultsNext.addEventListener('click', nextFn);
      if (btnNextPassage) btnNextPassage.addEventListener('click', nextFn);
    }

    if (btnResultsRetry) {
      btnResultsRetry.addEventListener('click', () => {
        loadPassage(currentPassageIndex);
      });
    }

    if (btnShareScore) {
      btnShareScore.addEventListener('click', () => {
        const text = `🏁 TinyKite 11+ TypeRacer\n📖 Book: ${currentPassage.title} (${currentPassage.author})\n⚡ Speed: ${raceWpmResult} WPM | 🎯 Accuracy: ${raceAccResult}%\n🧠 11+ Questions: ${questionsAnsweredCorrectly}/${currentPassage.questions.length} Correct\nTry it 100% ad-free: https://tinykite.co/typeracer`;
        navigator.clipboard.writeText(text).then(() => {
          if (shareBtnText) {
            const original = shareBtnText.textContent;
            shareBtnText.textContent = 'Copied to Clipboard! ✓';
            setTimeout(() => { shareBtnText.textContent = original; }, 2500);
          }
        }).catch(() => {
          alert(text);
        });
      });
    }

    // --- Pacer Selector Change ---
    if (pacerSelect) {
      pacerSelect.addEventListener('change', () => {
        pacerWpm = parseInt(pacerSelect.value, 10);
        if (!isRaceActive && !isRaceFinished) {
          if (pacerWpm <= 0) {
            if (pacerLane) pacerLane.classList.add('hidden');
          } else {
            if (pacerLane) pacerLane.classList.remove('hidden');
            if (pacerLabel) pacerLabel.textContent = `Pacer ${pacerWpm} WPM`;
          }
        }
      });
    }

    // --- Toggle Vocab Drawer ---
    if (btnToggleVocab && vocabDrawer) {
      btnToggleVocab.addEventListener('click', () => {
        vocabDrawer.classList.toggle('hidden');
      });
    }

    // --- Library Modal Logic ---
    function populateLibraryCards(filter: string = 'all', searchQuery: string = '') {
      if (!libraryCardsContainer) return;

      const q = searchQuery.toLowerCase().trim();
      const filtered = passages.filter(p => {
        const matchFilter = filter === 'all' || p.difficulty === filter;
        const matchSearch = !q || p.title.toLowerCase().includes(q) || p.author.toLowerCase().includes(q) || p.text.toLowerCase().includes(q);
        return matchFilter && matchSearch;
      });

      if (filtered.length === 0) {
        libraryCardsContainer.innerHTML = `<div class="text-center py-10 text-brand-slate text-sm">No books found matching "${escapeHtml(searchQuery)}".</div>`;
        return;
      }

      libraryCardsContainer.innerHTML = filtered.map((p) => {
        const realIdx = passages.findIndex(item => item.id === p.id);
        return `
          <div class="p-4 rounded-2xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10 hover:border-brand-gold/60 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h4 class="font-bold text-sm text-brand-navy dark:text-brand-cream">${p.title}</h4>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${
                  p.difficulty === 'Foundation' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300' :
                  p.difficulty === 'Standard 11+' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300' :
                  'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300'
                }">${p.difficulty}</span>
              </div>
              <p class="text-xs text-brand-slate dark:text-gray-400 mb-2">by ${p.author} (${p.year}) • Gutenberg #${p.gutenbergId}</p>
              <p class="text-xs text-brand-navy/70 dark:text-gray-300 italic line-clamp-2">"${p.text}"</p>
            </div>
            <button class="btn-select-book px-4 py-2 bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy text-xs font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all whitespace-nowrap self-start sm:self-center" data-index="${realIdx}">
              Race This Book ↵
            </button>
          </div>
        `;
      }).join('');

      // Add click listeners to book buttons
      libraryCardsContainer.querySelectorAll('.btn-select-book').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          if (libraryModal) libraryModal.classList.add('hidden');
          loadPassage(idx);
        });
      });
    }

    if (btnOpenLibrary && libraryModal) {
      btnOpenLibrary.addEventListener('click', () => {
        libraryModal.classList.remove('hidden');
        populateLibraryCards();
      });
    }

    if (btnCloseLibrary && libraryModal) {
      btnCloseLibrary.addEventListener('click', () => {
        libraryModal.classList.add('hidden');
      });
    }

    if (librarySearch) {
      librarySearch.addEventListener('input', () => {
        populateLibraryCards('all', librarySearch.value);
      });
    }

    libFilterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        libFilterBtns.forEach(b => {
          b.className = 'lib-filter-btn px-2.5 py-1 rounded-lg font-semibold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20';
        });
        const target = e.currentTarget as HTMLElement;
        target.className = 'lib-filter-btn px-2.5 py-1 rounded-lg font-bold bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy';
        const filter = target.getAttribute('data-filter') || 'all';
        populateLibraryCards(filter, librarySearch?.value || '');
      });
    });

    // --- On Initial Load ---
    updateCareerUI();
    loadPassage(currentPassageIndex);
  </script>
</Layout>
