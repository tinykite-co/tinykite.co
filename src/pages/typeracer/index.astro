        id: 'lesson-11',
        level: 'Level 3: Classical Fluency',
        title: 'Rhythmic Common Word Chunks',
        tip: 'Type common word clusters in single smooth bursts.',
        text: 'there was once upon a time in the midst of all the world and then',
        finger: 'Bursting Rhythm'
      },
      {
        id: 'lesson-12',
        level: 'Level 3: Classical Fluency',
        title: 'The 60+ WPM Scholarship Sprint',
        tip: 'Maintain unbroken rhythm across authentic Victorian prose.',
        text: 'Alice had not a moment to think about stopping herself before she found herself falling.',
        finger: 'Scholarship Fluency'
      }
    ];

    let currentLessonIndex = 0;
    let lessonTargetText = '';
    let lessonTypedText = '';
    let lessonKeyErrors = 0;
    let lessonTotalKeys = 0;

    const lessonInteractiveCard = document.getElementById('lesson-interactive-card');
    const lessonModuleTag = document.getElementById('lesson-module-tag');
    const lessonActiveTitle = document.getElementById('lesson-active-title');
    const lessonInstructionTip = document.getElementById('lesson-instruction-tip');
    const lessonTextDisplay = document.getElementById('lesson-text-display');
    const lessonInput = document.getElementById('lesson-input');
    const lessonHudAcc = document.getElementById('lesson-hud-acc');
    const fingerGuidanceCue = document.getElementById('finger-guidance-cue');
    const lessonErrorTag = document.getElementById('lesson-error-tag');
    const targetFingerLabel = document.getElementById('target-finger-label');
    const lessonsCurriculumGrid = document.getElementById('lessons-curriculum-grid');

    function loadLesson(index) {
      currentLessonIndex = index;
      const lesson = LESSONS[currentLessonIndex];
      lessonTargetText = lesson.text;
      lessonTypedText = '';
      lessonKeyErrors = 0;
      lessonTotalKeys = 0;

      if (lessonModuleTag) lessonModuleTag.textContent = lesson.level;
      if (lessonActiveTitle) lessonActiveTitle.textContent = lesson.title;
      if (lessonInstructionTip) lessonInstructionTip.textContent = lesson.tip;
      if (fingerGuidanceCue) fingerGuidanceCue.textContent = '👉 ' + lesson.finger;
      if (lessonHudAcc) lessonHudAcc.textContent = '100%';
      if (lessonErrorTag) lessonErrorTag.style.display = 'none';

      if (lessonInput) {
        lessonInput.value = '';
        lessonInput.disabled = false;
        try {
          lessonInput.focus({ preventScroll: true });
        } catch (e) {}
      }

      renderLessonDisplay();
      updateVirtualKeyboardHighlight();
      renderCurriculumGrid();
    }

    function renderLessonDisplay() {
      if (!lessonTextDisplay) return;

      let html = '';
      let error = false;
      for (let i = 0; i < lessonTargetText.length; i++) {
        const char = lessonTargetText[i];
        if (i < lessonTypedText.length) {
          if (lessonTypedText[i] === char && !error) {
            html += '<span class="text-emerald-600 dark:text-emerald-400 font-bold">' + escapeHtml(char) + '</span>';
          } else {
            error = true;
            html += '<span class="text-rose-600 bg-rose-100 dark:bg-rose-950/40 font-bold underline">' + escapeHtml(char) + '</span>';
          }
        } else if (i === lessonTypedText.length) {
          html += '<span class="bg-brand-gold text-brand-navy font-bold rounded px-0.5 animate-pulse">' + (char === ' ' ? '␣' : escapeHtml(char)) + '</span>';
        } else {
          html += '<span class="text-slate-400 dark:text-gray-500">' + (char === ' ' ? ' ' : escapeHtml(char)) + '</span>';
        }
      }
      lessonTextDisplay.innerHTML = html;
    }

    function updateVirtualKeyboardHighlight() {
      const allKeys = document.querySelectorAll('.vkey');
      allKeys.forEach(k => k.classList.remove('vkey-active'));

      if (lessonTypedText.length >= lessonTargetText.length) return;

      const nextChar = lessonTargetText[lessonTypedText.length];
      if (!nextChar) return;

      const targetKeyChar = nextChar.toLowerCase();
      const matching = document.querySelector('.vkey[data-key="' + targetKeyChar + '"]');
      if (matching) {
        matching.classList.add('vkey-active');
      }

      // Finger guidance
      let fingerText = 'Index Finger';
      if ('qaz1!'.includes(targetKeyChar)) fingerText = 'Left Pinky';
      else if ('wsx2@'.includes(targetKeyChar)) fingerText = 'Left Ring';
      else if ('edc3#'.includes(targetKeyChar)) fingerText = 'Left Middle';
      else if ('rfvtgb4$5%'.includes(targetKeyChar)) fingerText = 'Left Index';
      else if ('yhnujm6^7&'.includes(targetKeyChar)) fingerText = 'Right Index';
      else if ('ik,8*'.includes(targetKeyChar)) fingerText = 'Right Middle';
      else if ('ol.9('.includes(targetKeyChar)) fingerText = 'Right Ring';
      else if ('p;/0)[]\\\''.includes(targetKeyChar) || targetKeyChar === 'enter') fingerText = 'Right Pinky';
      else if (targetKeyChar === ' ') fingerText = 'Either Thumb';

      if (targetFingerLabel) targetFingerLabel.textContent = 'Target Finger: ' + fingerText;
    }

    if (lessonInput) {
      lessonInput.addEventListener('input', function() {
        const val = lessonInput.value;
        lessonTotalKeys++;

        lessonTypedText = val;
        const target = lessonTargetText;

        if (target.startsWith(val)) {
          sound.playKeyClick();
          if (lessonErrorTag) lessonErrorTag.style.display = 'none';
          lessonInput.classList.remove('border-rose-500');
        } else {
          lessonKeyErrors++;
          sound.playError();
          if (lessonErrorTag) lessonErrorTag.style.display = 'inline';
          lessonInput.classList.add('border-rose-500');
        }

        if (lessonTotalKeys > 0 && lessonHudAcc) {
          const acc = Math.max(0, Math.round(((lessonTotalKeys - lessonKeyErrors) / lessonTotalKeys) * 100));
          lessonHudAcc.textContent = acc + '%';
        }

        renderLessonDisplay();
        updateVirtualKeyboardHighlight();

        if (val === target) {
          sound.playFinishChime(true);
          lessonInput.disabled = true;

          setTimeout(function() {
            if (currentLessonIndex + 1 < LESSONS.length) {
              loadLesson(currentLessonIndex + 1);
            } else {
              alert("🎉 Congratulations! You have completed all 12 Academy Lessons!");
            }
          }, 1200);
        }
      });
    }

    function renderCurriculumGrid() {
      if (!lessonsCurriculumGrid) return;

      lessonsCurriculumGrid.innerHTML = LESSONS.map(function(lesson, idx) {
        const isCurrent = idx === currentLessonIndex;
        return '<div class="p-3.5 rounded-2xl border transition-all cursor-pointer ' + 
          (isCurrent ? 'bg-brand-gold/15 border-brand-gold shadow-sm' : 'bg-white dark:bg-white/5 border-black/[0.05] dark:border-white/[0.08] hover:border-brand-gold/50') + 
          '" onclick="window.__loadLessonFromCard(' + idx + ')">' +
          '<div class="flex items-center justify-between mb-1">' +
            '<span class="text-[10px] font-black uppercase tracking-wider text-brand-gold">' + lesson.level + '</span>' +
            '<span class="text-xs font-bold text-slate-400">Lesson ' + (idx + 1) + '</span>' +
          '</div>' +
          '<h4 class="font-bold text-xs sm:text-sm text-brand-navy dark:text-brand-cream mb-1">' + lesson.title + '</h4>' +
          '<p class="text-[11px] text-brand-slate dark:text-gray-400 line-clamp-1">' + lesson.tip + '</p>' +
        '</div>';
      }).join('');
    }

    window.__loadLessonFromCard = function(idx) {
      loadLesson(idx);
    };

    // ========================================================
    // SECTION 3 ENGINE: 18 GUTENBERG BOOKS DIRECT LIBRARY
    // ========================================================
    const libraryFullGrid = document.getElementById('library-full-grid');
    const libraryDirectSearch = document.getElementById('library-direct-search');

    function renderFullLibrary() {
      if (!libraryFullGrid) return;
      const q = (libraryDirectSearch ? libraryDirectSearch.value : '').toLowerCase().trim();

      const filtered = passages.filter(function(p) {
        return !q || p.title.toLowerCase().includes(q) || p.author.toLowerCase().includes(q);
      });

      libraryFullGrid.innerHTML = filtered.map(function(p) {
        const origIdx = passages.findIndex(item => item.id === p.id);
        const isCurrent = origIdx === currentPassageIndex;

        return '<div class="p-4 rounded-2xl border transition-all flex flex-wrap items-center justify-between gap-3 ' +
          (isCurrent
            ? 'bg-brand-gold/15 border-brand-gold shadow-sm'
            : 'bg-brand-cream/30 dark:bg-white/5 border-black/[0.05] dark:border-white/[0.08] hover:border-brand-gold/50') + '">' +
          '<div class="min-w-0 flex-1">' +
            '<div class="flex items-center gap-2 flex-wrap mb-1">' +
              '<h4 class="font-bold text-sm sm:text-base text-brand-navy dark:text-brand-cream font-serif-literary">' + p.title + '</h4>' +
              '<span class="px-2 py-0.2 rounded-full text-[10px] font-bold bg-white dark:bg-white/10 text-brand-slate dark:text-gray-300">' + p.difficulty + '</span>' +
              (isCurrent ? '<span class="px-2 py-0.2 rounded-full text-[10px] font-black bg-brand-gold text-brand-navy">Current Book</span>' : '') +
            '</div>' +
            '<p class="text-xs text-brand-slate dark:text-gray-400 mb-2">by ' + p.author + ' (' + p.year + ') • ' + p.chapter + '</p>' +
            '<p class="text-xs text-brand-slate dark:text-gray-300 line-clamp-2 italic font-serif-literary">"' + p.text + '"</p>' +
          '</div>' +
          '<div class="flex items-center gap-2">' +
            '<button type="button" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy hover:opacity-90 active:scale-95 transition-all shadow-sm" onclick="window.__selectBookFromLibrary(' + origIdx + ')">' +
              (isCurrent ? 'Racing Now' : 'Race This Book') +
            '</button>' +
            '<a href="' + p.gutenbergUrl + '" target="_blank" rel="noopener noreferrer" class="px-2.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-white/10 text-brand-navy dark:text-brand-cream border border-black/[0.05] dark:border-white/[0.08] hover:text-brand-gold transition-colors inline-flex items-center gap-1" title="Read on Project Gutenberg">' +
              '#' + p.gutenbergId + ' ↗' +
            '</a>' +
          '</div>' +
        '</div>';
      }).join('');
    }

    window.__selectBookFromLibrary = function(origIdx) {
      loadPassage(origIdx);
      switchAppTab('arena');
    };

    if (libraryDirectSearch) {
      libraryDirectSearch.addEventListener('input', renderFullLibrary);
    }

    // --- Initial Boot ---
    updateCareerUI();
    loadPassage(currentPassageIndex);
  </script>
</Layout>
