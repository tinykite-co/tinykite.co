  <!-- TypeRacer Client Application Script - INLINED FOR 100% PORTABILITY -->
  <script is:inline>
    // --- Web Audio API Synth Sound Engine ---
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }

      init() {
        if (!this.ctx && typeof window !== 'undefined') {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) {
            this.ctx = new AudioContextClass();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playKeyClick() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(580, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(320, this.ctx.currentTime + 0.03);
          gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.03);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.03);
        } catch (e) {}
      }

      playReturnClick() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          // Classic carriage return typewriter bell chime
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(1318.51, this.ctx.currentTime); // E6
          gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.25);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.25);
        } catch (e) {}
      }

      playError() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(140, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(90, this.ctx.currentTime + 0.12);
          gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.12);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.12);
        } catch (e) {}
      }

      playFinishChime(isFirstPlace) {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const notes = isFirstPlace 
            ? [523.25, 659.25, 783.99, 1046.50, 1318.51] 
            : [523.25, 659.25, 783.99];
          notes.forEach((freq, idx) => {
            if (!this.ctx) return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.08);
            gain.gain.setValueAtTime(0.14, this.ctx.currentTime + idx * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + idx * 0.08 + 0.35);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(this.ctx.currentTime + idx * 0.08);
            osc.stop(this.ctx.currentTime + idx * 0.08 + 0.35);
          });
        } catch (e) {}
      }
    }

    const sound = new SoundEngine();

    // --- State Variables ---
    const passages = window.__11P_PASSAGES__ || [];
    let currentPassageIndex = Math.floor(Math.random() * passages.length);
    let currentPassage = passages[currentPassageIndex];

    let words = [];
    let currentWordIndex = 0;
    let currentInput = '';
    let isRaceActive = false;
    let isRaceFinished = false;
    let raceStartTime = 0;
    let raceEndTime = 0;
    let totalKeystrokes = 0;
    let errorKeystrokes = 0;
    let hudTimerInterval = null;

    // Mode: 'random' (50% chance), 'always', or 'sprint'
    let followupMode = 'random';
    let currentRaceHasQA = false;

    // Career Stats
    function getCareerStats() {
      try {
        const data = localStorage.getItem('tinykite_typeracer_career_v2');
        if (data) return JSON.parse(data);
      } catch (e) {}
      return { races: 0, victories: 0, bestWpm: 0, totalWpm: 0 };
    }

    function saveCareerStats(stats) {
      try {
        localStorage.setItem('tinykite_typeracer_career_v2', JSON.stringify(stats));
      } catch (e) {}
    }

    function updateCareerUI() {
      const stats = getCareerStats();
      const racesEl = document.getElementById('career-races');
      const vicEl = document.getElementById('career-victories');
      const bestEl = document.getElementById('career-best-wpm');
      const avgEl = document.getElementById('career-avg-wpm');

      if (racesEl) racesEl.textContent = stats.races.toString();
      if (vicEl) vicEl.textContent = (stats.victories || 0).toString();
      if (bestEl) bestEl.textContent = stats.bestWpm + ' WPM';
      if (avgEl) {
        const avg = stats.races > 0 ? Math.round(stats.totalWpm / stats.races) : 0;
        avgEl.textContent = avg + ' WPM';
      }
    }

    // --- 4 RACERS POOL & MULTIPLAYER SETUP ---
    // Racer index 0 is always the local human player (You)
    // Racers 1, 2, 3 can be real peers or simulated bots
    let racers = [
      { id: 'player-you', name: 'You', isPlayer: true, isPeer: false, avatar: '🏎️', progress: 0, currentWpm: 0, rank: null, finishTime: null },
      { id: 'bot-1', name: 'Cadence_Pro', isPlayer: false, isPeer: false, avatar: '🏎️', progress: 0, currentWpm: 0, rank: null, finishTime: null, targetWpm: 55, startDelay: 400, jitter: 1.0 },
      { id: 'bot-2', name: 'Oliver_T', isPlayer: false, isPeer: false, avatar: '🚗', progress: 0, currentWpm: 0, rank: null, finishTime: null, targetWpm: 65, startDelay: 600, jitter: 1.0 },
      { id: 'bot-3', name: 'Jane_Eyre', isPlayer: false, isPeer: false, avatar: '🚕', progress: 0, currentWpm: 0, rank: null, finishTime: null, targetWpm: 42, startDelay: 500, jitter: 1.0 }
    ];

    let rankCounter = 1;
    let botSimulationInterval = null;
    let lobbyCountdownInterval = null;
    let lobbyCountdownSeconds = 5;
    let isLobbyActive = false;

    // Names and Avatars pool for bot randomization
    const BOT_NAMES = [
      'Cadence_Pro', 'Oliver_T', 'Jim_Hawkins', 'Sherlock_H', 'Alice_C',
      'Jane_Eyre', 'Pip_G', 'Captain_Nemo', 'Wendy_D', 'SwiftFox',
      'Huck_Finn', 'Dorothy_G', 'Mole_99', 'Tom_Sawyer', 'BookWorm_11',
      'GutenbergAce', 'TurboTyper', 'Jo_March', 'PixelCadet', 'Rowena_K'
    ];
    const BOT_AVATARS = ['🏎️', '🚗', '🚕', '🚀', '🏎️', '🚙', '🛸'];

    // Human typing speed distribution generator
    // ~15% slow (32-45), ~50% average 11+ (46-68), ~25% fast (69-90), ~10% demon speed (91-115)
    function sampleHumanBotSpeed() {
      const roll = Math.random();
      if (roll < 0.15) {
        return Math.round(32 + Math.random() * 13);
      } else if (roll < 0.65) {
        return Math.round(46 + Math.random() * 22);
      } else if (roll < 0.90) {
        return Math.round(69 + Math.random() * 21);
      } else {
        return Math.round(91 + Math.random() * 24);
      }
    }

    function randomizeBots() {
      const shuffledNames = BOT_NAMES.slice().sort(() => Math.random() - 0.5);
      const shuffledAvatars = BOT_AVATARS.slice().sort(() => Math.random() - 0.5);

      for (let i = 1; i <= 3; i++) {
        if (!racers[i].isPeer) {
          const speed = sampleHumanBotSpeed();
          racers[i].name = shuffledNames[i - 1];
          racers[i].avatar = shuffledAvatars[i - 1];
          racers[i].targetWpm = speed;
          racers[i].progress = 0;
          racers[i].currentWpm = 0;
          racers[i].rank = null;
          racers[i].finishTime = null;
          racers[i].startDelay = Math.round(300 + Math.random() * 550); // human delay
          racers[i].jitter = 1.0;

          // Update lane UI
          const nameEl = document.getElementById('racer-' + i + '-name');
          const avatarEl = document.getElementById('racer-' + i + '-avatar');
          const badgeEl = document.getElementById('racer-' + i + '-badge');
          const wpmEl = document.getElementById('racer-' + i + '-wpm');
          const medalEl = document.getElementById('racer-' + i + '-medal');
          const racerEl = document.getElementById('racer-' + i);

          if (nameEl) nameEl.textContent = racers[i].name;
          if (avatarEl) avatarEl.textContent = racers[i].avatar;
          if (badgeEl) {
            badgeEl.textContent = 'BOT · ' + speed + ' WPM';
            badgeEl.className = 'text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded';
          }
          if (wpmEl) wpmEl.textContent = '0 WPM';
          if (medalEl) medalEl.classList.add('hidden');
          if (racerEl) racerEl.style.left = '0%';
        }
      }
    }

    // --- P2P Networking (BroadcastChannel + WebRTC) ---
    const localRacerId = 'user-' + Math.random().toString(36).substring(2, 9);
    let p2pChannel = null;
    try {
      if (typeof BroadcastChannel !== 'undefined') {
        p2pChannel = new BroadcastChannel('tk_typeracer_p2p_channel');
        p2pChannel.onmessage = function(event) {
          handleP2PMessage(event.data);
        };
      }
    } catch (e) {}

    function handleP2PMessage(data) {
      if (!data || data.senderId === localRacerId) return;

      if (data.type === 'LOBBY_JOIN') {
        // A peer tab has joined!
        assignPeerRacer(data.senderId, data.name || 'Peer Racer', data.avatar || '🏎️');
        if (p2pChannel) {
          p2pChannel.postMessage({
            type: 'LOBBY_ACK',
            senderId: localRacerId,
            name: 'Player 1',
            avatar: '🏎️',
            passageId: currentPassage.id
          });
        }
      } else if (data.type === 'LOBBY_ACK') {
        assignPeerRacer(data.senderId, data.name || 'Peer Racer', data.avatar || '🏎️');
      } else if (data.type === 'RACER_PROGRESS') {
        updatePeerProgress(data.senderId, data.progress, data.wpm, data.rank);
      }
    }

    function assignPeerRacer(peerId, name, avatar) {
      // Find or assign to lane 1 or 2
      let peerSlot = racers.findIndex(r => r.id === peerId);
      if (peerSlot === -1) {
        // pick first non-player slot
        for (let i = 1; i <= 3; i++) {
          if (!racers[i].isPeer) {
            peerSlot = i;
            break;
          }
        }
      }
      if (peerSlot > 0) {
        racers[peerSlot].id = peerId;
        racers[peerSlot].isPeer = true;
        racers[peerSlot].name = name;
        racers[peerSlot].avatar = avatar;

        const nameEl = document.getElementById('racer-' + peerSlot + '-name');
        const avatarEl = document.getElementById('racer-' + peerSlot + '-avatar');
        const badgeEl = document.getElementById('racer-' + peerSlot + '-badge');

        if (nameEl) nameEl.textContent = name;
        if (avatarEl) avatarEl.textContent = avatar;
        if (badgeEl) {
          badgeEl.textContent = 'PEER (LIVE)';
          badgeEl.className = 'text-[8px] font-bold text-emerald-300 bg-emerald-950/80 px-1 rounded animate-pulse';
        }

        const summaryEl = document.getElementById('lobby-racers-summary');
        if (summaryEl) summaryEl.textContent = '• Human Peer Connected! Ready to race';
      }
    }

    function updatePeerProgress(peerId, progress, wpm, rank) {
      const idx = racers.findIndex(r => r.id === peerId);
      if (idx > 0) {
        racers[idx].progress = progress;
        racers[idx].currentWpm = wpm;

        const racerEl = document.getElementById('racer-' + idx);
        const wpmEl = document.getElementById('racer-' + idx + '-wpm');
        const medalEl = document.getElementById('racer-' + idx + '-medal');

        if (racerEl) racerEl.style.left = Math.min(92, progress * 0.92) + '%';
        if (wpmEl) wpmEl.textContent = wpm + ' WPM';

        if (rank && medalEl) {
          medalEl.classList.remove('hidden');
          const medals = { 1: '🥇', 2: '🥈', 3: '🥉', 4: '4th' };
          medalEl.textContent = medals[rank] || '';
        }
      }
    }

    function broadcastMyProgress(progress, wpm, rank) {
      if (p2pChannel) {
        p2pChannel.postMessage({
          type: 'RACER_PROGRESS',
          senderId: localRacerId,
          progress: progress,
          wpm: wpm,
          rank: rank
        });
      }
    }

    // --- DOM Elements ---
    const passageTitle = document.getElementById('passage-title');
    const passageAuthor = document.getElementById('passage-author');
    const passageDifficulty = document.getElementById('passage-difficulty');
    const passageGutenbergId = document.getElementById('passage-gutenberg-id');
    const passageGutenbergLink = document.getElementById('passage-gutenberg-link');
    const passageDisplay = document.getElementById('passage-display');
    const raceModeBadge = document.getElementById('race-mode-badge');
    const typingInput = document.getElementById('typing-input');
    const typingErrorTag = document.getElementById('typing-error-tag');

    const hudWpm = document.getElementById('hud-wpm');
    const hudAccuracy = document.getElementById('hud-accuracy');
    const hudTime = document.getElementById('hud-time');
    const hudProgress = document.getElementById('hud-progress');
    const hudRank = document.getElementById('hud-rank');
    const modeSelect = document.getElementById('mode-select');

    const lobbyBar = document.getElementById('lobby-bar');
    const lobbyTimerNum = document.getElementById('lobby-timer-num');
    const lobbyStatusText = document.getElementById('lobby-status-text');
    const btnStartRaceNow = document.getElementById('btn-start-race-now');
    const btnInviteLink = document.getElementById('btn-invite-link');
    const inviteBtnLabel = document.getElementById('invite-btn-label');

    const btnToggleVocab = document.getElementById('btn-toggle-vocab');
    const vocabDrawer = document.getElementById('vocab-drawer');
    const vocabList = document.getElementById('vocab-list');
    const vocabCount = document.getElementById('vocab-count');

    const typingRaceView = document.getElementById('typing-race-view');
    const qaFollowupView = document.getElementById('qa-followup-view');
    const grandResultsView = document.getElementById('grand-results-view');

    // Q&A Follow-up View Elements
    const qaUserRankBadge = document.getElementById('qa-user-rank-badge');
    const qaFinishWpm = document.getElementById('qa-finish-wpm');
    const qaLine1 = document.getElementById('qa-line-1');
    const qaLine2 = document.getElementById('qa-line-2');
    const qaInput = document.getElementById('qa-input');
    const qaNewlineCue = document.getElementById('qa-newline-cue');
    const qaErrorTag = document.getElementById('qa-error-tag');
    const qaInstructionLabel = document.getElementById('qa-instruction-label');
    const qaContextReveal = document.getElementById('qa-context-reveal');
    const qaContextNoteText = document.getElementById('qa-context-note-text');
    const btnSkipQa = document.getElementById('btn-skip-qa');

    // Grand Results Elements
    const podiumGrid = document.getElementById('podium-grid');
    const finalWpm = document.getElementById('final-wpm');
    const finalAccuracy = document.getElementById('final-accuracy');
    const finalPodiumRank = document.getElementById('final-podium-rank');
    const finalTime = document.getElementById('final-time');
    const resultsVocabGrid = document.getElementById('results-vocab-grid');
    const resultsRankPill = document.getElementById('results-rank-pill');
    const resultsBadgeIcon = document.getElementById('results-badge-icon');
    const resultsGutenbergBtn = document.getElementById('results-gutenberg-btn');
    const btnResultsNext = document.getElementById('btn-results-next');
    const btnResultsRetry = document.getElementById('btn-results-retry');
    const btnShareScore = document.getElementById('btn-share-score');
    const shareBtnText = document.getElementById('share-btn-text');

    const btnOpenLibrary = document.getElementById('btn-open-library');
    const btnCloseLibrary = document.getElementById('btn-close-library');
    const libraryModal = document.getElementById('library-modal');
    const libraryCardsContainer = document.getElementById('library-cards-container');
    const librarySearch = document.getElementById('library-search');
    const libFilterBtns = document.querySelectorAll('.lib-filter-btn');

    const btnToggleSound = document.getElementById('btn-toggle-sound');
    const soundIcon = document.getElementById('sound-icon');
    const soundLabel = document.getElementById('sound-label');
    const btnNextPassage = document.getElementById('btn-next-passage');

    // --- Sound Settings Persistence ---
    const savedSound = localStorage.getItem('tinykite_typeracer_sound');
    if (savedSound === 'off') {
      sound.enabled = false;
      if (soundIcon) soundIcon.textContent = '🔇';
      if (soundLabel) soundLabel.textContent = 'Muted';
    }

    if (btnToggleSound) {
      btnToggleSound.addEventListener('click', () => {
        sound.enabled = !sound.enabled;
        localStorage.setItem('tinykite_typeracer_sound', sound.enabled ? 'on' : 'off');
        if (soundIcon) soundIcon.textContent = sound.enabled ? '🔊' : '🔇';
        if (soundLabel) soundLabel.textContent = sound.enabled ? 'Sound' : 'Muted';
      });
    }

    const btnResetCareer = document.getElementById('btn-reset-career');
    if (btnResetCareer) {
      btnResetCareer.addEventListener('click', () => {
        if (confirm("Reset your 11+ TypeRacer career stats?")) {
          saveCareerStats({ races: 0, victories: 0, bestWpm: 0, totalWpm: 0 });
          updateCareerUI();
        }
      });
    }

    // Mode Selector Handler
    if (modeSelect) {
      modeSelect.addEventListener('change', function() {
        followupMode = modeSelect.value;
        determineQAMode();
      });
    }

    function determineQAMode() {
      if (followupMode === 'always') {
        currentRaceHasQA = true;
      } else if (followupMode === 'sprint') {
        currentRaceHasQA = false;
      } else {
        // Random 50%
        currentRaceHasQA = Math.random() < 0.5;
      }

      if (raceModeBadge) {
        if (currentRaceHasQA) {
          raceModeBadge.textContent = '📖 11+ Context (Passage + Q&A)';
          raceModeBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-brand-gold/20 text-amber-800 dark:text-brand-gold';
        } else {
          raceModeBadge.textContent = '⚡ Speed Sprint (Passage Only)';
          raceModeBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300';
        }
      }
    }

    // --- Load and Initialize Race ---
    function loadPassage(index) {
      currentPassageIndex = index;
      currentPassage = passages[currentPassageIndex];
      words = currentPassage.text.split(' ');
      currentWordIndex = 0;
      currentInput = '';
      isRaceActive = false;
      isRaceFinished = false;
      raceStartTime = 0;
      raceEndTime = 0;
      totalKeystrokes = 0;
      errorKeystrokes = 0;
      rankCounter = 1;

      determineQAMode();

      if (hudTimerInterval) clearInterval(hudTimerInterval);
      if (botSimulationInterval) clearInterval(botSimulationInterval);
      if (lobbyCountdownInterval) clearInterval(lobbyCountdownInterval);

      if (typingRaceView) typingRaceView.style.display = 'block';
      if (qaFollowupView) qaFollowupView.style.display = 'none';
      if (grandResultsView) grandResultsView.style.display = 'none';
      if (vocabDrawer) vocabDrawer.style.display = 'none';
      if (libraryModal) libraryModal.style.display = 'none';

      if (passageTitle) passageTitle.textContent = currentPassage.title;
      if (passageAuthor) passageAuthor.textContent = 'by ' + currentPassage.author + ' (' + currentPassage.year + ') • ' + currentPassage.chapter;
      if (passageDifficulty) {
        passageDifficulty.textContent = currentPassage.difficulty;
        if (currentPassage.difficulty === 'Foundation') {
          passageDifficulty.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
        } else if (currentPassage.difficulty === 'Standard 11+') {
          passageDifficulty.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300';
        } else {
          passageDifficulty.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300';
        }
      }
      if (passageGutenbergId) passageGutenbergId.textContent = currentPassage.gutenbergId.toString();
      if (passageGutenbergLink) passageGutenbergLink.href = currentPassage.gutenbergUrl;

      if (vocabCount) vocabCount.textContent = currentPassage.vocabulary.length.toString();
      if (vocabList) {
        vocabList.innerHTML = currentPassage.vocabulary.map(function(v) {
          return '<div class="p-2 rounded-xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10">' +
            '<span class="font-bold text-brand-navy dark:text-brand-cream">' + v.word + ':</span>' +
            '<span class="text-brand-slate dark:text-gray-300 ml-1">' + v.definition + '</span>' +
            '</div>';
        }).join('');
      }

      // Reset Player State
      racers[0].progress = 0;
      racers[0].currentWpm = 0;
      racers[0].rank = null;
      racers[0].finishTime = null;

      const playerRacerEl = document.getElementById('racer-0');
      const playerWpmEl = document.getElementById('racer-0-wpm');
      const playerMedalEl = document.getElementById('racer-0-medal');
      if (playerRacerEl) playerRacerEl.style.left = '0%';
      if (playerWpmEl) playerWpmEl.textContent = '0 WPM';
      if (playerMedalEl) playerMedalEl.classList.add('hidden');

      // Randomize 3 Bots with human distribution
      randomizeBots();

      if (hudWpm) hudWpm.textContent = '0';
      if (hudAccuracy) hudAccuracy.textContent = '100';
      if (hudTime) hudTime.textContent = '0:00';
      if (hudProgress) hudProgress.textContent = '0';
      if (hudRank) hudRank.textContent = '1st / 4';

      if (typingInput) {
        typingInput.value = '';
        typingInput.disabled = false;
        typingInput.placeholder = "Click here and type to race...";
        typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
        try {
          typingInput.focus({ preventScroll: true });
        } catch (e) {}
      }
      if (typingErrorTag) typingErrorTag.style.display = 'none';

      renderPassageWords();
      startLobbyMatchmaking();

      // Broadcast to other tabs that we loaded this passage
      if (p2pChannel) {
        p2pChannel.postMessage({
          type: 'LOBBY_JOIN',
          senderId: localRacerId,
          name: 'Player',
          avatar: '🏎️',
          passageId: currentPassage.id
        });
      }
    }

    // --- Matchmaking Lobby Countdown ---
    function startLobbyMatchmaking() {
      isLobbyActive = true;
      lobbyCountdownSeconds = 5;
      if (lobbyBar) lobbyBar.style.display = 'flex';
      if (lobbyTimerNum) lobbyTimerNum.textContent = '5';
      if (lobbyStatusText) lobbyStatusText.innerHTML = '🚦 Matchmaking: Waiting for other racers... (<span id="lobby-timer-num">5</span>s)';

      lobbyCountdownInterval = setInterval(function() {
        lobbyCountdownSeconds--;
        const timerEl = document.getElementById('lobby-timer-num');
        if (timerEl) timerEl.textContent = lobbyCountdownSeconds.toString();

        if (lobbyCountdownSeconds <= 0) {
          endLobbyCountdown();
        }
      }, 1000);
    }

    function endLobbyCountdown() {
      if (lobbyCountdownInterval) clearInterval(lobbyCountdownInterval);
      isLobbyActive = false;
      if (lobbyStatusText) lobbyStatusText.innerHTML = '🏁 Race in Progress! Type the text below.';
    }

    if (btnStartRaceNow) {
      btnStartRaceNow.addEventListener('click', function() {
        endLobbyCountdown();
        if (typingInput) {
          try {
            typingInput.focus({ preventScroll: true });
          } catch (e) {}
        }
      });
    }

    if (btnInviteLink) {
      btnInviteLink.addEventListener('click', function() {
        const url = window.location.origin + window.location.pathname + '?room=' + (localRacerId.slice(-4));
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function() {
            if (inviteBtnLabel) inviteBtnLabel.textContent = 'Copied Link!';
            setTimeout(function() {
              if (inviteBtnLabel) inviteBtnLabel.textContent = 'Invite Friend';
            }, 2000);
          });
        }
      });
    }

    // --- Render Passage Letter-by-Letter Display ---
    function renderPassageWords() {
      if (!passageDisplay) return;

      const wordsHtml = words.map(function(word, wIdx) {
        if (wIdx < currentWordIndex) {
          return '<span class="tr-word-done">' + escapeHtml(word) + '</span>';
        } else if (wIdx === currentWordIndex) {
          const target = word;
          const typed = currentInput;
          let charsHtml = '';
          let isError = false;

          for (let i = 0; i < target.length; i++) {
            if (i < typed.length) {
              if (typed[i] === target[i] && !isError) {
                charsHtml += '<span class="tr-char-correct">' + escapeHtml(target[i]) + '</span>';
              } else {
                isError = true;
                charsHtml += '<span class="tr-char-error">' + escapeHtml(target[i]) + '</span>';
              }
            } else {
              charsHtml += '<span class="tr-char-pending">' + escapeHtml(target[i]) + '</span>';
            }
          }

          if (typed.length > target.length) {
            const extra = typed.slice(target.length);
            charsHtml += '<span class="tr-char-error line-through">' + escapeHtml(extra) + '</span>';
          }

          return '<span class="tr-word-current">' + charsHtml + '</span>';
        } else {
          return '<span class="tr-word-upcoming">' + escapeHtml(word) + '</span>';
        }
      }).join(' ');

      passageDisplay.innerHTML = wordsHtml;
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // --- Typing Input Event Handler ---
    if (typingInput) {
      typingInput.addEventListener('keydown', function(e) {
        if (!isRaceActive && !isRaceFinished && e.key.length === 1) {
          startRace();
        }

        if (e.key === ' ' && isRaceActive) {
          const currentTargetWord = words[currentWordIndex];
          const typedVal = typingInput.value.trim();

          if (typedVal === currentTargetWord) {
            e.preventDefault();
            sound.playKeyClick();
            currentWordIndex++;
            currentInput = '';
            typingInput.value = '';
            totalKeystrokes++;

            if (currentWordIndex >= words.length) {
              finishRace();
              return;
            }

            renderPassageWords();
            updateRaceMetrics();
            return;
          }
        }
      });

      typingInput.addEventListener('input', function() {
        if (!isRaceActive && !isRaceFinished) {
          startRace();
        }

        currentInput = typingInput.value;
        const currentTargetWord = words[currentWordIndex] || '';

        totalKeystrokes++;

        const isPrefixMatch = currentTargetWord.startsWith(currentInput);
        if (!isPrefixMatch) {
          errorKeystrokes++;
          sound.playError();
          typingInput.classList.add('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.style.display = 'inline';
        } else {
          sound.playKeyClick();
          typingInput.classList.remove('border-rose-500', 'bg-rose-50/50', 'dark:bg-rose-950/20');
          if (typingErrorTag) typingErrorTag.style.display = 'none';
        }

        if (currentWordIndex === words.length - 1 && currentInput === currentTargetWord) {
          finishRace();
          return;
        }

        renderPassageWords();
        updateRaceMetrics();
      });
    }

    // --- Start Race & Run Bots ---
    function startRace() {
      if (isRaceActive) return;
      isRaceActive = true;
      raceStartTime = Date.now();
      endLobbyCountdown();

      // HUD Timer Interval
      hudTimerInterval = window.setInterval(function() {
        const elapsedSec = Math.floor((Date.now() - raceStartTime) / 1000);
        const mins = Math.floor(elapsedSec / 60);
        const secs = elapsedSec % 60;
        if (hudTime) hudTime.textContent = mins + ':' + secs.toString().padStart(2, '0');
        updateLiveWpm(elapsedSec);
      }, 250);

      // Bot Simulation Interval (every 100ms)
      startBotSimulation();
    }

    function startBotSimulation() {
      const totalChars = currentPassage.text.length;

      botSimulationInterval = window.setInterval(function() {
        if (!isRaceActive && isRaceFinished) return;
        const now = Date.now();
        const elapsedSec = (now - raceStartTime) / 1000;

        for (let i = 1; i <= 3; i++) {
          const bot = racers[i];
          if (bot.isPeer || bot.rank !== null) continue; // skip peers or finished

          // Check start reaction delay
          if (elapsedSec * 1000 < bot.startDelay) continue;

          // Realistic human speed pacing with micro-pauses & bursts
          if (Math.random() < 0.08) {
            bot.jitter = 0.88 + Math.random() * 0.24; // +/- 12% fluctuation
          }

          const effectiveWpm = bot.targetWpm * bot.jitter;
          const charsPerSec = (effectiveWpm * 5) / 60;
          const progressDelta = (charsPerSec * 0.1 / totalChars) * 100;
          bot.progress = Math.min(100, bot.progress + progressDelta);

          // Update Bot Live WPM
          const wordsTyped = (bot.progress / 100) * totalChars / 5;
          const botElapsedMinutes = Math.max(0.05, (now - (raceStartTime + bot.startDelay)) / 60000);
          bot.currentWpm = Math.round(wordsTyped / botElapsedMinutes);

          // Update UI
          const racerEl = document.getElementById('racer-' + i);
          const wpmEl = document.getElementById('racer-' + i + '-wpm');
          if (racerEl) racerEl.style.left = Math.min(92, bot.progress * 0.92) + '%';
          if (wpmEl) wpmEl.textContent = bot.currentWpm + ' WPM';

          // Check if bot finished
          if (bot.progress >= 100 && bot.rank === null) {
            bot.rank = rankCounter++;
            bot.finishTime = now;
            const medalEl = document.getElementById('racer-' + i + '-medal');
            if (medalEl) {
              medalEl.classList.remove('hidden');
              const medals = { 1: '🥇', 2: '🥈', 3: '🥉', 4: '4th' };
              medalEl.textContent = medals[bot.rank] || '';
            }
          }
        }

        updateLiveRank();
      }, 100);
    }

    function updateLiveWpm(elapsedSec) {
      if (elapsedSec <= 0) return;
      let typedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        typedChars += words[i].length + 1;
      }
      typedChars += Math.min(currentInput.length, words[currentWordIndex] ? words[currentWordIndex].length : 0);

      const wordsTyped = typedChars / 5;
      const minutes = elapsedSec / 60;
      const wpm = Math.round(wordsTyped / minutes);

      racers[0].currentWpm = Math.max(0, wpm);
      if (hudWpm) hudWpm.textContent = Math.max(0, wpm).toString();
      const playerWpmPill = document.getElementById('racer-0-wpm');
      if (playerWpmPill) playerWpmPill.textContent = Math.max(0, wpm) + ' WPM';
    }

    function updateRaceMetrics() {
      const totalChars = currentPassage.text.length;
      let completedChars = 0;
      for (let i = 0; i < currentWordIndex; i++) {
        completedChars += words[i].length + 1;
      }
      completedChars += Math.min(currentInput.length, words[currentWordIndex] ? words[currentWordIndex].length : 0);

      const pct = Math.min(100, Math.round((completedChars / totalChars) * 100));
      racers[0].progress = pct;
      if (hudProgress) hudProgress.textContent = pct.toString();

      const playerRacer = document.getElementById('racer-0');
      if (playerRacer) {
        playerRacer.style.left = Math.min(92, (pct / 100) * 92) + '%';
      }

      if (totalKeystrokes > 0 && hudAccuracy) {
        const acc = Math.max(0, Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100));
        hudAccuracy.textContent = acc.toString();
      }

      updateLiveRank();
      broadcastMyProgress(pct, racers[0].currentWpm, racers[0].rank);
    }

    function updateLiveRank() {
      // Calculate current order based on progress
      const sorted = racers.slice().sort((a, b) => b.progress - a.progress);
      const playerPos = sorted.findIndex(r => r.isPlayer) + 1;
      const suffix = { 1: 'st', 2: 'nd', 3: 'rd', 4: 'th' }[playerPos] || 'th';
      if (hudRank) {
        hudRank.textContent = playerPos + suffix + ' / 4';
        if (playerPos === 1) {
          hudRank.className = 'px-2 py-0.5 rounded-md font-black bg-brand-gold text-brand-navy';
        } else if (playerPos === 2) {
          hudRank.className = 'px-2 py-0.5 rounded-md font-black bg-slate-200 text-slate-800';
        } else {
          hudRank.className = 'px-2 py-0.5 rounded-md font-black bg-amber-800/20 text-amber-900 dark:text-amber-300';
        }
      }
    }

    function finishRace() {
      isRaceActive = false;
      isRaceFinished = true;
      raceEndTime = Date.now();

      if (hudTimerInterval) clearInterval(hudTimerInterval);

      racers[0].progress = 100;
      racers[0].rank = rankCounter++;
      racers[0].finishTime = raceEndTime;

      const playerRacer = document.getElementById('racer-0');
      const playerMedal = document.getElementById('racer-0-medal');
      if (playerRacer) playerRacer.style.left = '92%';
      if (playerMedal) {
        playerMedal.classList.remove('hidden');
        const medals = { 1: '🥇', 2: '🥈', 3: '🥉', 4: '4th' };
        playerMedal.textContent = medals[racers[0].rank] || '';
      }

      sound.playFinishChime(racers[0].rank === 1);

      const elapsedSeconds = Math.max(1, (raceEndTime - raceStartTime) / 1000);
      const totalWords = currentPassage.text.length / 5;
      const wpm = Math.round((totalWords / elapsedSeconds) * 60);
      const accuracy = totalKeystrokes > 0 ? Math.round(((totalKeystrokes - errorKeystrokes) / totalKeystrokes) * 100) : 100;
      racers[0].currentWpm = wpm;

      broadcastMyProgress(100, wpm, racers[0].rank);

      // Save Career Record
      const stats = getCareerStats();
      stats.races++;
      stats.totalWpm += wpm;
      if (racers[0].rank === 1) stats.victories = (stats.victories || 0) + 1;
      if (wpm > stats.bestWpm) stats.bestWpm = wpm;
      saveCareerStats(stats);
      updateCareerUI();

      // Check whether this race has Q&A Follow-up or goes straight to Grand Results
      setTimeout(function() {
        if (currentRaceHasQA && currentPassage.qaFollowup) {
          startQAFollowupPhase(wpm, accuracy, racers[0].rank);
        } else {
          showGrandResults(wpm, accuracy, racers[0].rank);
        }
      }, 1000);
    }

    // ============================================
    // PHASE 2: 11+ CONTEXT Q&A TYPING DRILL
    // ============================================
    let qaTargetQ = '';
    let qaTargetA = '';
    let qaStage = 1; // 1 = typing Question, 2 = typing Answer, 3 = finished
    let qaTypedQ = '';
    let qaTypedA = '';

    function startQAFollowupPhase(wpm, acc, rank) {
      if (typingRaceView) typingRaceView.style.display = 'none';
      if (qaFollowupView) qaFollowupView.style.display = 'block';

      const rankLabels = { 1: '1st Place! 🥇', 2: '2nd Place! 🥈', 3: '3rd Place! 🥉', 4: '4th Place' };
      if (qaUserRankBadge) qaUserRankBadge.textContent = rankLabels[rank] || rank + 'th';
      if (qaFinishWpm) qaFinishWpm.textContent = wpm.toString();

      const qa = currentPassage.qaFollowup || {
        question: "What main theme is highlighted in this classic passage?",
        answer: "Character resilience and observation.",
        contextNote: "Authentic 11+ classic literature extract from Project Gutenberg."
      };

      qaTargetQ = 'Q: ' + qa.question;
      qaTargetA = 'A: ' + qa.answer;
      qaStage = 1;
      qaTypedQ = '';
      qaTypedA = '';

      if (qaContextReveal) qaContextReveal.classList.add('hidden');
      if (qaErrorTag) qaErrorTag.style.display = 'none';
      if (qaNewlineCue) {
        qaNewlineCue.textContent = '⌨️ Type Question, then press Enter ↵';
        qaNewlineCue.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-brand-teal/15 text-brand-teal dark:text-emerald-300';
      }
      if (qaInstructionLabel) {
        qaInstructionLabel.innerHTML = 'Type the Question first. When finished, press <strong>Enter ↵</strong> to type the Answer.';
      }

      renderQALines();

      if (qaInput) {
        qaInput.value = '';
        qaInput.disabled = false;
        qaInput.placeholder = "Type: " + qaTargetQ.slice(0, 30) + "...";
        try {
          qaInput.focus({ preventScroll: true });
        } catch (e) {}
      }
    }

    function renderQALines() {
      if (!qaLine1 || !qaLine2) return;

      // Line 1: Question
      let qHtml = '';
      let qError = false;
      for (let i = 0; i < qaTargetQ.length; i++) {
        if (i < qaTypedQ.length) {
          if (qaTypedQ[i] === qaTargetQ[i] && !qError) {
            qHtml += '<span class="text-emerald-600 dark:text-emerald-400 font-bold">' + escapeHtml(qaTargetQ[i]) + '</span>';
          } else {
            qError = true;
            qHtml += '<span class="text-rose-600 bg-rose-100 dark:bg-rose-900/40 font-bold underline">' + escapeHtml(qaTargetQ[i]) + '</span>';
          }
        } else if (i === qaTypedQ.length && qaStage === 1) {
          qHtml += '<span class="bg-amber-300 dark:bg-amber-500/40 text-brand-navy dark:text-brand-cream font-bold underline">' + escapeHtml(qaTargetQ[i]) + '</span>';
        } else {
          qHtml += '<span class="text-slate-400 dark:text-gray-500">' + escapeHtml(qaTargetQ[i]) + '</span>';
        }
      }
      if (qaStage === 1 && qaTypedQ === qaTargetQ) {
        qHtml += ' <span class="px-1.5 py-0.5 rounded bg-brand-gold text-brand-navy font-bold text-xs animate-bounce ml-2">↵ Press Enter</span>';
      }
      qaLine1.innerHTML = qHtml;

      // Line 2: Answer
      let aHtml = '';
      let aError = false;
      for (let i = 0; i < qaTargetA.length; i++) {
        if (qaStage < 2) {
          aHtml += '<span class="text-slate-400 dark:text-gray-600 opacity-60">' + escapeHtml(qaTargetA[i]) + '</span>';
        } else {
          if (i < qaTypedA.length) {
            if (qaTypedA[i] === qaTargetA[i] && !aError) {
              aHtml += '<span class="text-emerald-600 dark:text-emerald-400 font-bold">' + escapeHtml(qaTargetA[i]) + '</span>';
            } else {
              aError = true;
              aHtml += '<span class="text-rose-600 bg-rose-100 dark:bg-rose-900/40 font-bold underline">' + escapeHtml(qaTargetA[i]) + '</span>';
            }
          } else if (i === qaTypedA.length && qaStage === 2) {
            aHtml += '<span class="bg-amber-300 dark:bg-amber-500/40 text-brand-navy dark:text-brand-cream font-bold underline">' + escapeHtml(qaTargetA[i]) + '</span>';
          } else {
            aHtml += '<span class="text-slate-400 dark:text-gray-500">' + escapeHtml(qaTargetA[i]) + '</span>';
          }
        }
      }
      qaLine2.innerHTML = aHtml;
    }

    if (qaInput) {
      qaInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (qaStage === 1 && qaTypedQ === qaTargetQ) {
            sound.playReturnClick();
            qaStage = 2;
            qaInput.value = '';
            qaTypedA = '';
            if (qaNewlineCue) {
              qaNewlineCue.textContent = '↵ Enter registered! Now type the Answer:';
              qaNewlineCue.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300';
            }
            if (qaInstructionLabel) {
              qaInstructionLabel.innerHTML = 'Now type the Answer line.';
            }
            qaInput.placeholder = "Type: " + qaTargetA.slice(0, 30) + "...";
            renderQALines();
            return;
          }
        }
      });

      qaInput.addEventListener('input', function() {
        const val = qaInput.value;

        if (qaStage === 1) {
          qaTypedQ = val;
          const target = qaTargetQ;
          if (target.startsWith(val)) {
            sound.playKeyClick();
            if (qaErrorTag) qaErrorTag.style.display = 'none';
            qaInput.classList.remove('border-rose-500');
          } else {
            sound.playError();
            if (qaErrorTag) qaErrorTag.style.display = 'inline';
            qaInput.classList.add('border-rose-500');
          }

          if (val === target) {
            if (qaNewlineCue) {
              qaNewlineCue.textContent = '↵ Great! Press Enter to move to Line 2';
              qaNewlineCue.className = 'text-xs font-black px-2 py-0.5 rounded-full bg-brand-gold text-brand-navy animate-pulse';
            }
          }
          renderQALines();
        } else if (qaStage === 2) {
          qaTypedA = val;
          const target = qaTargetA;
          if (target.startsWith(val)) {
            sound.playKeyClick();
            if (qaErrorTag) qaErrorTag.style.display = 'none';
            qaInput.classList.remove('border-rose-500');
          } else {
            sound.playError();
            if (qaErrorTag) qaErrorTag.style.display = 'inline';
            qaInput.classList.add('border-rose-500');
          }

          renderQALines();

          if (val === target) {
            qaStage = 3;
            sound.playFinishChime(true);
            qaInput.disabled = true;

            const qa = currentPassage.qaFollowup;
            if (qaContextReveal && qaContextNoteText && qa) {
              qaContextNoteText.textContent = qa.contextNote;
              qaContextReveal.classList.remove('hidden');
            }

            if (qaNewlineCue) {
              qaNewlineCue.textContent = '✓ 11+ Context Complete!';
              qaNewlineCue.className = 'text-xs font-black px-2 py-0.5 rounded-full bg-emerald-500 text-white';
            }

            setTimeout(function() {
              showGrandResults(racers[0].currentWpm, 100, racers[0].rank);
            }, 1800);
          }
        }
      });
    }

    if (btnSkipQa) {
      btnSkipQa.addEventListener('click', function() {
        showGrandResults(racers[0].currentWpm, 100, racers[0].rank);
      });
    }

    // ============================================
    // PHASE 3: 4-RACER PODIUM & GRAND RESULTS
    // ============================================
    function showGrandResults(wpm, acc, rank) {
      if (typingRaceView) typingRaceView.style.display = 'none';
      if (qaFollowupView) qaFollowupView.style.display = 'none';
      if (grandResultsView) grandResultsView.style.display = 'block';

      const totalElapsedSec = Math.round((Date.now() - raceStartTime) / 1000);

      if (finalWpm) finalWpm.textContent = wpm.toString();
      if (finalAccuracy) finalAccuracy.textContent = acc.toString();
      if (finalPodiumRank) {
        const labels = { 1: '1st', 2: '2nd', 3: '3rd', 4: '4th' };
        finalPodiumRank.textContent = labels[rank] || rank.toString();
      }
      if (finalTime) finalTime.textContent = totalElapsedSec + 's';

      let rankTitle = '🥉 11+ Race Contender';
      let rankIcon = '🎖️';
      if (rank === 1) {
        rankTitle = '🏆 1st Place Champion!';
        rankIcon = '🏆';
      } else if (rank === 2) {
        rankTitle = '🥈 2nd Place Podium Finisher';
        rankIcon = '🥈';
      } else if (rank === 3) {
        rankTitle = '🥉 3rd Place Bronze Finish';
        rankIcon = '🥉';
      }

      if (resultsRankPill) resultsRankPill.textContent = rankTitle;
      if (resultsBadgeIcon) resultsBadgeIcon.textContent = rankIcon;

      // Populate 4-Racer Podium Board
      if (podiumGrid) {
        // Sort racers by rank or progress
        const sorted = racers.slice().sort(function(a, b) {
          if (a.rank && b.rank) return a.rank - b.rank;
          if (a.rank) return -1;
          if (b.rank) return 1;
          return b.progress - a.progress;
        });

        podiumGrid.innerHTML = sorted.map(function(racer, index) {
          const pos = index + 1;
          const medals = { 1: '🥇 1st', 2: '🥈 2nd', 3: '🥉 3rd', 4: '4th' };
          const isYou = racer.isPlayer;

          return '<div class="flex items-center justify-between p-2 rounded-xl ' + 
            (isYou ? 'bg-brand-gold/20 border border-brand-gold font-bold' : 'bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10') + 
            ' text-xs">' +
            '<div class="flex items-center gap-2">' +
              '<span class="font-black w-12 text-brand-navy dark:text-brand-cream">' + (medals[pos] || pos + 'th') + '</span>' +
              '<span class="text-base">' + racer.avatar + '</span>' +
              '<span class="font-bold text-brand-navy dark:text-brand-cream">' + racer.name + (isYou ? ' (You)' : '') + '</span>' +
              '<span class="text-[9px] px-1 rounded ' + (isYou ? 'bg-brand-gold text-brand-navy' : (racer.isPeer ? 'bg-emerald-500/20 text-emerald-600' : 'bg-slate-200 dark:bg-white/10 text-slate-600 dark:text-gray-300')) + '">' + (isYou ? 'YOU' : (racer.isPeer ? 'PEER' : 'BOT')) + '</span>' +
            '</div>' +
            '<div class="flex items-center gap-3">' +
              '<span class="text-brand-slate dark:text-gray-400 font-semibold">' + (racer.currentWpm || racer.targetWpm || wpm) + ' WPM</span>' +
              '<span class="text-emerald-600 dark:text-emerald-400 font-black">' + (pos === 1 ? 'WINNER' : 'Finished') + '</span>' +
            '</div>' +
          '</div>';
        }).join('');
      }

      if (resultsVocabGrid) {
        resultsVocabGrid.innerHTML = currentPassage.vocabulary.map(function(v) {
          return '<div class="p-2.5 rounded-xl bg-white dark:bg-white/5 border border-brand-mist dark:border-white/10">' +
            '<span class="font-bold text-brand-navy dark:text-brand-cream block text-xs uppercase tracking-wider mb-0.5">' + v.word + '</span>' +
            '<span class="text-xs text-brand-slate dark:text-gray-300 leading-snug">' + v.definition + '</span>' +
            '</div>';
        }).join('');
      }

      if (resultsGutenbergBtn) {
        resultsGutenbergBtn.href = currentPassage.gutenbergUrl;
      }
    }

    // --- Action Button Handlers ---
    function nextFn() {
      let nextIdx = Math.floor(Math.random() * passages.length);
      if (nextIdx === currentPassageIndex && passages.length > 1) {
        nextIdx = (nextIdx + 1) % passages.length;
      }
      loadPassage(nextIdx);
    }

    if (btnResultsNext) btnResultsNext.addEventListener('click', nextFn);
    if (btnNextPassage) btnNextPassage.addEventListener('click', nextFn);

    if (btnResultsRetry) {
      btnResultsRetry.addEventListener('click', function() {
        loadPassage(currentPassageIndex);
      });
    }

    if (btnShareScore) {
      btnShareScore.addEventListener('click', function() {
        const text = '🏁 TinyKite 11+ TypeRacer\n📖 Book: ' + currentPassage.title + ' (' + currentPassage.author + ')\n🏆 Finish: ' + (racers[0].rank || 1) + 'st Place / 4 Racers\n⚡ Speed: ' + racers[0].currentWpm + ' WPM\nTry it 100% ad-free: https://tinykite.co/typeracer';
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text).then(function() {
            if (shareBtnText) shareBtnText.textContent = 'Copied to Clipboard!';
            setTimeout(function() {
              if (shareBtnText) shareBtnText.textContent = 'Share Score';
            }, 2000);
          });
        }
      });
    }

    // Vocabulary Drawer Toggle
    if (btnToggleVocab && vocabDrawer) {
      btnToggleVocab.addEventListener('click', function() {
        const isHidden = vocabDrawer.style.display === 'none' || !vocabDrawer.style.display;
        vocabDrawer.style.display = isHidden ? 'block' : 'none';
      });
    }

    // --- Library Modal Logic ---
    function renderLibrary(filter) {
      filter = filter || 'all';
      if (!libraryCardsContainer) return;

      const q = (librarySearch ? librarySearch.value : '').toLowerCase().trim();

      const filtered = passages.filter(function(p) {
        const matchesFilter = filter === 'all' || p.difficulty === filter;
        const matchesQuery = !q || p.title.toLowerCase().includes(q) || p.author.toLowerCase().includes(q);
        return matchesFilter && matchesQuery;
      });

      libraryCardsContainer.innerHTML = filtered.map(function(p) {
        const origIdx = passages.findIndex(item => item.id === p.id);
        const isCurrent = origIdx === currentPassageIndex;

        return '<div class="p-3.5 rounded-2xl border transition-all flex flex-wrap items-center justify-between gap-3 ' +
          (isCurrent
            ? 'bg-brand-gold/15 border-brand-gold shadow-sm'
            : 'bg-brand-cream/40 dark:bg-white/5 border-brand-mist dark:border-white/10 hover:border-brand-gold/50') + '">' +
          '<div class="min-w-0 flex-1">' +
            '<div class="flex items-center gap-2 flex-wrap mb-1">' +
              '<h4 class="font-bold text-sm text-brand-navy dark:text-brand-cream">' + p.title + '</h4>' +
              '<span class="px-2 py-0.2 rounded-full text-[10px] font-bold bg-white dark:bg-white/10 text-brand-slate dark:text-gray-300">' + p.difficulty + '</span>' +
              (isCurrent ? '<span class="px-2 py-0.2 rounded-full text-[10px] font-black bg-brand-gold text-brand-navy">Current Book</span>' : '') +
            '</div>' +
            '<p class="text-xs text-brand-slate dark:text-gray-400 mb-1.5">by ' + p.author + ' (' + p.year + ') • ' + p.chapter + '</p>' +
            '<p class="text-xs text-brand-slate dark:text-gray-300 line-clamp-2 italic">"' + p.text + '"</p>' +
          '</div>' +
          '<div class="flex items-center gap-2">' +
            '<button type="button" class="btn-select-book px-3 py-1.5 rounded-xl text-xs font-bold bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy hover:opacity-90 active:scale-95 transition-all shadow-sm" data-index="' + origIdx + '">' +
              (isCurrent ? 'Racing Now' : 'Race Book') +
            '</button>' +
          '</div>' +
        '</div>';
      }).join('');

      const selectBtns = libraryCardsContainer.querySelectorAll('.btn-select-book');
      selectBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
          loadPassage(idx);
          if (libraryModal) libraryModal.style.display = 'none';
        });
      });
    }

    if (btnOpenLibrary && libraryModal) {
      btnOpenLibrary.addEventListener('click', function() {
        libraryModal.style.display = 'flex';
        renderLibrary('all');
      });
    }

    if (btnCloseLibrary && libraryModal) {
      btnCloseLibrary.addEventListener('click', function() {
        libraryModal.style.display = 'none';
      });
    }

    if (libraryModal) {
      libraryModal.addEventListener('click', function(e) {
        if (e.target === libraryModal) {
          libraryModal.style.display = 'none';
        }
      });
    }

    if (librarySearch) {
      librarySearch.addEventListener('input', function() {
        renderLibrary(window.__currentLibFilter || 'all');
      });
    }

    libFilterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        libFilterBtns.forEach(b => {
          b.className = 'lib-filter-btn px-2 py-1 rounded-lg font-semibold bg-brand-cream dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20';
        });
        btn.className = 'lib-filter-btn px-2 py-1 rounded-lg font-bold bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy';
        const filter = btn.getAttribute('data-filter') || 'all';
        window.__currentLibFilter = filter;
        renderLibrary(filter);
      });
    });

    // --- Initial Boot ---
    updateCareerUI();
    loadPassage(currentPassageIndex);
  </script>
</Layout>
