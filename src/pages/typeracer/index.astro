---
import Layout from '../../layouts/Layout.astro';
import { PASSAGES } from '../../data/typeracer/passages';

const pageTitle = "11+ TypeRacer & Typing Academy | Project Gutenberg Literature | TinyKite";
const pageDescription = "100% ad-free TypeRacer and Free Typing Academy built for 11+ English preparation. Race against live peers and dynamic bots on classic literature, master newline Q&A drills, and learn touch typing.";

const initialPassage = PASSAGES[0];
const initialWords = initialPassage.text.split(' ');
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Import Lora font for exquisite literary typography matching Gloss and Nesta -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />

  <style is:inline>
    .tk-typeracer-root {
      font-family: 'Satoshi', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .font-serif-literary {
      font-family: 'Lora', Georgia, serif;
    }
    #tab-arena-view,
    #tab-lessons-view,
    #tab-library-view {
      transition: opacity 0.2s ease-in-out;
    }
    #qa-followup-view,
    #grand-results-view,
    #library-modal,
    #vocab-drawer,
    #typing-error-tag,
    #qa-error-tag,
    #lesson-error-tag {
      display: none;
    }
    .tr-circuit-track {
      background: radial-gradient(ellipse at 50% 0%, #151d33 0%, #0a0e1a 100%);
      position: relative;
      border-radius: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.6), 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    .tr-finish-line {
      position: absolute;
      right: 24px;
      top: 0;
      bottom: 0;
      width: 14px;
      background: repeating-conic-gradient(#ffffff 0 90deg, #111827 0 180deg) 0 0/8px 8px;
      opacity: 0.85;
      z-index: 2;
      border-left: 1px solid rgba(255, 255, 255, 0.4);
      border-right: 1px solid rgba(255, 255, 255, 0.4);
    }
    .tr-word-done {
      color: #059669;
      font-weight: 500;
    }
    .dark .tr-word-done {
      color: #34d399;
    }
    .tr-word-current {
      background: rgba(255, 178, 60, 0.16);
      border-radius: 6px;
      padding: 0 5px;
      box-shadow: 0 0 0 1.5px rgba(255, 178, 60, 0.45);
    }
    .tr-char-correct {
      color: #059669;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: #059669;
      text-decoration-thickness: 2px;
    }
    .dark .tr-char-correct {
      color: #34d399;
      text-decoration-color: #34d399;
    }
    .tr-char-error {
      background-color: rgba(244, 63, 94, 0.22);
      color: #e11d48;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: #e11d48;
      text-decoration-thickness: 2px;
      border-radius: 2px;
    }
    .tr-char-pending {
      color: inherit;
    }
    .tr-word-upcoming {
      color: #64748b;
    }
    .dark .tr-word-upcoming {
      color: #94a3b8;
    }
    .tr-racer-car {
      transition: left 0.12s linear;
    }
    /* Virtual Keyboard Visual Styling */
    .vkey {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      font-weight: 700;
      font-size: 11px;
      transition: all 0.1s ease;
      user-select: none;
      box-shadow: 0 2px 0 rgba(0, 0, 0, 0.15);
    }
    .vkey-active {
      background: #ffb23c !important;
      color: #0b1020 !important;
      transform: translateY(2px);
      box-shadow: 0 0 12px rgba(255, 178, 60, 0.8) !important;
    }
  </style>

  <main class="tk-typeracer-root min-h-screen bg-brand-cream dark:bg-brand-navy pt-6 pb-20 transition-colors duration-300 relative overflow-hidden">
    <!-- Ambient glow gradients inspired by Gloss and Nesta -->
    <div class="absolute top-0 inset-x-0 h-96 bg-gradient-to-b from-brand-gold/[0.07] via-brand-teal/[0.03] to-transparent pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">

      <!-- HERO / BRAND INTRO (Matches Nesta & Gloss Class) -->
      <header class="text-center mb-6 pt-2">
        <p class="text-brand-gold font-bold tracking-widest uppercase text-[11px] mb-2 flex items-center justify-center gap-1.5">
          <span>✨</span> Project Gutenberg 11+ Classic Literature & Academy
        </p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-brand-navy dark:text-brand-cream mb-2.5 font-serif-literary">
          typeracer<span class="text-brand-gold">.</span>
        </h1>
        <p class="text-sm md:text-base text-brand-slate dark:text-gray-400 max-w-xl mx-auto leading-relaxed">
          The 100% ad-free typing arena and academy. Speed-type authentic classic literature extracts, race against live peers or dynamic AI bots, and master 11+ vocabulary and newlines.
        </p>

        <!-- TOP APP NAVIGATION TABS (Arena vs Free Academy vs Library) -->
        <div class="flex justify-center mt-4">
          <div role="tablist" class="inline-flex rounded-full border border-black/[0.08] dark:border-white/[0.1] p-1 bg-white/80 dark:bg-brand-navy-light/80 backdrop-blur-md shadow-sm">
            <button
              id="tab-btn-arena"
              type="button"
              class="px-5 py-2 rounded-full text-xs font-bold transition-all bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy shadow-sm"
            >
              🏁 Race Arena
            </button>
            <button
              id="tab-btn-lessons"
              type="button"
              class="px-5 py-2 rounded-full text-xs font-bold transition-all text-brand-slate dark:text-gray-300 hover:text-brand-navy dark:hover:text-white"
            >
              ⌨️ Free Typing Academy
            </button>
            <button
              id="tab-btn-library"
              type="button"
              class="px-5 py-2 rounded-full text-xs font-bold transition-all text-brand-slate dark:text-gray-300 hover:text-brand-navy dark:hover:text-white"
            >
              📚 18 Classic Books
            </button>
          </div>
        </div>
      </header>

      <!-- ======================================================== -->
      <!-- SECTION 1: LIVE RACE ARENA                               -->
      <!-- ======================================================== -->
      <section id="tab-arena-view">

        <!-- Unified Arena Card -->
        <div class="bg-white/90 dark:bg-brand-navy-light/90 backdrop-blur-xl border border-black/[0.06] dark:border-white/[0.08] rounded-3xl p-5 sm:p-7 shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative">

          <!-- Book Header Strip -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/[0.06] dark:border-white/[0.08] pb-3.5 mb-4">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-3xl shrink-0 filter drop-shadow">📖</span>
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-0.5">
                  <h2 id="passage-title" class="text-lg font-bold text-brand-navy dark:text-brand-cream font-serif-literary truncate">
                    {initialPassage.title}
                  </h2>
                  <span id="passage-difficulty" class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                    {initialPassage.difficulty}
                  </span>
                  <span id="race-mode-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-brand-gold/20 text-amber-900 dark:text-brand-gold">
                    📖 11+ Context (Passage + Q&A)
                  </span>
                </div>
                <p id="passage-author" class="text-xs text-brand-slate dark:text-gray-400 truncate">
                  by {initialPassage.author} ({initialPassage.year}) • {initialPassage.chapter}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button id="btn-toggle-vocab" type="button" class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-brand-cream/80 dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-colors flex items-center gap-1.5 border border-black/[0.04] dark:border-white/[0.06]">
                <span>💡</span> Vocab (<span id="vocab-count">{initialPassage.vocabulary.length}</span>)
              </button>
              <button id="btn-next-passage" type="button" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-brand-navy dark:bg-brand-gold text-brand-cream dark:text-brand-navy hover:opacity-90 active:scale-95 transition-all flex items-center gap-1 shadow-sm">
                <span>🎲 Next Book</span>
              </button>
              <a id="passage-gutenberg-link" href={initialPassage.gutenbergUrl} target="_blank" rel="noopener noreferrer" class="px-2.5 py-1.5 text-xs font-semibold rounded-xl bg-brand-cream/80 dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:text-brand-gold transition-colors inline-flex items-center gap-1 border border-black/[0.04] dark:border-white/[0.06]" title="Read on Project Gutenberg">
                <span>#{initialPassage.gutenbergId}</span> ↗
              </a>
            </div>
          </div>

          <!-- Vocabulary Drawer -->
          <div id="vocab-drawer" class="mb-4 bg-brand-cream/60 dark:bg-white/5 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-3.5 text-xs">
            <h4 class="font-bold text-brand-navy dark:text-brand-cream mb-2 flex items-center gap-1.5 font-serif-literary">
              <span>✨</span> 11+ Classical Vocabulary in this Passage:
            </h4>
            <div id="vocab-list" class="grid sm:grid-cols-3 gap-2">
              {initialPassage.vocabulary.map(v => (
                <div class="p-2.5 rounded-xl bg-white dark:bg-white/5 border border-black/[0.04] dark:border-white/[0.06]">
                  <span class="font-bold text-brand-navy dark:text-brand-cream">{v.word}:</span>
                  <span class="text-brand-slate dark:text-gray-300 ml-1 leading-relaxed">{v.definition}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- ============================================ -->
          <!-- PHASE 1: 4-LANE CIRCUIT RACING               -->
          <!-- ============================================ -->
          <div id="typing-race-view">

            <!-- Matchmaking Lobby Strip -->
            <div id="lobby-bar" class="mb-3 px-3.5 py-2 rounded-2xl bg-brand-cream/60 dark:bg-white/5 border border-black/[0.05] dark:border-white/[0.08] flex flex-wrap items-center justify-between gap-2.5 text-xs">
              <div class="flex items-center gap-2.5">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="lobby-status-text" class="font-bold text-brand-navy dark:text-brand-cream">
                  Matchmaking: Waiting for other racers... (<span id="lobby-timer-num">5</span>s)
                </span>
                <span id="lobby-racers-summary" class="hidden sm:inline text-brand-slate dark:text-gray-400">
                  • 1 Player (You) + 3 Bots ready
                </span>
              </div>
              <div class="flex items-center gap-2">
                <button id="btn-start-race-now" type="button" class="px-3 py-1 rounded-xl text-xs font-black bg-brand-gold text-brand-navy hover:opacity-90 active:scale-95 transition-all shadow-sm">
                  ⚡ Start Race Now
                </button>
                <button id="btn-invite-link" type="button" class="px-2.5 py-1 rounded-xl text-xs font-semibold bg-white dark:bg-white/10 text-brand-navy dark:text-brand-cream hover:bg-brand-gold/20 transition-all border border-black/[0.05] dark:border-white/[0.08] flex items-center gap-1">
                  <span>🔗</span> <span id="invite-btn-label">Invite Friend</span>
                </button>
              </div>
            </div>

            <!-- 4-Lane Track Circuit -->
            <div class="tr-circuit-track p-3 space-y-2 overflow-hidden mb-4">
              <div class="tr-finish-line"></div>

              <!-- LANE 0: YOU (Player) -->
              <div class="relative flex items-center h-8 z-10 bg-brand-gold/[0.04] rounded-lg px-1 border-l-2 border-brand-gold">
                <div class="absolute inset-x-0 h-0.5 bg-amber-400/20 rounded-full"></div>
                <div id="racer-0" class="tr-racer-car absolute left-0 flex items-center gap-1.5 select-none" style="left: 0%;">
                  <span class="text-xl filter drop-shadow">🏎️</span>
                  <span id="racer-0-wpm" class="text-[10px] font-black px-1.5 py-0.5 rounded-full bg-brand-gold text-brand-navy whitespace-nowrap shadow-sm font-mono">
                    0 WPM
                  </span>
                  <span class="text-[9px] font-bold text-white bg-amber-600/90 px-1 py-0.2 rounded">You</span>
                  <span id="racer-0-medal" class="hidden text-sm">🥇</span>
                </div>
              </div>

              <!-- LANE 1: RACER 2 -->
              <div class="relative flex items-center h-7 z-10 border-t border-dashed border-white/[0.08] pt-1">
                <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
                <div id="racer-1" class="tr-racer-car absolute left-0 flex items-center gap-1.5 select-none" style="left: 0%;">
                  <span id="racer-1-avatar" class="text-lg filter drop-shadow">🏎️</span>
                  <span id="racer-1-wpm" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1.5 py-0.2 rounded font-mono whitespace-nowrap">
                    0 WPM
                  </span>
                  <span id="racer-1-name" class="text-[9px] font-medium text-slate-400 bg-black/40 px-1 py-0.2 rounded truncate max-w-[90px]">
                    Cadence_Pro
                  </span>
                  <span id="racer-1-badge" class="text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded">BOT</span>
                  <span id="racer-1-medal" class="hidden text-sm">🥈</span>
                </div>
              </div>

              <!-- LANE 2: RACER 3 -->
              <div class="relative flex items-center h-7 z-10 border-t border-dashed border-white/[0.08] pt-1">
                <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
                <div id="racer-2" class="tr-racer-car absolute left-0 flex items-center gap-1.5 select-none" style="left: 0%;">
                  <span id="racer-2-avatar" class="text-lg filter drop-shadow">🚗</span>
                  <span id="racer-2-wpm" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1.5 py-0.2 rounded font-mono whitespace-nowrap">
                    0 WPM
                  </span>
                  <span id="racer-2-name" class="text-[9px] font-medium text-slate-400 bg-black/40 px-1 py-0.2 rounded truncate max-w-[90px]">
                    Oliver_T
                  </span>
                  <span id="racer-2-badge" class="text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded">BOT</span>
                  <span id="racer-2-medal" class="hidden text-sm">🥉</span>
                </div>
              </div>

              <!-- LANE 3: RACER 4 -->
              <div class="relative flex items-center h-7 z-10 border-t border-dashed border-white/[0.08] pt-1">
                <div class="absolute inset-x-0 h-0.5 bg-white/10 rounded-full"></div>
                <div id="racer-3" class="tr-racer-car absolute left-0 flex items-center gap-1.5 select-none" style="left: 0%;">
                  <span id="racer-3-avatar" class="text-lg filter drop-shadow">🚕</span>
                  <span id="racer-3-wpm" class="text-[9px] font-semibold text-slate-300 bg-slate-800/90 px-1.5 py-0.2 rounded font-mono whitespace-nowrap">
                    0 WPM
                  </span>
                  <span id="racer-3-name" class="text-[9px] font-medium text-slate-400 bg-black/40 px-1 py-0.2 rounded truncate max-w-[90px]">
                    Jane_Eyre
                  </span>
                  <span id="racer-3-badge" class="text-[8px] font-bold text-cyan-300 bg-cyan-950/80 px-1 rounded">BOT</span>
                  <span id="racer-3-medal" class="hidden text-sm"></span>
                </div>
              </div>

            </div>

            <!-- Live HUD Statistics Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 bg-brand-cream/60 dark:bg-white/[0.04] border border-black/[0.05] dark:border-white/[0.08] rounded-2xl text-xs font-semibold mb-4">
              <div class="flex items-center gap-3 sm:gap-5 flex-wrap">
                <div class="flex items-center gap-1.5">
                  <span class="text-brand-slate dark:text-gray-400 text-[11px] uppercase tracking-wider font-bold">Rank:</span>
                  <span id="hud-rank" class="px-2.5 py-0.5 rounded-lg font-black bg-brand-gold text-brand-navy shadow-sm">
                    1st / 4
                  </span>
                </div>
                <div>Speed: <strong id="hud-wpm" class="text-base font-black text-brand-navy dark:text-brand-cream font-mono">0</strong> WPM</div>
                <div>Accuracy: <strong id="hud-accuracy" class="text-base font-black text-emerald-600 dark:text-emerald-400 font-mono">100</strong>%</div>
                <div>Time: <strong id="hud-time" class="text-base font-black text-brand-navy dark:text-brand-cream font-mono">0:00</strong></div>
              </div>
              <div class="flex items-center gap-3 flex-wrap">
                <div class="flex items-center gap-1.5">
                  <span class="text-brand-slate dark:text-gray-400 text-[11px]">Race Drill:</span>
                  <select id="mode-select" class="bg-transparent font-bold text-brand-navy dark:text-brand-gold cursor-pointer text-xs focus:outline-none">
                    <option value="random" selected>🎲 Random Q&A (50%)</option>
                    <option value="always">📖 Always with Q&A</option>
                    <option value="sprint">⚡ Speed Sprint Only</option>
                  </select>
                </div>
                <div>Progress: <strong id="hud-progress" class="text-base font-black text-brand-gold font-mono">0</strong>%</div>
              </div>
            </div>

            <!-- Literary Passage Reading Text Display (Set in Lora Serif) -->
            <div id="passage-display" class="p-5 sm:p-6 bg-brand-cream/40 dark:bg-white/[0.02] border border-black/[0.05] dark:border-white/[0.08] rounded-2xl font-serif-literary text-lg sm:text-xl leading-relaxed tracking-wide select-none mb-4 min-h-[105px]">
              {initialWords.map((word, idx) => (
                idx === 0 ? (
                  <span class="tr-word-current"><span class="tr-char-pending">{word}</span></span>
                ) : (
                  <span class="tr-word-upcoming"> {word}</span>
                )
              ))}
            </div>

            <!-- Typing Input Field -->
            <div class="relative">
              <input
                id="typing-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Click here and type to race..."
                class="w-full px-5 py-3.5 text-base sm:text-lg rounded-2xl bg-white dark:bg-brand-navy border-2 border-brand-mist dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all shadow-inner"
              />
              <div class="mt-2 flex items-center justify-between text-xs text-brand-slate dark:text-gray-400 px-1">
                <span>💡 Press <kbd class="px-1.5 py-0.5 rounded bg-brand-cream dark:bg-white/10 font-mono text-[10px] border border-black/[0.08] dark:border-white/10">Space</kbd> after each word. Race starts on your first keypress.</span>
                <span id="typing-error-tag" class="text-rose-500 font-bold">Incorrect letter! Press Backspace.</span>
              </div>
            </div>

          </div>

          <!-- ============================================ -->
          <!-- PHASE 2: 11+ CONTEXT Q&A TYPING FOLLOW-UP    -->
          <!-- ============================================ -->
          <div id="qa-followup-view">
            <div class="mb-4 bg-brand-gold/15 border border-brand-gold/40 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="text-3xl">📖</span>
                <div>
                  <h3 class="font-bold text-sm text-brand-navy dark:text-brand-cream flex items-center gap-2">
                    <span>Passage Finished in <span id="qa-user-rank-badge" class="px-2 py-0.5 rounded-lg bg-brand-gold text-brand-navy font-black text-xs">1st Place!</span></span>
                    <span class="text-xs text-brand-slate dark:text-gray-400 font-normal">(Speed: <strong id="qa-finish-wpm" class="text-emerald-600 dark:text-emerald-400 font-mono">0</strong> WPM)</span>
                  </h3>
                  <p class="text-xs text-brand-slate dark:text-gray-400">
                    Follow-Up Context Drill: Type the Question & Answer to practice newlines (Enter ↵) and dialogue punctuation.
                  </p>
                </div>
              </div>
              <button id="btn-skip-qa" type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white dark:bg-white/10 border border-black/[0.08] dark:border-white/20 text-brand-navy dark:text-brand-cream hover:bg-brand-cream/60 dark:hover:bg-white/20 transition-all flex items-center gap-1 shadow-sm">
                <span>Skip to Results ➔</span>
              </button>
            </div>

            <!-- Q&A Typing Card -->
            <div class="bg-white dark:bg-brand-navy border-2 border-brand-gold/70 rounded-2xl p-5 sm:p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-black uppercase tracking-wider text-brand-gold flex items-center gap-1.5">
                  <span>✨</span> 11+ Literary Context & Formatting Drill
                </span>
                <span id="qa-newline-cue" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-brand-teal/15 text-brand-teal dark:text-emerald-300">
                  ⌨️ Type Question, then press Enter ↵
                </span>
              </div>

              <!-- Q&A Target Text Display -->
              <div id="qa-display-box" class="p-5 bg-brand-cream/40 dark:bg-white/[0.03] border border-black/[0.05] dark:border-white/[0.08] rounded-2xl text-base sm:text-lg leading-relaxed select-none mb-4 font-serif-literary">
                <div id="qa-line-1" class="mb-3"></div>
                <div id="qa-line-2"></div>
              </div>

              <!-- Q&A Typing Input -->
              <div class="relative">
                <input
                  id="qa-input"
                  type="text"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder="Type the question above and press Enter..."
                  class="w-full px-5 py-3 text-base rounded-xl bg-brand-cream/30 dark:bg-brand-navy-light border border-black/[0.08] dark:border-white/20 text-brand-navy dark:text-brand-cream focus:border-brand-gold focus:outline-none transition-all shadow-inner"
                />
                <div class="mt-2 flex items-center justify-between text-xs text-brand-slate dark:text-gray-400 px-1">
                  <span id="qa-instruction-label">Type the Question first. When finished, press <strong>Enter ↵</strong> to type the Answer.</span>
                  <span id="qa-error-tag" class="text-rose-500 font-bold">Incorrect letter! Press Backspace.</span>
                </div>
              </div>

              <!-- Context Note Card (Revealed upon finishing Q&A) -->
