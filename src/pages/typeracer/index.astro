          </button>
          <button id="btn-lesson-complete-retry" type="button" class="refraction-btn px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-white dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-black/10 dark:border-white/10 hover:bg-black/5 active:scale-95 transition-all">
