      racers[laneIdx].progress = 100;
      racers[laneIdx].currentWpm = wpm;
      racers[laneIdx].rank = rank;
      const medalEl = document.getElementById('racer-' + laneIdx + '-medal');
      if (medalEl) {
        const medals = { 1: '🥇', 2: '🥈', 3: '🥉', 4: '4th' };
        medalEl.textContent = medals[rank] || '';
        medalEl.classList.remove('hidden');
      }
      updateRaceRankings();
    }

