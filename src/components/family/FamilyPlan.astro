---
import { buttonVariants } from "@refraction-ui/astro";
import { familyPlan } from "../../data/family/plan";
---
<article class="family-plan rounded-3xl border border-border bg-card p-6 sm:p-9" aria-label="TinyKite household pricing">
  <p class="text-sm font-semibold uppercase tracking-wide text-text">One household · All our apps</p>
  <h3 class="mt-3 text-3xl font-bold text-text">{familyPlan.name}</h3>
  <p class="mt-3 max-w-2xl text-text">{familyPlan.description}</p>
  <div class="my-6">
    <p class="text-sm text-muted-foreground">Planned after beta</p>
    <p class="mt-1 text-xl text-muted-foreground"><s>{familyPlan.monthly}/month</s> <span class="text-sm">or</span> <s>{familyPlan.yearly}/year</s></p>
    <p class="mt-3 text-3xl font-bold text-text">{familyPlan.betaPrice}</p>
  </div>
  <ul class="mb-7 grid gap-3 text-text sm:grid-cols-2">
    <li>✓ Nesta: family communication and calendar</li>
    <li>✓ Gloss: picture vocabulary and practice</li>
    <li>✓ Future TinyKite apps as they launch</li>
    <li>✓ Shared household, separate app permissions</li>
  </ul>
  <a href={familyPlan.signupUrl} class:list={[buttonVariants({ size: "lg" }), "min-h-12 whitespace-normal text-center"]}>Start your free family beta</a>
  <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground">{familyPlan.billingNotice}</p>
  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Optional backing helps build Gloss’s shared picture dictionary. Some one-off rewards include a fixed term of this same household plan. Backing isn’t required to use the beta.</p>
</article>
<style>
  .family-plan a { color: hsl(var(--primary-foreground)); }
  s { text-decoration-thickness: 2px; }
</style>
