---
// Preloader.astro — branded "box opening" intro (landing page only).
// A dark navy stage; a cream hairline cross splits apart, edges glued to
// the box, opening a framed sky panel with the product logo (k. tile +
// wordmark) centered; then the frame slides open to full-bleed and the
// sky becomes the hero's. Plays on every load; skipped for reduced motion.
---

<div id="tk-preloader" class="fixed inset-0 z-[100] bg-brand-navy" aria-hidden="true">
  <!-- faint gold dot texture on the dark stage -->
  <div class="absolute inset-0 opacity-25 pointer-events-none" style="background-image: radial-gradient(rgba(255,178,60,0.12) 1.2px, transparent 1.2px); background-size: 26px 26px;"></div>

  <!-- captions flanking the frame, like the reference -->
  <div class="pre-cap absolute text-brand-cream/55 text-sm font-medium tracking-wide text-right" style="right: calc(75vw + 16px); bottom: calc(82vh + 14px);">We build</div>
  <div class="pre-cap absolute text-brand-cream/55 text-sm font-medium tracking-wide" style="left: calc(75vw + 16px); top: calc(82vh + 14px);">tomorrow<span class="text-brand-gold">.</span></div>

  <!-- the box: zero-size at the cross, its edges glued to the splitting
       hairlines; ends framed on all four sides. Sky identical to the hero's. -->
  <div id="pre-box" class="absolute overflow-hidden" style="left: 50%; right: 50%; top: 50%; bottom: 50%;">
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #f0ebdf 0%, #faf4e8 45%, #f7f4ee 100%);"></div>
    <div class="absolute inset-0" style="background: radial-gradient(60% 55% at 78% 12%, rgba(255,227,179,0.5) 0%, transparent 70%), radial-gradient(50% 40% at 50% 100%, rgba(255,214,150,0.45) 0%, transparent 70%);"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 32% 18% at 20% 64%, rgba(255,253,248,0.7) 0%, transparent 70%), radial-gradient(ellipse 55% 50% at 15% 92%, rgba(204,214,239,0.35) 0%, transparent 70%);"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 24% 14% at 80% 26%, rgba(255,253,248,0.65) 0%, transparent 70%);"></div>

    <!-- the product logo, centered in the frame -->
    <div class="absolute inset-0 flex flex-col items-center justify-center">
      <div class="pre-mark w-20 h-20 md:w-24 md:h-24 rounded-[20px] overflow-hidden shadow-[0_12px_44px_rgba(11,16,32,0.2)]">
        <img src="/brand/k-tile.svg" alt="" class="w-full h-full" />
      </div>
      <div class="pre-word font-black text-brand-navy tracking-tight mt-6 whitespace-nowrap" style="font-size: clamp(36px, 5vw, 72px);">tinykite<span class="text-brand-gold">.</span></div>
    </div>
  </div>

  <!-- hairlines: start as a center cross, split to frame the box, slide away to open.
       Painted AFTER the box so all four borders stay visible. -->
  <div class="pre-line pre-line-v pre-line-vl absolute top-0 bottom-0 w-px bg-brand-cream/25" style="left: 50%;"></div>
  <div class="pre-line pre-line-v pre-line-vr absolute top-0 bottom-0 w-px bg-brand-cream/25" style="left: 50%;"></div>
  <div class="pre-line pre-line-h pre-line-ht absolute left-0 right-0 h-px bg-brand-cream/25" style="top: 50%;"></div>
  <div class="pre-line pre-line-h pre-line-hb absolute left-0 right-0 h-px bg-brand-cream/25" style="top: 50%;"></div>

  <!-- the kite: flies in and parks right of the logo, the texts step aside,
       it glides to center and stays through the opening — the hero's kite
       takes over from this exact spot -->
  <div class="pre-kite-home absolute z-20" style="left: calc(50% + 15vw); top: 47%;">
    <div class="pre-fly w-[clamp(90px,14vmin,126px)]" style="filter: drop-shadow(0 10px 22px rgba(11,16,32,0.22));">
      <svg viewBox="-80 -125 160 340" class="w-full h-auto" aria-hidden="true">
        <path d="M-6.5,-99.9 Q0,-110 6.5,-99.9 L59.5,-18.1 Q66,-8 59.2,1.9 L6.8,78.1 Q0,88 -6.8,78.1 L-59.2,1.9 Q-66,-8 -59.5,-18.1 Z" fill="#141b33" />
        <path d="M0,-110 L-66,-8 L0,-8 Z" fill="#f7f4ee" opacity="0.08" />
        <path d="M-66,-8 L0,-8 L0,88 Z" fill="#000000" opacity="0.18" />
        <path d="M66,-8 L0,-8 L0,88 Z" fill="#2aa48f" opacity="0.10" />
        <line x1="0" y1="-110" x2="0" y2="88" stroke="#ffb23c" stroke-opacity="0.5" stroke-width="1" />
        <line x1="-66" y1="-8" x2="66" y2="-8" stroke="#ffb23c" stroke-opacity="0.35" stroke-width="1" />
        <path d="M-6.5,-99.9 Q0,-110 6.5,-99.9 L59.5,-18.1 Q66,-8 59.2,1.9 L6.8,78.1 Q0,88 -6.8,78.1 L-59.2,1.9 Q-66,-8 -59.5,-18.1 Z" fill="none" stroke="#ffb23c" stroke-opacity="0.7" stroke-width="1.8" stroke-linejoin="round" />
        <path d="M0,88 Q10,125 -8,160 T4,206" fill="none" stroke="#ffb23c" stroke-opacity="0.7" stroke-width="2.4" stroke-linecap="round" />
        <circle cx="6" cy="112" r="2.4" fill="#ffb23c" />
        <circle cx="-5" cy="144" r="2" fill="#0b1020" />
        <circle cx="3" cy="178" r="1.6" fill="#ffb23c" />
        <g fill="#ffb23c">
          <path d="M0,-7 Q1.4,-1.4 7,0 Q1.4,1.4 0,7 Q-1.4,1.4 -7,0 Q-1.4,-1.4 0,-7 Z" transform="translate(-74,-46)" opacity="0.8" />
          <path d="M0,-5 Q1,-1 5,0 Q1,1 0,5 Q-1,1 -5,0 Q-1,-1 0,-5 Z" transform="translate(64,-72)" opacity="0.6" />
          <path d="M0,-4 Q0.8,-0.8 4,0 Q0.8,0.8 0,4 Q-0.8,0.8 -4,0 Q-0.8,-0.8 0,-4 Z" transform="translate(48,52)" opacity="0.7" />
        </g>
      </svg>
    </div>
  </div>
</div>

<script>
  (() => {
    const pre = document.getElementById('tk-preloader');
    const box = document.getElementById('pre-box');
    if (!pre || !box) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const finish = () => {
      pre.remove();
    };

    const handoff = () => {
      // Measure the intro kite's live position and hand it to the hero, so
      // the takeover starts at the exact same pixel — one continuous kite.
      const flyEl = pre.querySelector('.pre-fly');
      let detail = null;
      if (flyEl) {
        const r = flyEl.getBoundingClientRect();
        // kite silhouette center sits ~33.5% down the SVG box
        detail = { x: r.left + r.width / 2, y: r.top + r.height * 0.335 };
      }
      pre.style.opacity = '0';
      document.documentElement.classList.remove('tk-intro-running');
      window.dispatchEvent(new CustomEvent('tk:intro-done', { detail }));
      setTimeout(finish, 450);
    };

    if (reduced) {
      pre.remove();
      document.documentElement.classList.remove('tk-intro-running');
      window.dispatchEvent(new CustomEvent('tk:intro-done'));
      return;
    }

    // Play the full intro on every page load
    document.documentElement.classList.add('tk-intro-running');

    // Timeline: cross draws -> hairlines split, box edges glued to them ->
    // logo settles -> kite flies in beside it -> texts step aside -> kite
    // glides to center -> frame opens around it -> crossfade to the hero.
    setTimeout(() => pre.classList.add('pre-split'), 700);
    setTimeout(() => pre.classList.add('pre-fade-brand'), 3500);
    setTimeout(() => pre.classList.add('pre-recenter'), 3750);
    setTimeout(() => pre.classList.add('pre-open'), 4300);
    setTimeout(handoff, 5100);
  })();
</script>

<style>
  #tk-preloader {
    transition: opacity 0.4s ease;
  }

  /* cross draws in from the center */
  .pre-line-v {
    transform: scaleY(0);
    animation: preGrowY 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }
  .pre-line-h {
    transform: scaleX(0);
    animation: preGrowX 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  /* hairlines glide between positions (center -> frame -> off-screen) */
  .pre-line {
    transition: left 0.85s cubic-bezier(0.7, 0, 0.2, 1), top 0.85s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .pre-split .pre-line-vl { left: 25vw !important; }
  .pre-split .pre-line-vr { left: 75vw !important; }
  .pre-split .pre-line-ht { top: 18vh !important; }
  .pre-split .pre-line-hb { top: 82vh !important; }

  /* the box grows with the splitting lines — edges glued to them */
  #pre-box {
    transition: left 0.85s cubic-bezier(0.7, 0, 0.2, 1), right 0.85s cubic-bezier(0.7, 0, 0.2, 1),
      top 0.85s cubic-bezier(0.7, 0, 0.2, 1), bottom 0.85s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .pre-split #pre-box {
    left: 25vw !important;
    right: 25vw !important;
    top: 18vh !important;
    bottom: 18vh !important;
  }

  .pre-mark {
    opacity: 0;
    transform: scale(0.55) rotate(-14deg);
    animation: preMarkIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.6s forwards;
  }
  .pre-word {
    opacity: 0;
    transform: translateY(16px);
    animation: preRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.85s forwards;
  }
  .pre-cap {
    opacity: 0;
    animation: preFade 0.5s ease 0.4s forwards;
    transition: opacity 0.4s ease;
  }

  /* the kite's entrance: one gentle arc from below-left, landing softly;
     the bob starts from the exact landing pose so there is no snap */
  .pre-kite-home {
    transition: left 0.75s cubic-bezier(0.16, 1, 0.3, 1), top 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pre-recenter .pre-kite-home {
    left: 50% !important;
    top: 40% !important;
  }
  .pre-fly {
    opacity: 0;
    transform: translate(-50%, -50%);
    animation: preKiteIn 1.1s ease-out 2.4s forwards,
      preKiteBob 2.6s ease-in-out 3.5s infinite alternate;
  }

  /* the texts step aside once the kite has parked */
  .pre-fade-brand .pre-mark,
  .pre-fade-brand .pre-word {
    transition: opacity 0.5s ease;
    opacity: 0 !important;
  }

  /* the frame opens: lines slide off-screen, card goes full-bleed */
  .pre-open .pre-line-vl { left: -2px !important; }
  .pre-open .pre-line-vr { left: calc(100vw + 2px) !important; }
  .pre-open .pre-line-ht { top: -2px !important; }
  .pre-open .pre-line-hb { top: calc(100vh + 2px) !important; }
  .pre-open #pre-box {
    left: 0 !important;
    right: 0 !important;
    top: 0 !important;
    bottom: 0 !important;
  }
  .pre-open .pre-cap {
    transition: opacity 0.45s ease;
    opacity: 0 !important;
  }

  @keyframes preKiteIn {
    0% {
      opacity: 0;
      transform: translate(calc(-50% - 40vw), calc(-50% + 40vh)) rotate(-18deg) scale(0.7);
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) rotate(-2deg) scale(1);
    }
  }
  @keyframes preKiteBob {
    from { transform: translate(-50%, -50%) rotate(-2deg); }
    to { transform: translate(-50%, calc(-50% - 6px)) rotate(2deg); }
  }

  @keyframes preGrowY {
    to { transform: scaleY(1); }
  }
  @keyframes preGrowX {
    to { transform: scaleX(1); }
  }
  @keyframes preMarkIn {
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  @keyframes preRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes preFade {
    to { opacity: 1; }
  }
</style>
