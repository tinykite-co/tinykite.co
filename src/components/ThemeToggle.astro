---
interface Props { forceDark?: boolean; }
const { forceDark = false } = Astro.props;
---
<label class:list={["inline-flex items-center gap-2 text-sm", forceDark ? "text-white" : "text-text"]}>
  <span class="sr-only">Appearance</span>
  <select data-theme-choice aria-label="Appearance" class="rounded-lg border border-border bg-background px-2 py-2 text-text focus-visible:outline focus-visible:outline-2">
    <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option>
  </select>
</label>
<script>
  const readChoice = () => {
    try { return localStorage.getItem('theme') || 'system'; } catch { return 'system'; }
  };
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const applyChoice = () => {
    const choice = readChoice();
    document.documentElement.classList.toggle('dark', choice === 'dark' || (choice === 'system' && media.matches));
    document.querySelectorAll<HTMLSelectElement>('[data-theme-choice]').forEach(select => { select.value = choice; });
  };
  document.querySelectorAll<HTMLSelectElement>('[data-theme-choice]').forEach(select => {
    select.addEventListener('change', () => {
      try { localStorage.setItem('theme', select.value); } catch { /* System preference remains available if storage is blocked. */ }
      applyChoice();
    });
  });
  media.addEventListener('change', applyChoice);
  window.addEventListener('storage', applyChoice);
  applyChoice();
</script>
