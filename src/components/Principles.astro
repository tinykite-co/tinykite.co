---
// Principles.astro — scroll-driven "One TinyKite account" section.
// A gold thread (the account) draws through the products as you scroll;
// each part of the story lights up in turn. Facts per docs/adrs/ADR-005..007.
const steps = [
  {
    num: "01",
    title: "Sign in once",
    text: "One email, one sign-in — and everything we make is yours. Mostly free, and you only ever pay for what you use.",
  },
  {
    num: "02",
    title: "Built for households",
    text: "Every product is designed around family life — safe for children, simple for everyone, and useful in the small moments of every day.",
  },
  {
    num: "03",
    title: "Your data stays yours",
    text: "No ads, no trackers, and your data is never sold to anyone — full stop. Export or erase it all, at any time.",
  },
];
---

<section id="principles" class="relative bg-brand-navy text-brand-cream" style="height: 320vh;">
  <div class="sticky top-0 h-screen flex items-center overflow-hidden">
    <!-- faint dot pattern -->
    <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: radial-gradient(rgba(255,178,60,0.1) 1.2px, transparent 1.2px); background-size: 26px 26px;"></div>

    <div class="container mx-auto px-6 relative grid lg:grid-cols-2 gap-16 items-center">
      <!-- Steps -->
      <div>
        <p class="text-brand-gold font-bold tracking-[0.25em] uppercase text-sm mb-6">The TinyKite Account</p>
        <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-14 leading-tight">
          One account.<br />Every product.
        </h2>
        <div class="space-y-10">
          {steps.map((s, i) => (
            <div class="principle-step flex gap-6 transition-all duration-500" data-step={i} style={i === 0 ? "" : "opacity: 0.35;"}>
              <span class="principle-num font-black text-2xl text-brand-cream/25 transition-colors duration-500">{s.num}</span>
              <div>
                <h3 class="text-2xl font-bold mb-2">{s.title}</h3>
                <p class="text-brand-cream/60 leading-relaxed max-w-md">{s.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Scroll-driven diagram: the account thread linking the products -->
      <div class="hidden lg:block">
        <svg id="principles-svg" viewBox="0 0 600 420" class="w-full max-w-xl mx-auto" aria-hidden="true">
          <defs>
            <filter id="principle-glow" x="-60%" y="-60%" width="220%" height="220%">
              <feGaussianBlur stdDeviation="10" />
            </filter>
          </defs>

          <!-- gold thread (drawn by scroll) -->
          <path id="principle-thread-glow" d="M40,360 C170,330 190,270 290,230 C390,190 420,150 560,80"
                fill="none" stroke="#ffb23c" stroke-width="6" stroke-linecap="round" opacity="0.25" filter="url(#principle-glow)" />
          <path id="principle-thread" d="M40,360 C170,330 190,270 290,230 C390,190 420,150 560,80"
                fill="none" stroke="#ffb23c" stroke-width="2" stroke-linecap="round" />
          <circle id="principle-comet" r="5" fill="#ffd28a" opacity="0" />

          <!-- the values the account threads together -->
          <g class="principle-layer" data-layer="0" style="transition: opacity .5s, filter .5s;">
            <rect x="60" y="290" width="110" height="110" rx="20" transform="rotate(-8 115 345)" fill="rgba(247,244,238,0.04)" stroke="rgba(247,244,238,0.25)" stroke-width="1.5" />
            <text x="84" y="352" fill="#f7f4ee" opacity="0.7" font-size="15" font-weight="700" letter-spacing="2">FAMILY</text>
          </g>
          <g class="principle-layer" data-layer="1" style="transition: opacity .5s, filter .5s;">
            <rect x="235" y="165" width="150" height="150" rx="24" transform="rotate(-8 310 240)" fill="rgba(247,244,238,0.04)" stroke="rgba(247,244,238,0.25)" stroke-width="1.5" />
            <text x="262" y="246" fill="#f7f4ee" opacity="0.7" font-size="15" font-weight="700" letter-spacing="2">EVERYDAY</text>
          </g>
          <g class="principle-layer" data-layer="2" style="transition: opacity .5s, filter .5s;">
            <rect x="420" y="30" width="150" height="150" rx="24" transform="rotate(-8 495 105)" fill="rgba(247,244,238,0.04)" stroke="rgba(247,244,238,0.25)" stroke-width="1.5" />
            <text x="473" y="112" fill="#f7f4ee" opacity="0.7" font-size="15" font-weight="700" letter-spacing="2">TRUST</text>
          </g>
        </svg>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const section = document.getElementById('principles');
      const thread = document.getElementById('principle-thread') as unknown as SVGPathElement | null;
      const threadGlow = document.getElementById('principle-thread-glow') as unknown as SVGPathElement | null;
      const comet = document.getElementById('principle-comet');
      const steps = Array.from(document.querySelectorAll('.principle-step')) as HTMLElement[];
      const layers = Array.from(document.querySelectorAll('.principle-layer')) as SVGGElement[];
      if (!section || !thread || !threadGlow || !comet || steps.length === 0) return;

      const len = thread.getTotalLength();
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const render = (p: number) => {
        // Thread draws across the whole section scroll
        const draw = Math.min(Math.max(p * 1.15, 0), 1);
        const offset = len * (1 - draw);
        thread.style.strokeDasharray = String(len);
        threadGlow.style.strokeDasharray = String(len);
        thread.style.strokeDashoffset = String(offset);
        threadGlow.style.strokeDashoffset = String(offset);

        // Comet rides the thread tip
        const tip = thread.getPointAtLength(draw * len);
        comet.setAttribute('cx', String(tip.x));
        comet.setAttribute('cy', String(tip.y));
        comet.setAttribute('opacity', draw > 0.02 && draw < 0.99 ? '1' : '0');

        // Active step + matching layer
        const active = Math.min(2, Math.floor(p * 3));
        steps.forEach((s, i) => {
          const on = i <= active;
          s.style.opacity = on ? '1' : '0.35';
          s.style.transform = on ? 'translateX(0)' : 'translateX(-8px)';
          const num = s.querySelector('.principle-num') as HTMLElement | null;
          if (num) num.style.color = i === active ? '#ffb23c' : 'rgba(247,244,238,0.25)';
        });
        layers.forEach((l, i) => {
          const on = i <= active;
          l.style.opacity = on ? '1' : '0.4';
          const rect = l.querySelector('rect');
          if (rect) {
            rect.setAttribute('stroke', i === active ? '#ffb23c' : 'rgba(247,244,238,0.25)');
            rect.setAttribute('fill', i === active ? 'rgba(255,178,60,0.08)' : 'rgba(247,244,238,0.04)');
          }
        });
      };

      if (reduced) {
        render(1);
        return;
      }

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight;
          const p = Math.min(Math.max(-rect.top / (rect.height - vh), 0), 1);
          render(p);
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</section>
