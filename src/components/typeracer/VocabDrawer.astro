---
import type { VocabularyItem } from '../../data/typeracer/passages';

interface Props {
  vocabulary: VocabularyItem[];
}

const { vocabulary } = Astro.props;
---
<div
  id="vocab-drawer"
  class="hidden mb-4 bg-amber-50/70 dark:bg-white/5 border border-amber-200/60 dark:border-white/[0.08] rounded-2xl p-4 text-xs shadow-sm transition-all duration-200"
  role="region"
  aria-label="Passage key vocabulary terms"
>
  <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-2.5 flex items-center gap-1.5 font-serif-literary text-sm">
    <span>💡</span> Key Vocabulary in this Passage:
  </h4>
  <div id="vocab-list" class="grid sm:grid-cols-2 md:grid-cols-3 gap-2.5">
    {vocabulary.map((v) => (
      <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-black/[0.04] dark:border-white/[0.06]">
        <span class="font-bold text-slate-900 dark:text-slate-100">{v.word}:</span>
        <span class="text-slate-600 dark:text-slate-300 ml-1 leading-relaxed">{v.definition}</span>
      </div>
    ))}
  </div>
</div>
