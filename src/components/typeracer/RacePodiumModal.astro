---
/**
 * RacePodiumModal.astro
 * Final Race Summary, 4-Racer Podium, and accessible email progress capture card.
 * Fixes Issue #40 (removes internal gutenberg button ID) and Issue #41 (accessible form label & live region).
 */
---
<div id="grand-results-view" class="hidden">
  <div class="text-center py-2 mb-4">
    <span id="results-badge-icon" class="text-4xl inline-block mb-1 animate-bounce" aria-hidden="true">🏆</span>
    <span id="results-rank-pill" class="block mx-auto w-fit px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-brand-gold text-slate-950 mb-1.5 shadow-sm">
      Champion Finish!
    </span>
    <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-slate-100 font-serif-literary">
      Race Summary & Podium
    </h3>
  </div>

  <!-- Results 5-Card Grid (Separate Passage vs Q&A Speeds) -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 mb-5">
    <div class="bg-white/70 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-3 text-center shadow-sm">
      <span class="block text-[10px] font-black uppercase tracking-wider text-slate-600 dark:text-slate-300">Passage Speed</span>
      <span id="final-wpm" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-slate-100 font-mono">0</span>
      <span class="text-xs text-slate-600 dark:text-slate-300 font-bold ml-0.5">WPM</span>
    </div>
    <div class="bg-white/70 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-3 text-center shadow-sm">
      <span class="block text-[10px] font-black uppercase tracking-wider text-amber-700 dark:text-brand-gold">Q&A Speed</span>
      <span id="final-qa-wpm" class="text-2xl sm:text-3xl font-black text-amber-600 dark:text-brand-gold font-mono">N/A</span>
      <span id="final-qa-wpm-unit" class="text-xs text-slate-600 dark:text-slate-300 font-bold ml-0.5 hidden">WPM</span>
      <span class="block text-[9px] text-slate-500 dark:text-slate-400 mt-0.5">Separate Stat</span>
    </div>
    <div class="bg-white/70 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-3 text-center shadow-sm">
      <span class="block text-[10px] font-black uppercase tracking-wider text-slate-600 dark:text-slate-300">Accuracy</span>
      <span id="final-accuracy" class="text-2xl sm:text-3xl font-black text-emerald-700 dark:text-emerald-400 font-mono">100</span>
      <span class="text-xs text-slate-600 dark:text-slate-300 font-bold ml-0.5">%</span>
    </div>
    <div class="bg-white/70 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-3 text-center shadow-sm">
      <span class="block text-[10px] font-black uppercase tracking-wider text-slate-600 dark:text-slate-300">Podium Finish</span>
      <span id="final-podium-rank" class="text-2xl sm:text-3xl font-black text-amber-600 dark:text-brand-gold">1st</span>
      <span class="text-xs text-slate-600 dark:text-slate-300 font-bold ml-0.5">/ 4</span>
    </div>
    <div class="col-span-2 sm:col-span-1 bg-white/70 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-3 text-center shadow-sm">
      <span class="block text-[10px] font-black uppercase tracking-wider text-slate-600 dark:text-slate-300">Total Time</span>
      <span id="final-time" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-slate-100 font-mono">0s</span>
    </div>
  </div>

  <!-- Free Progress Save Card (WCAG 2.1 AA Accessible Form) -->
  <div
    id="email-capture-card"
    class="mb-5 p-4 sm:p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-black/[0.08] dark:border-white/[0.1] shadow-sm flex flex-wrap items-center justify-between gap-4"
  >
    <div class="flex items-center gap-3 min-w-0">
      <span class="text-3xl shrink-0" aria-hidden="true">🎓</span>
      <div>
        <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-0.5">
          Save Your Progress & Achievements
        </h4>
        <p id="email-sync-desc" class="text-xs text-slate-600 dark:text-slate-300">
          100% Free forever · Sync typing speed, lesson stars & certificates across devices.
        </p>
      </div>
    </div>

    <form id="email-capture-form" class="flex items-center gap-2 w-full sm:w-auto" aria-describedby="email-sync-desc">
      <!-- WCAG 1.3.1 / 4.1.2: Explicit screen-reader accessible label -->
      <label for="student-email-input" class="sr-only">Student email address</label>
      <input
        id="student-email-input"
        type="email"
        required
        autocomplete="email"
        placeholder="Enter student email..."
        class="px-3.5 py-2 text-xs sm:text-sm rounded-xl bg-slate-50 dark:bg-slate-800 border border-black/[0.1] dark:border-white/20 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent flex-1 sm:w-60 min-h-[44px]"
      />
      <button
        type="submit"
        class="refraction-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand-gold text-slate-950 hover:opacity-90 active:scale-95 transition-all whitespace-nowrap shadow-sm min-h-[44px]"
      >
        Save Free
      </button>
    </form>
    <div id="email-status-live" class="sr-only" aria-live="polite"></div>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <button
      id="btn-results-next"
      type="button"
      class="refraction-btn px-6 py-2.5 bg-slate-900 dark:bg-brand-gold text-white dark:text-slate-950 text-xs sm:text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all shadow-md min-h-[44px]"
    >
      🚀 Next Race
    </button>
    <button
      id="btn-results-retry"
      type="button"
      class="refraction-btn px-5 py-2.5 bg-white dark:bg-white/10 border border-black/[0.08] dark:border-white/20 text-slate-800 dark:text-slate-200 text-xs sm:text-sm font-bold rounded-xl hover:bg-slate-50 active:scale-95 transition-all min-h-[44px]"
    >
      🔁 Retry Book
    </button>
    <button
      id="btn-podium-history"
      type="button"
      class="refraction-btn px-4 py-2.5 bg-white dark:bg-white/10 border border-black/[0.08] dark:border-white/20 text-slate-800 dark:text-slate-200 text-xs sm:text-sm font-bold rounded-xl hover:bg-amber-100 dark:hover:bg-white/20 transition-all flex items-center gap-1.5 min-h-[44px]"
    >
      <span aria-hidden="true">📜</span> <span>View History</span>
    </button>
    <button
      id="btn-share-score"
      type="button"
      class="refraction-btn px-5 py-2.5 bg-brand-teal text-white text-xs sm:text-sm font-bold rounded-xl hover:opacity-90 active:scale-95 transition-all flex items-center gap-1.5 min-h-[44px]"
    >
      <span aria-hidden="true">📋</span> <span id="share-btn-text">Share Score</span>
    </button>
    <a
      id="results-full-book-btn"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="refraction-btn px-4 py-2.5 bg-white/80 dark:bg-white/5 text-slate-800 dark:text-slate-200 border border-black/[0.08] dark:border-white/10 text-xs sm:text-sm font-bold rounded-xl hover:text-amber-700 transition-colors inline-flex items-center gap-1 min-h-[44px]"
    >
      <span>📖 Full Book</span> ↗
    </a>
  </div>
</div>
