---
/**
 * CareerFooter.astro
 * Career Performance Bar tracking Races, Victories, Speeds, and Typing Academy Stars.
 * Implements Issue #49: full gamification tracking.
 */
---
<footer class="mt-5 refraction-panel p-4 sm:p-5 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-slate-900 dark:text-slate-100 shadow-sm">
  <div class="flex flex-wrap items-center gap-3 sm:gap-6">
    <span class="text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold">Career Performance:</span>
    <div>Races: <strong id="career-races" class="font-mono">0</strong></div>
    <div>Victories (1st): <strong id="career-victories" class="text-amber-600 dark:text-brand-gold font-mono">0</strong></div>
    <div>Best Speed: <strong id="career-best-wpm" class="text-emerald-700 dark:text-emerald-400 font-mono">0 WPM</strong></div>
    <div>Average Speed: <strong id="career-avg-wpm" class="font-mono">0 WPM</strong></div>
    <div class="border-l border-black/10 dark:border-white/10 pl-3 sm:pl-6 flex items-center gap-1.5">
      <span>Academy Stars:</span>
      <strong id="career-academy-stars" class="text-amber-500 font-mono">0 ⭐</strong>
    </div>
  </div>
  <button
    id="btn-reset-career"
    type="button"
    class="text-slate-500 dark:text-slate-400 hover:text-rose-600 transition-colors text-xs font-medium py-1 px-2 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/30"
  >
    Reset Career Stats
  </button>
</footer>
