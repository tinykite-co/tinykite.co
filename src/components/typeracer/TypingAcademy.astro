---
/**
 * TypingAcademy.astro
 * Section 2: Touch Typing Academy & Ergonomic 12-Lesson Curriculum
 */
import VirtualKeyboard from './VirtualKeyboard.astro';
import HandVisualizer from './HandVisualizer.astro';
import CurriculumGrid from './CurriculumGrid.astro';
---
<section id="tab-lessons-view" role="tabpanel" aria-labelledby="tab-btn-lessons" class="hidden">
  <div class="refraction-panel p-5 sm:p-7 relative overflow-hidden">
    <div class="refraction-prismatic-rim absolute top-0 inset-x-0"></div>

    <!-- Academy Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/[0.06] dark:border-white/[0.08] pb-4 mb-5 pt-1">
      <div>
        <p class="text-amber-800 dark:text-brand-gold font-bold text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span aria-hidden="true">⌨️</span> Free Touch Typing Curriculum
        </p>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 font-serif-literary">
          Touch Typing Academy
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          12 step-by-step ergonomic lessons. Build muscle memory on home row anchors, shift capitalization, and dialogue transitions.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span id="academy-student-tag" class="text-xs font-bold px-3 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-900 dark:text-emerald-300 border border-emerald-300/40">
          ✓ 100% Free Forever
        </span>
      </div>
    </div>

    <!-- Active Lesson Interactive Drill Card -->
    <div id="lesson-interactive-card" class="bg-slate-50/80 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] rounded-2xl p-4 sm:p-6 mb-6 shadow-sm">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2 flex-wrap">
          <span id="lesson-module-tag" class="px-2.5 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wider bg-brand-gold text-slate-950 shadow-sm">
            Level 1 · Lesson 1
          </span>
          <h3 id="lesson-active-title" class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100">
            The Anchor Keys: F & J (No Spacebar)
          </h3>
        </div>
        <!-- Lesson Navigation Controls (Issue #50) -->
        <div class="flex items-center gap-2">
          <button
            id="btn-prev-lesson"
            type="button"
            class="refraction-btn px-2.5 py-1 text-xs font-bold rounded-lg bg-white dark:bg-white/10 border border-black/[0.08] dark:border-white/10 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/20 transition-all min-h-[36px]"
            title="Previous lesson (Alt+P)"
            aria-label="Previous lesson"
          >
            ← Prev
          </button>
          <div class="text-xs font-bold text-slate-600 dark:text-slate-300 px-1">
            Accuracy: <strong id="lesson-hud-acc" class="text-emerald-700 dark:text-emerald-400 font-mono text-sm">100%</strong>
          </div>
          <button
            id="btn-next-lesson"
            type="button"
            class="refraction-btn px-2.5 py-1 text-xs font-bold rounded-lg bg-white dark:bg-white/10 border border-black/[0.08] dark:border-white/10 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/20 transition-all min-h-[36px]"
            title="Next lesson (Alt+N)"
            aria-label="Next lesson"
          >
            Next →
          </button>
        </div>
      </div>

      <p id="lesson-instruction-tip" class="text-xs text-slate-600 dark:text-slate-300 mb-3 italic">
        Rest index fingers on the tactile bumps. No Spacebar in this first drill—pure F & J muscle memory!
      </p>

      <!-- Target Lesson Drill Display Box -->
      <div
        id="lesson-drill-card"
        class="p-5 sm:p-6 bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-white/[0.15] rounded-2xl shadow-sm mb-4 cursor-text focus-within:ring-2 focus-within:ring-amber-500 relative"
        tabindex="0"
        role="region"
        aria-label="Touch typing drill practice area"
      >
        <!-- Accessible input to intercept keystrokes -->
        <label for="lesson-drill-input" class="sr-only">Type lesson letters</label>
        <input
          id="lesson-drill-input"
          type="text"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          class="sr-only"
        />

        <!-- Drill Characters Display -->
        <div
          id="lesson-text-display"
          class="font-mono text-xl sm:text-2xl md:text-3xl tracking-widest leading-loose select-none break-all"
          aria-live="polite"
        >
          <!-- Dynamically populated -->
        </div>

        <!-- Rule Banner & Live Error Tag -->
        <div class="mt-4 pt-3 border-t border-black/[0.06] dark:border-white/[0.08] flex flex-wrap items-center justify-between gap-2 text-xs">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span id="finger-guidance-cue" class="font-bold text-slate-700 dark:text-slate-300">
              👉 Strike highlighted key. Mistakes block advancement without backspacing!
            </span>
          </div>
          <div id="lesson-error-tag" class="hidden text-rose-600 dark:text-rose-400 font-black flex items-center gap-1.5 animate-bounce">
            <span aria-hidden="true">⚠️</span> <span id="lesson-error-msg">Incorrect key! Strike the correct key to advance.</span>
          </div>
        </div>
      </div>

      <!-- 3D VIRTUAL KEYBOARD -->
      <VirtualKeyboard />

      <!-- ANATOMICAL HANDS GRAPHIC -->
      <HandVisualizer />

    </div>

    <!-- 12-LESSON SYLLABUS CURRICULUM GRID -->
    <CurriculumGrid />

  </div>

  <!-- LESSON COMPLETE CELEBRATION MODAL -->
  <div id="lesson-complete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-md" role="dialog" aria-modal="true" aria-labelledby="lesson-complete-title">
    <div class="refraction-panel w-full max-w-md p-6 sm:p-8 text-center relative overflow-hidden shadow-2xl">
      <div class="refraction-prismatic-rim absolute top-0 inset-x-0"></div>
      <span class="text-5xl block mb-2 animate-bounce" aria-hidden="true">🎉</span>
      <h3 id="lesson-complete-title" class="text-2xl font-bold font-serif-literary text-slate-900 dark:text-white mb-1">
        Lesson Complete!
      </h3>
      <p id="lesson-complete-stars" class="text-2xl mb-3" aria-label="Stars earned">⭐⭐⭐</p>
      <div class="grid grid-cols-2 gap-3 mb-5">
        <div class="p-3 rounded-2xl bg-amber-400/10 border border-amber-400/30">
          <span class="block text-[10px] font-black uppercase tracking-wider text-amber-800 dark:text-amber-300">Speed</span>
          <strong id="lesson-complete-wpm" class="text-2xl font-black text-slate-900 dark:text-white font-mono">0</strong> <span class="text-xs">WPM</span>
        </div>
        <div class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30">
          <span class="block text-[10px] font-black uppercase tracking-wider text-emerald-800 dark:text-emerald-300">Accuracy</span>
          <strong id="lesson-complete-acc" class="text-2xl font-black text-slate-900 dark:text-white font-mono">100</strong> <span class="text-xs">%</span>
        </div>
      </div>
      <div class="flex items-center justify-center gap-3">
        <button id="btn-lesson-complete-next" type="button" class="refraction-btn px-5 py-2.5 rounded-xl font-black text-xs sm:text-sm bg-brand-gold text-slate-950 hover:opacity-90 active:scale-95 transition-all shadow-md min-h-[44px]">
          Next Lesson ➔
        </button>
        <button id="btn-lesson-complete-retry" type="button" class="refraction-btn px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-white dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-black/10 dark:border-white/10 hover:bg-black/5 active:scale-95 transition-all min-h-[44px]">
          Repeat Drill 🔁
        </button>
      </div>
    </div>
  </div>
</section>
