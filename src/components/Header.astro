---
import ThemeToggle from "./ThemeToggle.astro";
const links = [{href:"/nesta/", label:"Nesta"}, {href:"/gloss/", label:"Gloss"}, {href:"/#our-purpose", label:"Our purpose"}];
---

<header id="site-header" class="sticky top-0 z-50 w-full backdrop-blur-md bg-brand-cream/80 dark:bg-brand-navy/80 border-b border-brand-mist dark:border-white/10 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">

  <!-- Logo -->
  <a href="/" class="flex items-center gap-2.5 group">
    <img src="/brand/k-tile.svg" alt="" onerror="this.style.display='none'" class="w-8 h-8 rounded-[9px] dark:hidden transition-transform duration-300 group-hover:-rotate-6" />
    <img src="/brand/k-tile-cream.svg" alt="" aria-hidden="true" onerror="this.style.display='none'" class="w-8 h-8 rounded-[9px] hidden dark:block transition-transform duration-300 group-hover:-rotate-6" />
    <span class="font-black text-brand-navy dark:text-brand-cream text-xl tracking-tight">tinykite<span class="text-brand-gold">.</span></span>
  </a>

  <!-- Desktop Navigation -->
  <nav class="hidden lg:flex items-center gap-5 text-brand-slate dark:text-gray-300 text-sm font-medium">
    {links.map(link => <a href={link.href} class="hover:text-brand-navy dark:hover:text-brand-gold transition-colors">{link.label}</a>)}
  </nav>

  <!-- CTA & Theme Toggle -->
  <div class="flex items-center gap-4">
    <div class="hidden lg:block">
      <ThemeToggle />
    </div>
    <a href="/#feature-request" class="site-header-suggestion-btn hidden lg:block px-5 py-2 bg-brand-navy text-brand-cream dark:bg-brand-gold dark:text-brand-navy text-sm font-bold rounded-full hover:opacity-85 hover:scale-[1.03] active:scale-95 transition-all duration-200">
      What does your child need?
    </a>

    <!-- Mobile Menu Icon -->
    <button id="menu-icon" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu" class="lg:hidden p-3 text-brand-navy dark:text-brand-cream focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden absolute top-full mt-4 right-0 w-full bg-brand-cream/95 dark:bg-brand-navy/95 border border-brand-mist dark:border-white/10 rounded-2xl p-6 flex-col gap-4 text-center backdrop-blur-xl shadow-xl">
    {links.map(link => <a href={link.href} class="text-brand-navy dark:text-brand-cream text-lg font-medium">{link.label}</a>)}
    <div class="flex justify-center py-2">
      <ThemeToggle />
    </div>
    <a href="/#feature-request" class="site-header-suggestion-btn text-brand-gold font-bold">What does your child need?</a>
  </div>
  </div>
</header>

<style>
  @media (display-mode: standalone) {
    .site-header-suggestion-btn {
      display: none !important;
    }
  }
</style>

<script>
  const menuIcon = document.getElementById("menu-icon");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuIcon && mobileMenu) {
    menuIcon.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
      mobileMenu.classList.toggle("flex");
      menuIcon.setAttribute("aria-expanded", String(!mobileMenu.classList.contains("hidden")));
    });

    // Close menu when clicking a link
    const menuLinks = mobileMenu.querySelectorAll("a");
    menuLinks.forEach(link => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        mobileMenu.classList.remove("flex");
        menuIcon.setAttribute("aria-expanded", "false");
      });
    });
  }

  // When running inside an installed PWA window (display-mode: standalone),
  // open out-of-scope website navigation links in the default browser with target="_blank"
  // so other TinyKite apps can be launched and installed separately.
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone === true;
  if (isStandalone) {
    const siteHeader = document.getElementById('site-header');
    if (siteHeader) {
      const allLinks = siteHeader.querySelectorAll('a');
      allLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#')) return;

        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');

        if (!link.querySelector('.pwa-external-icon') && !link.textContent?.includes('↗')) {
          const arrow = document.createElement('span');
          arrow.className = 'pwa-external-icon text-xs opacity-70 ml-0.5 inline-block select-none font-mono';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '↗';
          link.appendChild(arrow);
        }
      });
    }
  }
</script>
