---
/**
 * StopwatchView.astro
 * Focused, distraction-free Analog & Digital Chronograph.
 * One unified hero card with 60fps sweep hands, clean tabular digital readout,
 * compact telemetry strip, split lap table, and collapsible saved sessions.
 */

// Generate 60-second chapter ring ticks and sub-ticks at build time
const majorTicks = Array.from({ length: 60 }, (_, i) => {
  const angle = i * 6; // 360 / 60 = 6 deg
  const isMajor5 = i % 5 === 0;
  return { i, angle, isMajor5 };
});

const subSecondTicks = Array.from({ length: 300 }, (_, i) => {
  if (i % 5 === 0) return null;
  return { i, angle: i * 1.2 };
}).filter((t): t is { i: number; angle: number } => t !== null);

const chapterNumbers = [
  { val: '60', deg: 0 },
  { val: '05', deg: 30 },
  { val: '10', deg: 60 },
  { val: '15', deg: 90 },
  { val: '20', deg: 120 },
  { val: '25', deg: 150 },
  { val: '30', deg: 180 },
  { val: '35', deg: 210 },
  { val: '40', deg: 240 },
  { val: '45', deg: 270 },
  { val: '50', deg: 300 },
  { val: '55', deg: 330 },
].map(({ val, deg }) => {
  const rad = (deg * Math.PI) / 180;
  const radius = 121;
  const x = Math.round(160 + radius * Math.sin(rad));
  const y = Math.round(160 - radius * Math.cos(rad) + 4);
  return { val, x, y };
});

const subdialTicks = Array.from({ length: 30 }, (_, i) => ({
  i,
  angle: i * 12,
  isMajor: i % 5 === 0,
}));
---

<section
  id="panel-stopwatch"
  role="tabpanel"
  aria-labelledby="tab-btn-stopwatch"
  class="space-y-6 max-w-4xl mx-auto"
>
  <!-- Unified Serene Hero Card -->
  <div class="refraction-panel p-6 sm:p-8 relative overflow-hidden">
    <div class="refraction-prismatic-rim absolute top-0 inset-x-0"></div>

    <!-- Top Card Status & Format Row -->
    <div class="flex items-center justify-between pb-3 mb-2 border-b border-black/[0.06] dark:border-white/[0.06]">
      <div class="flex items-center gap-2">
        <span
          id="sw-status-badge"
          class="px-2.5 py-0.5 text-[11px] font-mono font-bold tracking-wider uppercase rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 transition-colors"
        >
          READY
        </span>
      </div>

      <!-- Precision Decimal Toggle (.cc / .mmm) -->
      <button
        id="btn-ms-toggle"
        type="button"
        class="refraction-btn px-2.5 py-0.5 text-xs font-mono font-bold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all border border-black/[0.06] dark:border-white/[0.08] cursor-pointer"
        title="Toggle hundredths (.cc) vs milliseconds (.mmm)"
      >
        .cc
      </button>
    </div>

    <!-- Main Stage: Dual Column (Chrono SVG Left + Digital Display & Controls Right) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center py-4">
      <!-- Left Column: Clean Analog Chronograph Face -->
      <div class="md:col-span-5 flex flex-col items-center">
        <div class="relative w-full max-w-[210px] aspect-square flex items-center justify-center">
          <svg
            class="w-full h-full drop-shadow-md select-none"
            viewBox="0 0 320 320"
            aria-hidden="true"
          >
            <!-- Outer Bezel & Case Rings -->
            <circle cx="160" cy="160" r="156" class="fill-slate-100 dark:fill-slate-900 stroke-slate-300 dark:stroke-slate-800" stroke-width="4" />
            <circle cx="160" cy="160" r="150" class="fill-white dark:fill-slate-950 stroke-slate-200 dark:stroke-slate-800" stroke-width="2" />
            <circle cx="160" cy="160" r="148" class="fill-none stroke-black/5 dark:stroke-white/5" stroke-width="1" />

            <!-- Sub-second 1/5th tick marks -->
            <g class="stroke-slate-300 dark:stroke-slate-700" stroke-width="0.8">
              {subSecondTicks.map((st) => (
                <line
                  x1="160"
                  y1="13"
                  x2="160"
                  y2="17"
                  transform={`rotate(${st.angle} 160 160)`}
                />
              ))}
            </g>

            <!-- 60-second Chapter Ring Ticks -->
            <g class="stroke-slate-700 dark:stroke-slate-300">
              {majorTicks.map((mt) => (
                <line
                  x1="160"
                  y1="12"
                  x2="160"
                  y2={mt.isMajor5 ? '23' : '19'}
                  stroke-width={mt.isMajor5 ? '2.4' : '1.2'}
                  class={mt.isMajor5 ? 'stroke-slate-900 dark:stroke-slate-100' : 'stroke-slate-500 dark:stroke-slate-400'}
                  transform={`rotate(${mt.angle} 160 160)`}
                />
              ))}
            </g>

            <!-- 5-second Chapter Numbers -->
            <g class="fill-slate-800 dark:fill-slate-200 text-[11px] font-mono font-bold select-none text-center" text-anchor="middle">
              {chapterNumbers.map((cn) => (
                <text x={cn.x} y={cn.y}>{cn.val}</text>
              ))}
            </g>

            <!-- Upper 30-Minute Sub-Dial -->
            <g id="analog-subdial-group">
              <circle cx="160" cy="108" r="38" class="fill-slate-50 dark:fill-slate-900/90 stroke-slate-300 dark:stroke-slate-700" stroke-width="1.2" />
              <circle cx="160" cy="108" r="37" class="fill-none stroke-black/5 dark:stroke-white/5" stroke-width="0.7" />

              <!-- Subdial ticks -->
              {subdialTicks.map((sdt) => (
                <line
                  x1="160"
                  y1="73"
                  x2="160"
                  y2={sdt.isMajor ? '78' : '76'}
                  stroke-width={sdt.isMajor ? '1.5' : '0.8'}
                  class="stroke-slate-600 dark:stroke-slate-400"
                  transform={`rotate(${sdt.angle} 160 108)`}
                />
              ))}

              <text x="160" y="85" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300 text-[8px] font-mono font-bold">30</text>
              <text x="183" y="111" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300 text-[8px] font-mono font-bold">10</text>
              <text x="137" y="111" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300 text-[8px] font-mono font-bold">20</text>

              <!-- Minute Sub-Dial Hand -->
              <g id="analog-minute-hand" transform="rotate(0 160 108)">
                <line x1="160" y1="114" x2="160" y2="76" stroke="#2563eb" stroke-width="2" stroke-linecap="round" />
                <circle cx="160" cy="108" r="2.5" fill="#2563eb" />
              </g>
            </g>

            <!-- Secondary Lap Hand (Gold split memory) -->
            <g id="analog-lap-hand" transform="rotate(0 160 160)">
              <line x1="160" y1="184" x2="160" y2="24" stroke="#f59e0b" stroke-width="1.8" stroke-dasharray="3,2" stroke-linecap="round" />
              <circle cx="160" cy="160" r="4" fill="#f59e0b" />
            </g>

            <!-- Primary Chronograph Seconds Sweep Hand (Emerald/Amber/Rose) -->
            <g id="analog-second-hand" transform="rotate(0 160 160)">
              <line x1="160" y1="192" x2="160" y2="18" stroke="#e11d48" stroke-width="2.2" stroke-linecap="round" />
              <circle cx="160" cy="192" r="3.5" fill="#e11d48" />
              <circle cx="160" cy="160" r="5" fill="#0f172a" class="dark:fill-slate-100" />
              <circle cx="160" cy="160" r="2" fill="#e11d48" />
            </g>
          </svg>
        </div>

        <!-- Quiet Collapsible Target Pace Details -->
        <details class="mt-3 w-full text-xs">
          <summary class="cursor-pointer text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-center font-medium select-none list-none flex items-center justify-center gap-1">
            <span>🎯</span>
            <span>Target Pace</span>
            <span
              id="pace-delta-badge"
              class="hidden ml-1 px-1.5 py-0.2 rounded font-mono text-[10px] font-bold"
            >
              +0.0s
            </span>
          </summary>
          <div class="mt-2.5 p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-black/[0.06] dark:border-white/[0.08] space-y-2">
            <div class="flex items-center gap-2">
              <input
                type="number"
                id="input-target-pace"
                min="1"
                max="3600"
                step="1"
                placeholder="Pace (sec)"
                class="w-full px-2.5 py-1 text-xs font-mono font-bold rounded-lg bg-white dark:bg-slate-800 border border-black/[0.1] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-amber-500"
              />
              <button
                id="btn-pace-clear"
                type="button"
                class="px-2 py-1 text-[11px] font-semibold rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-300 transition-colors shrink-0"
              >
                Clear
              </button>
              <button
                id="btn-clear-pace"
                type="button"
                class="hidden"
                aria-hidden="true"
                tabindex="-1"
              >
              </button>
            </div>
            <div class="flex items-center gap-1 justify-center">
              <button type="button" class="pace-preset-btn px-2 py-0.5 rounded text-[10px] font-mono bg-white dark:bg-slate-800 border border-black/[0.06] text-slate-600 dark:text-slate-400 hover:text-amber-500" data-seconds="30">30s</button>
              <button type="button" class="pace-preset-btn px-2 py-0.5 rounded text-[10px] font-mono bg-white dark:bg-slate-800 border border-black/[0.06] text-slate-600 dark:text-slate-400 hover:text-amber-500" data-seconds="60">60s</button>
              <button type="button" class="pace-preset-btn px-2 py-0.5 rounded text-[10px] font-mono bg-white dark:bg-slate-800 border border-black/[0.06] text-slate-600 dark:text-slate-400 hover:text-amber-500" data-seconds="90">90s</button>
              <button type="button" class="pace-preset-btn px-2 py-0.5 rounded text-[10px] font-mono bg-white dark:bg-slate-800 border border-black/[0.06] text-slate-600 dark:text-slate-400 hover:text-amber-500" data-seconds="120">120s</button>
            </div>
          </div>
        </details>
      </div>

      <!-- Right Column: Giant Digital Readout & Action Buttons -->
      <div class="md:col-span-7 flex flex-col items-center md:items-start justify-center">
        <!-- Giant Digital Readout -->
        <div class="flex items-baseline tracking-tight select-none">
          <span
            id="sw-digital-main"
            class="text-6xl sm:text-7xl font-mono font-black tracking-tight tabular-nums text-slate-900 dark:text-slate-50"
          >
            00:00
          </span>
          <span
            id="sw-digital-fraction"
            class="text-3xl sm:text-4xl font-mono font-bold text-amber-500 tabular-nums ml-1"
          >
            .00
          </span>
        </div>

        <!-- Quiet Current Lap Line -->
        <div class="font-mono tabular-nums text-sm text-slate-400 dark:text-slate-500 mt-1 mb-6 flex items-center gap-1.5">
          <span>Lap</span>
          <span id="sw-current-lap-time" class="text-slate-600 dark:text-slate-300 font-semibold">00:00.00</span>
        </div>

        <!-- 3 Focused Action Buttons -->
        <div class="flex items-center gap-3 w-full max-w-md">
          <!-- Start / Pause Button -->
          <button
            id="btn-sw-start"
            type="button"
            class="flex-1 refraction-btn min-h-[48px] rounded-2xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white shadow-md transition-all active:scale-95 cursor-pointer"
          >
            <span id="sw-start-icon">▶</span>
            <span id="sw-start-label">Start</span>
          </button>

          <!-- Lap Button -->
          <button
            id="btn-sw-lap"
            type="button"
            class="flex-1 refraction-btn min-h-[48px] rounded-2xl font-bold text-sm sm:text-base flex items-center justify-center gap-1.5 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all active:scale-95 border border-black/[0.08] dark:border-white/[0.1] cursor-pointer"
          >
            <span>Lap</span>
          </button>

          <!-- Reset Button -->
          <button
            id="btn-sw-reset"
            type="button"
            class="flex-1 refraction-btn min-h-[48px] rounded-2xl font-bold text-sm sm:text-base flex items-center justify-center gap-1.5 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all active:scale-95 border border-black/[0.08] dark:border-white/[0.1] cursor-pointer"
          >
            <span>Reset</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Compact 4-Stat Inline Strip -->
    <div class="grid grid-cols-4 gap-2 pt-4 pb-2 border-t border-slate-200/60 dark:border-white/[0.08] text-center">
      <div>
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Best Lap</div>
        <div id="stat-best-lap" class="text-sm font-mono font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">--:--.--</div>
      </div>
      <div>
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Worst Lap</div>
        <div id="stat-worst-lap" class="text-sm font-mono font-bold text-rose-600 dark:text-rose-400 tabular-nums">--:--.--</div>
      </div>
      <div>
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Average</div>
        <div id="stat-avg-lap" class="text-sm font-mono font-bold text-slate-800 dark:text-slate-200 tabular-nums">--:--.--</div>
      </div>
      <div>
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Consistency</div>
        <div id="stat-consistency" class="text-sm font-mono font-bold text-amber-600 dark:text-brand-gold tabular-nums">100%</div>
        <div id="stat-stddev" class="sr-only">σ ±0.0s</div>
      </div>
    </div>
  </div>

  <!-- Recorded Laps Table Card -->
  <div id="sw-laps-container" class="refraction-panel p-5">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>📊</span>
          <span>Recorded Laps</span>
        </h3>
        <span id="sw-lap-count-badge" class="px-2 py-0.5 text-[10px] font-bold font-mono rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          0 Laps
        </span>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-copy-laps"
          type="button"
          class="refraction-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-white/80 dark:bg-slate-900/80 border border-black/[0.08] dark:border-white/[0.12] text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all flex items-center gap-1 cursor-pointer"
        >
          <span>📋</span>
          <span>Copy</span>
        </button>
        <button
          id="btn-export-csv"
          type="button"
          class="refraction-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-white/80 dark:bg-slate-900/80 border border-black/[0.08] dark:border-white/[0.12] text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all flex items-center gap-1 cursor-pointer"
        >
          <span>📥</span>
          <span>CSV</span>
        </button>
        <button
          id="btn-save-session"
          type="button"
          class="refraction-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-brand-gold hover:bg-amber-500/25 transition-all flex items-center gap-1 cursor-pointer"
        >
          <span>💾</span>
          <span>Save</span>
        </button>
      </div>
    </div>

    <!-- Scrollable Table -->
    <div class="max-h-60 overflow-y-auto rounded-xl border border-black/[0.06] dark:border-white/[0.08]">
      <table class="w-full text-left border-collapse text-xs">
        <thead class="sticky top-0 bg-slate-100 dark:bg-slate-900/90 backdrop-blur-xs text-slate-600 dark:text-slate-400 font-bold border-b border-black/[0.08] dark:border-white/[0.08]">
          <tr>
            <th class="py-2 px-3">Lap</th>
            <th class="py-2 px-3">Lap Time</th>
            <th class="py-2 px-3">Total Split</th>
            <th class="py-2 px-3">Delta</th>
          </tr>
        </thead>
        <tbody id="sw-laps-tbody" class="divide-y divide-black/[0.04] dark:divide-white/[0.04] font-mono">
          <!-- Dynamically populated rows -->
        </tbody>
      </table>

      <!-- Empty State -->
      <div id="sw-laps-empty" class="py-6 text-center text-slate-400 dark:text-slate-500 text-xs">
        No laps recorded yet. Press <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono text-slate-700 dark:text-slate-300">Space</kbd> to start and <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono text-slate-700 dark:text-slate-300">L</kbd> to record a lap.
      </div>
    </div>

    <!-- Collapsible Saved Sessions History -->
    <details id="sw-saved-sessions-panel" class="mt-4 pt-3 border-t border-black/[0.06] dark:border-white/[0.06]">
      <summary class="cursor-pointer text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 select-none flex items-center justify-between py-1">
        <span class="flex items-center gap-1.5">
          <span>💾</span>
          <span>Saved Sessions History</span>
        </span>
        <span class="text-[11px] text-slate-400">Toggle</span>
      </summary>

      <div class="mt-3 space-y-3">
        <div class="flex items-center gap-2">
          <input
            type="text"
            id="input-session-title"
            placeholder="Session name (e.g. Cube Sprint)"
            class="flex-1 px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
          <button
            id="btn-save-session-submit"
            type="button"
            class="refraction-btn px-3 py-1.5 text-xs font-bold rounded-xl bg-amber-500 text-slate-950 hover:bg-amber-400 transition-all shrink-0 cursor-pointer"
          >
            Save Current
          </button>
        </div>

        <div id="sw-sessions-list" class="space-y-2">
          <!-- Dynamically populated by client-app.ts -->
        </div>
      </div>
    </details>
  </div>
</section>
