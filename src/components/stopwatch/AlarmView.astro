---
/**
 * AlarmView.astro
 * Kid-friendly scheduled alarms with customizable repeat days, sound chimes,
 * snooze management, and ringing alert modal.
 */
import { ALARM_PRESET_LABELS, SOUND_PROFILES } from '../../lib/stopwatch/config.ts';

const dayLetters = [
  { day: 0, label: 'S', title: 'Sunday' },
  { day: 1, label: 'M', title: 'Monday' },
  { day: 2, label: 'T', title: 'Tuesday' },
  { day: 3, label: 'W', title: 'Wednesday' },
  { day: 4, label: 'T', title: 'Thursday' },
  { day: 5, label: 'F', title: 'Friday' },
  { day: 6, label: 'S', title: 'Saturday' },
];
---

<section
  id="panel-alarm"
  role="tabpanel"
  aria-labelledby="tab-btn-alarm"
  class="space-y-6 hidden"
>
  <!-- Top Next Alarm Status Banner -->
  <div
    id="alarm-next-banner"
    class="refraction-panel p-4 flex items-center justify-between flex-wrap gap-2 border-l-4 border-l-amber-500"
  >
    <div class="flex items-center gap-2.5">
      <span class="text-xl">⏰</span>
      <div>
        <div id="alarm-next-title" class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-100">
          Next alarm: Loading schedule...
        </div>
        <div id="alarm-next-subtitle" class="text-[11px] text-slate-500 dark:text-slate-400">
          Syncing local alarm schedule
        </div>
      </div>
    </div>
    <span
      id="alarm-next-status-pill"
      class="px-2.5 py-1 text-xs font-mono font-bold rounded-full bg-amber-500/15 text-amber-800 dark:text-brand-gold border border-amber-500/30"
    >
      Active
    </span>
  </div>

  <!-- Desktop 2-Column Responsive Layout -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
    <!-- LEFT COLUMN (5 cols) — Create New Alarm Card -->
    <div class="md:col-span-5 refraction-panel p-6">
      <div class="refraction-prismatic-rim -mt-6 -mx-6 mb-5"></div>

      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5">
        <span>⏰</span>
        Set New Alarm
      </h3>

      <!-- Time Input Controls -->
      <div class="mb-4">
        <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1.5">
          Alarm Time (24h or HH:MM)
        </label>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Hour (0-23)</span>
            <input
              type="number"
              id="alarm-input-hour"
              min="0"
              max="23"
              value="7"
              class="w-full px-3 py-2 text-base font-mono font-bold text-center rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
          <div>
            <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Minute (0-59)</span>
            <input
              type="number"
              id="alarm-input-minute"
              min="0"
              max="59"
              value="30"
              class="w-full px-3 py-2 text-base font-mono font-bold text-center rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
        </div>

        <!-- Optional native time picker synced for browser keyboard convenience -->
        <div class="mt-2 text-right">
          <input
            type="time"
            id="alarm-input-time"
            value="07:30"
            class="text-xs px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-black/[0.08] dark:border-white/[0.1]"
          />
        </div>
      </div>

      <!-- Label Input & Kid Preset Chips -->
      <div class="mb-4">
        <label for="alarm-input-label" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
          Alarm Label
        </label>
        <input
          type="text"
          id="alarm-input-label"
          value="Morning Wake Up"
          placeholder="e.g. Morning Wake Up, Screen Time Over"
          class="w-full px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 mb-2"
        />

        <!-- Preset Chips -->
        <div class="flex flex-wrap gap-1.5">
          {ALARM_PRESET_LABELS.map((label) => (
            <button
              type="button"
              class="alarm-label-chip px-2 py-0.5 text-[10px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-950/60 hover:text-amber-800 dark:hover:text-amber-300 transition-colors"
              data-label={label}
            >
              {label}
            </button>
          ))}
        </div>
      </div>

      <!-- Repeat Days Selector -->
      <div class="mb-4">
        <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1.5">
          Repeat Days
        </label>
        <!-- 7 Day Buttons -->
        <div class="flex items-center justify-between gap-1 mb-2">
          {dayLetters.map((d) => (
            <button
              type="button"
              class="alarm-day-btn w-8 h-8 rounded-full text-xs font-bold transition-all border border-black/[0.1] dark:border-white/[0.1] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700"
              data-day={d.day}
              title={d.title}
            >
              {d.label}
            </button>
          ))}
        </div>

        <!-- Quick Day Presets -->
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="btn-days-weekdays"
            class="refraction-btn px-2 py-0.5 text-[10px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-white/10"
          >
            Weekdays
          </button>
          <button
            type="button"
            id="btn-days-everyday"
            class="refraction-btn px-2 py-0.5 text-[10px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-white/10"
          >
            Every Day
          </button>
          <button
            type="button"
            id="btn-days-once"
            class="refraction-btn px-2 py-0.5 text-[10px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-white/10"
          >
            Once
          </button>
        </div>
      </div>

      <!-- Sound & Snooze Controls -->
      <div class="grid grid-cols-2 gap-2 mb-5">
        <div>
          <label for="alarm-select-sound" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
            Sound Chime
          </label>
          <select
            id="alarm-select-sound"
            class="w-full px-2.5 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
          >
            {SOUND_PROFILES.map((sound) => (
              <option value={sound.id} selected={sound.id === 'crystal-chime'}>
                {sound.label}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="alarm-select-snooze" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
            Snooze Duration
          </label>
          <select
            id="alarm-select-snooze"
            class="w-full px-2.5 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
          >
            <option value="5" selected>5 minutes</option>
            <option value="9">9 minutes</option>
            <option value="10">10 minutes</option>
            <option value="15">15 minutes</option>
          </select>
        </div>
      </div>

      <!-- Submit Button -->
      <button
        id="btn-create-alarm"
        type="button"
        class="refraction-btn w-full py-2.5 px-4 text-xs font-bold rounded-xl bg-brand-navy dark:bg-brand-gold text-white dark:text-slate-950 hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-sm"
      >
        <span>+</span>
        <span>Add Alarm</span>
      </button>
    </div>

    <!-- RIGHT COLUMN (7 cols) — Configured Alarms List -->
    <div class="md:col-span-7 refraction-panel p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>📋</span>
            Configured Alarms
          </h3>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Alarms trigger on schedule with synthesized harmonic chimes
          </p>
        </div>
        <span id="alarms-count-badge" class="px-2 py-0.5 text-[10px] font-mono font-bold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          0 configured
        </span>
      </div>

      <!-- Alarms List Container -->
      <div id="alarms-list-container" class="space-y-3">
        <!-- Dynamically rendered by client-app.ts -->
      </div>
    </div>
  </div>

  <!-- Ringing Alarm Modal Overlay (Initially Hidden) -->
  <div
    id="alarm-ringing-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-md p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ringing-alarm-label"
  >
    <div class="refraction-panel max-w-md w-full p-6 text-center shadow-2xl border-2 border-amber-500 animate-bounce">
      <div class="text-5xl mb-3 animate-spin" style="animation-duration: 3s;">⏰</div>
      <div
        id="ringing-alarm-time"
        class="text-4xl sm:text-5xl font-mono font-black tabular-nums text-slate-900 dark:text-slate-50 mb-1"
      >
        07:30 AM
      </div>
      <h2
        id="ringing-alarm-label"
        class="text-xl font-bold text-amber-600 dark:text-brand-gold mb-4 font-serif-literary"
      >
        Morning Wake Up
      </h2>
      <p class="text-xs text-slate-600 dark:text-slate-300 mb-6">
        Scheduled alarm ringing! Choose to snooze or dismiss.
      </p>

      <div class="grid grid-cols-2 gap-3">
        <button
          id="btn-alarm-snooze"
          type="button"
          class="refraction-btn py-3 px-4 text-sm font-bold rounded-2xl bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all border border-black/10 dark:border-white/10"
        >
          💤 Snooze
        </button>
        <button
          id="btn-alarm-dismiss"
          type="button"
          class="refraction-btn py-3 px-4 text-sm font-bold rounded-2xl bg-rose-600 text-white hover:bg-rose-500 transition-all shadow-md"
        >
          ✓ Dismiss Alarm
        </button>
      </div>
    </div>
  </div>
</section>
