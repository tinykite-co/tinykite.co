---
/**
 * ShortcutFooter.astro
 * Tactile 3D Keycap Keyboard Shortcut Legend for Desktop Users.
 */
---

<footer class="mt-8 mb-4 select-none">
  <div class="refraction-panel p-4 max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
        <span>⌨️</span>
        Desktop Keyboard Shortcuts
      </span>
      <span class="text-[11px] text-slate-400 dark:text-slate-500">
        Active across all Chrono tools
      </span>
    </div>

    <!-- Keycap Legend Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5 text-center">
      <!-- Space: Start / Pause -->
      <div class="flex flex-col items-center p-2 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.04] dark:border-white/[0.06]">
        <div class="vkey-3d px-3 py-0.5 text-xs font-bold font-mono min-w-[54px] h-[26px] mb-1">
          Space
        </div>
        <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
          Start / Pause
        </div>
      </div>

      <!-- L: Lap / +1 Min -->
      <div class="flex flex-col items-center p-2 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.04] dark:border-white/[0.06]">
        <div class="vkey-3d px-2.5 py-0.5 text-xs font-bold font-mono min-w-[28px] h-[26px] mb-1">
          L
        </div>
        <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
          Lap / +1m
        </div>
      </div>

      <!-- R: Reset -->
      <div class="flex flex-col items-center p-2 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.04] dark:border-white/[0.06]">
        <div class="vkey-3d px-2.5 py-0.5 text-xs font-bold font-mono min-w-[28px] h-[26px] mb-1">
          R
        </div>
        <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
          Reset Tool
        </div>
      </div>

      <!-- 1 - 4: Tabs -->
      <div class="flex flex-col items-center p-2 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.04] dark:border-white/[0.06]">
        <div class="flex items-center gap-1 mb-1">
          <div class="vkey-3d px-1.5 py-0.5 text-xs font-bold font-mono min-w-[20px] h-[26px]">1</div>
          <div class="vkey-3d px-1.5 py-0.5 text-xs font-bold font-mono min-w-[20px] h-[26px]">2</div>
          <div class="vkey-3d px-1.5 py-0.5 text-xs font-bold font-mono min-w-[20px] h-[26px]">3</div>
          <div class="vkey-3d px-1.5 py-0.5 text-xs font-bold font-mono min-w-[20px] h-[26px]">4</div>
        </div>
        <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
          Switch Tabs
        </div>
      </div>

      <!-- M: Audio Mute -->
      <div class="flex flex-col items-center p-2 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.04] dark:border-white/[0.06]">
        <div class="vkey-3d px-2.5 py-0.5 text-xs font-bold font-mono min-w-[28px] h-[26px] mb-1">
          M
        </div>
        <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
          Mute / Unmute
        </div>
      </div>

      <!-- F: Fullscreen Desk Mode -->
      <div class="flex flex-col items-center p-2 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.04] dark:border-white/[0.06]">
        <div class="vkey-3d px-2.5 py-0.5 text-xs font-bold font-mono min-w-[28px] h-[26px] mb-1">
          F
        </div>
        <div class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">
          Desk Mode
        </div>
      </div>
    </div>
  </div>
</footer>
