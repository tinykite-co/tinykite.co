---
/**
 * ShortcutFooter.astro
 * Quiet, single-line keyboard shortcut bar for desktop productivity.
 */
---

<footer class="mt-6 mb-2 select-none">
  <div class="text-center text-xs text-slate-400 dark:text-slate-500 flex items-center justify-center flex-wrap gap-x-4 gap-y-1.5 font-medium">
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 border border-black/10 dark:border-white/10">Space</kbd>
      <span>Start/Pause</span>
    </div>
    <span class="text-slate-300 dark:text-slate-700 hidden sm:inline">·</span>
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 border border-black/10 dark:border-white/10">L</kbd>
      <span>Lap</span>
    </div>
    <span class="text-slate-300 dark:text-slate-700 hidden sm:inline">·</span>
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 border border-black/10 dark:border-white/10">R</kbd>
      <span>Reset</span>
    </div>
    <span class="text-slate-300 dark:text-slate-700 hidden sm:inline">·</span>
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 border border-black/10 dark:border-white/10">1–4</kbd>
      <span>Mode</span>
    </div>
    <span class="text-slate-300 dark:text-slate-700 hidden sm:inline">·</span>
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 border border-black/10 dark:border-white/10">M</kbd>
      <span>Mute</span>
    </div>
    <span class="text-slate-300 dark:text-slate-700 hidden sm:inline">·</span>
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 border border-black/10 dark:border-white/10">F</kbd>
      <span>Fullscreen</span>
    </div>
  </div>
</footer>
