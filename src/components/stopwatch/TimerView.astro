---
/**
 * TimerView.astro
 * Focused, distraction-free Countdown Timer & Multi-Timers Queue.
 * Features a circular countdown progress ring, one-click preset pills,
 * custom duration bar, and parallel multi-timers.
 */
import { TIMER_PRESETS, SOUND_PROFILES } from '../../lib/stopwatch/config.ts';
---

<section
  id="panel-timer"
  role="tabpanel"
  aria-labelledby="tab-btn-timer"
  class="space-y-6 max-w-4xl mx-auto hidden"
>
  <!-- Clean 2-Column Hero Card -->
  <div class="refraction-panel p-6 sm:p-8 relative overflow-hidden">
    <div class="refraction-prismatic-rim absolute top-0 inset-x-0"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Left Column: Circular Countdown Ring & Primary Controls -->
      <div class="md:col-span-6 flex flex-col items-center justify-center">
        <!-- Timer Completion Alert Banner (Hidden by default) -->
        <div
          id="timer-completed-banner"
          class="hidden w-full mb-4 p-3.5 rounded-2xl bg-gradient-to-r from-amber-500/20 via-emerald-500/20 to-amber-500/20 border-2 border-amber-500 text-slate-900 dark:text-slate-100 animate-pulse text-center"
        >
          <div class="text-sm font-black flex items-center justify-center gap-1.5 mb-1">
            <span>🔔</span>
            <span id="timer-completed-title">Time's Up! Focus Session Complete!</span>
          </div>
          <div class="flex items-center justify-center gap-2 mt-2">
            <button
              id="btn-timer-repeat"
              type="button"
              class="refraction-btn px-3 py-1 text-xs font-bold rounded-xl bg-amber-500 text-slate-950 hover:bg-amber-400 transition-all cursor-pointer"
            >
              ↺ Repeat
            </button>
            <button
              id="btn-timer-dismiss"
              type="button"
              class="refraction-btn px-3 py-1 text-xs font-bold rounded-xl bg-white/80 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 transition-all cursor-pointer"
            >
              Dismiss
            </button>
          </div>
        </div>

        <!-- Crisp Circular SVG Countdown Ring -->
        <div class="relative w-full max-w-[220px] aspect-square flex items-center justify-center my-1 select-none">
          <svg class="w-full h-full select-none" viewBox="0 0 280 280">
            <!-- Background Track -->
            <circle
              cx="140"
              cy="140"
              r="120"
              stroke="currentColor"
              stroke-width="10"
              class="text-slate-200/80 dark:text-slate-800/80"
              fill="none"
            />
            <!-- Foreground Animated Progress Circle (Circumference ~753.98) -->
            <circle
              id="timer-progress-ring"
              cx="140"
              cy="140"
              r="120"
              stroke="currentColor"
              stroke-width="12"
              stroke-linecap="round"
              fill="none"
              stroke-dasharray="753.98"
              stroke-dashoffset="0"
              class="text-amber-500 transition-all duration-300"
              transform="rotate(-90 140 140)"
            />
          </svg>

          <!-- Center Overlay Content -->
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-3 pointer-events-none">
            <div
              id="timer-hero-label"
              class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 max-w-[170px] truncate mb-0.5"
            >
              25m Focus
            </div>

            <div
              id="timer-digital-display"
              class="text-4xl sm:text-5xl font-mono font-black tabular-nums tracking-tight text-slate-900 dark:text-slate-50 my-0.5"
            >
              25:00.0
            </div>

            <!-- Predicted Completion Time -->
            <div
              id="timer-end-time-pill"
              class="mt-1 px-2.5 py-0.5 text-[10px] font-mono font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-black/[0.06] dark:border-white/[0.08]"
            >
              🔔 Ends at --:--
            </div>
          </div>
        </div>

        <!-- Primary Controls -->
        <div class="w-full flex items-center gap-3 pt-4 border-t border-black/[0.06] dark:border-white/[0.06] mt-2">
          <!-- Start / Pause Button -->
          <button
            id="btn-timer-start"
            type="button"
            class="flex-1 refraction-btn min-h-[46px] rounded-2xl font-bold text-sm flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-md transition-all active:scale-95 cursor-pointer"
          >
            <span id="timer-start-icon">▶</span>
            <span id="timer-start-label">Start Timer</span>
          </button>

          <!-- Reset Button -->
          <button
            id="btn-timer-reset"
            type="button"
            class="refraction-btn min-h-[46px] px-4 rounded-2xl font-bold text-sm flex items-center justify-center gap-1.5 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all active:scale-95 border border-black/[0.08] dark:border-white/[0.1] cursor-pointer"
          >
            <span>↺</span>
            <span>Reset</span>
          </button>
        </div>

        <!-- Quick Time Boost Row -->
        <div class="flex items-center justify-center gap-2 mt-3 w-full">
          <button
            id="btn-timer-plus-1m"
            type="button"
            class="refraction-btn flex-1 py-1 px-3 text-xs font-bold rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-950/50 transition-colors border border-black/[0.06] dark:border-white/[0.08] cursor-pointer"
          >
            +1 min
          </button>
          <button
            id="btn-timer-plus-5m"
            type="button"
            class="refraction-btn flex-1 py-1 px-3 text-xs font-bold rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-950/50 transition-colors border border-black/[0.06] dark:border-white/[0.08] cursor-pointer"
          >
            +5 min
          </button>
        </div>
      </div>

      <!-- Right Column: Quick Presets, Custom Duration & Parallel Multi-Timers -->
      <div class="md:col-span-6 flex flex-col justify-between gap-5">
        <!-- Quick Presets: Clean 4x2 Grid -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              ⚡ Quick Presets
            </span>
          </div>

          <div class="grid grid-cols-4 gap-1.5">
            {TIMER_PRESETS.map((preset) => (
              <button
                type="button"
                class="btn-timer-preset refraction-btn py-2 px-1 text-center rounded-xl bg-white/70 dark:bg-slate-900/70 border border-black/[0.08] dark:border-white/[0.1] hover:border-amber-500/60 transition-all text-slate-800 dark:text-slate-200 text-xs font-bold cursor-pointer"
                data-preset-id={preset.id}
                data-duration-ms={preset.durationMs}
                data-label={preset.label}
              >
                {preset.label.replace(' Sprint', '').replace(' Stretch', '').replace(' Break', '').replace(' Reading', '').replace(' Drill', '').replace(' Study', '').replace(' Deep Work', '')}
              </button>
            ))}
          </div>
        </div>

        <!-- Compact Custom Timer Bar -->
        <div class="p-3.5 rounded-2xl bg-slate-100/60 dark:bg-slate-900/60 border border-black/[0.06] dark:border-white/[0.08] space-y-3">
          <div class="grid grid-cols-12 gap-2 items-center">
            <div class="col-span-7">
              <label for="timer-input-label" class="sr-only">Label</label>
              <input
                type="text"
                id="timer-input-label"
                value="Focus Session"
                placeholder="Session label"
                class="w-full px-2.5 py-1 text-xs rounded-lg bg-white dark:bg-slate-800 border border-black/[0.1] dark:border-white/[0.12] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-amber-500"
              />
            </div>
            <div class="col-span-5 flex items-center gap-1 font-mono text-xs">
              <input
                type="number"
                id="timer-input-hours"
                min="0"
                max="23"
                value="0"
                placeholder="H"
                class="w-full px-1 py-1 text-center font-bold rounded-lg bg-white dark:bg-slate-800 border border-black/[0.1] dark:border-white/[0.12] text-slate-800 dark:text-slate-100"
              />
              <span class="text-slate-400">:</span>
              <input
                type="number"
                id="timer-input-minutes"
                min="0"
                max="59"
                value="25"
                placeholder="M"
                class="w-full px-1 py-1 text-center font-bold rounded-lg bg-white dark:bg-slate-800 border border-black/[0.1] dark:border-white/[0.12] text-slate-800 dark:text-slate-100"
              />
              <span class="text-slate-400">:</span>
              <input
                type="number"
                id="timer-input-seconds"
                min="0"
                max="59"
                value="0"
                placeholder="S"
                class="w-full px-1 py-1 text-center font-bold rounded-lg bg-white dark:bg-slate-800 border border-black/[0.1] dark:border-white/[0.12] text-slate-800 dark:text-slate-100"
              />
            </div>
          </div>

          <!-- Sound select & Preview -->
          <div class="flex items-center gap-2">
            <select
              id="select-timer-sound"
              class="flex-1 px-2.5 py-1 text-xs rounded-lg bg-white dark:bg-slate-800 border border-black/[0.1] dark:border-white/[0.12] text-slate-800 dark:text-slate-100 focus:outline-none font-medium"
            >
              {SOUND_PROFILES.map((sound) => (
                <option value={sound.id} selected={sound.id === 'crystal-chime'}>
                  {sound.label}
                </option>
              ))}
            </select>
            <button
              id="btn-test-timer-sound"
              type="button"
              class="refraction-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-300 transition-colors shrink-0 cursor-pointer"
              title="Test audio chime"
            >
              🔔 Test
            </button>
          </div>

          <!-- Actions -->
          <div class="grid grid-cols-2 gap-2">
            <button
              id="btn-set-hero-timer"
              type="button"
              class="refraction-btn py-1.5 px-3 text-xs font-bold rounded-xl bg-amber-500 text-slate-950 hover:bg-amber-400 transition-all cursor-pointer"
            >
              🎯 Set Main
            </button>
            <button
              id="btn-add-multi-timer"
              type="button"
              class="refraction-btn py-1.5 px-3 text-xs font-bold rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all border border-black/[0.08] dark:border-white/[0.1] cursor-pointer"
            >
              + Parallel
            </button>
          </div>
        </div>

        <!-- Parallel Timers List -->
        <div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
            🔀 Parallel Timers
          </div>
          <div id="multi-timers-list" class="space-y-2">
            <!-- Dynamically populated by client-app.ts -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
