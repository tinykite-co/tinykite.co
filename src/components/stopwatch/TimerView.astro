---
/**
 * TimerView.astro
 * Hero Circular Countdown Ring, Kid & Study Presets, Custom Duration Setter,
 * and Parallel Multi-Timers Queue.
 */
import { TIMER_PRESETS, SOUND_PROFILES } from '../../lib/stopwatch/config.ts';

const presetIcons: Record<string, string> = {
  bolt: '⚡',
  heart: '🏃',
  coffee: '☕',
  book: '📖',
  target: '🎯',
  flame: '🔥',
  compass: '🧭',
  sparkles: '✨',
};
---

<section
  id="panel-timer"
  role="tabpanel"
  aria-labelledby="tab-btn-timer"
  class="space-y-6 hidden"
>
  <!-- Desktop 2-Column Responsive Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- LEFT COLUMN (6 cols) — Hero Circular Countdown Ring -->
    <div class="lg:col-span-6 space-y-4">
      <div class="refraction-panel p-6 flex flex-col items-center">
        <div class="refraction-prismatic-rim -mt-6 -mx-6 mb-5"></div>

        <!-- Timer Completion Alert Banner (Hidden by default) -->
        <div
          id="timer-completed-banner"
          class="hidden w-full mb-4 p-4 rounded-2xl bg-gradient-to-r from-amber-500/20 via-emerald-500/20 to-amber-500/20 border-2 border-amber-500 text-slate-900 dark:text-slate-100 animate-pulse text-center"
        >
          <div class="text-base font-black flex items-center justify-center gap-2 mb-1">
            <span class="text-xl">🔔</span>
            <span id="timer-completed-title">Time's Up! Focus Session Complete!</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 mb-3">
            Great work! Take a breath or repeat your session.
          </p>
          <div class="flex items-center justify-center gap-3">
            <button
              id="btn-timer-repeat"
              type="button"
              class="refraction-btn px-4 py-1.5 text-xs font-bold rounded-xl bg-amber-500 text-slate-950 hover:bg-amber-400 transition-all shadow-xs"
            >
              ↺ Repeat Timer
            </button>
            <button
              id="btn-timer-dismiss"
              type="button"
              class="refraction-btn px-4 py-1.5 text-xs font-bold rounded-xl bg-white/80 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all border border-black/10 dark:border-white/10"
            >
              Dismiss
            </button>
          </div>
        </div>

        <!-- SVG Circular Progress Ring -->
        <div class="relative w-full max-w-[280px] aspect-square flex items-center justify-center my-2">
          <svg class="w-full h-full select-none" viewBox="0 0 280 280">
            <!-- Background Track Circle -->
            <circle
              cx="140"
              cy="140"
              r="120"
              stroke="currentColor"
              stroke-width="10"
              class="text-slate-200/80 dark:text-slate-800/80"
              fill="none"
            />
            <!-- Foreground Animated Progress Circle (Circumference ~753.98) -->
            <circle
              id="timer-progress-ring"
              cx="140"
              cy="140"
              r="120"
              stroke="currentColor"
              stroke-width="12"
              stroke-linecap="round"
              fill="none"
              stroke-dasharray="753.98"
              stroke-dashoffset="0"
              class="text-amber-500 transition-all duration-300"
              transform="rotate(-90 140 140)"
            />
          </svg>

          <!-- Center Overlay Content -->
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4 pointer-events-none">
            <div
              id="timer-hero-label"
              class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 max-w-[190px] truncate mb-1"
            >
              25m Focus
            </div>

            <div
              id="timer-digital-display"
              class="text-4xl sm:text-5xl font-mono font-black tabular-nums tracking-tight text-slate-900 dark:text-slate-50 my-1"
            >
              25:00.0
            </div>

            <!-- Predicted Completion Time -->
            <div
              id="timer-end-time-pill"
              class="mt-1 px-3 py-0.5 text-[11px] font-mono font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-black/[0.06] dark:border-white/[0.08]"
            >
              🔔 Ends at --:--
            </div>
          </div>
        </div>

        <!-- Hero Tactile Controls -->
        <div class="w-full grid grid-cols-2 gap-3 pt-5 border-t border-black/[0.08] dark:border-white/[0.08] mt-3">
          <!-- Start / Pause Button -->
          <button
            id="btn-timer-start"
            type="button"
            class="refraction-btn min-h-[50px] rounded-2xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-md transition-all active:scale-95"
          >
            <span id="timer-start-icon">▶</span>
            <span id="timer-start-label">Start Timer</span>
            <span class="hidden sm:inline-block text-[10px] font-mono opacity-80 border border-black/30 rounded px-1">[Space]</span>
          </button>

          <!-- Reset Button -->
          <button
            id="btn-timer-reset"
            type="button"
            class="refraction-btn min-h-[50px] rounded-2xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all active:scale-95 border border-black/[0.08] dark:border-white/[0.1]"
          >
            <span>↺</span>
            <span>Reset</span>
            <span class="hidden sm:inline-block text-[10px] font-mono opacity-80 border border-black/20 dark:border-white/20 rounded px-1">[R]</span>
          </button>
        </div>

        <!-- Quick Time Boost Row -->
        <div class="flex items-center justify-center gap-3 mt-4 w-full">
          <button
            id="btn-timer-plus-1m"
            type="button"
            class="refraction-btn flex-1 py-1.5 px-3 text-xs font-bold rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-950/50 hover:text-amber-800 dark:hover:text-amber-300 transition-colors border border-black/[0.06] dark:border-white/[0.08]"
          >
            +1 min
          </button>
          <button
            id="btn-timer-plus-5m"
            type="button"
            class="refraction-btn flex-1 py-1.5 px-3 text-xs font-bold rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-950/50 hover:text-amber-800 dark:hover:text-amber-300 transition-colors border border-black/[0.06] dark:border-white/[0.08]"
          >
            +5 min
          </button>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN (6 cols) — Quick Presets, Custom Duration & Multi-Timers -->
    <div class="lg:col-span-6 space-y-6">
      <!-- Kid & Study Quick Presets Grid -->
      <div class="refraction-panel p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>⚡</span>
            Kid & Study Quick Presets
          </h3>
          <span class="text-[11px] font-mono text-slate-400">1-CLICK</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          {TIMER_PRESETS.map((preset) => (
            <button
              type="button"
              class="btn-timer-preset refraction-btn p-2.5 rounded-xl bg-white/70 dark:bg-slate-900/70 border border-black/[0.08] dark:border-white/[0.1] hover:border-amber-500/60 text-left transition-all hover:scale-[1.02] active:scale-95 group"
              data-preset-id={preset.id}
              data-duration-ms={preset.durationMs}
              data-label={preset.label}
            >
              <div class="text-sm mb-1 group-hover:scale-110 transition-transform">
                {presetIcons[preset.icon] ?? '⏱️'}
              </div>
              <div class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate">
                {preset.label}
              </div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400">
                {preset.category}
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Custom Duration Setter -->
      <div class="refraction-panel p-5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-1.5">
          <span>🛠️</span>
          Custom Duration & Sound
        </h3>

        <!-- Label Input -->
        <div class="mb-3">
          <label for="timer-input-label" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
            Timer Label
          </label>
          <input
            type="text"
            id="timer-input-label"
            value="Focus Session"
            placeholder="e.g. Science Homework, Math Quiz"
            class="w-full px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <!-- Hours : Minutes : Seconds Inputs -->
        <div class="grid grid-cols-3 gap-2 mb-3">
          <div>
            <label for="timer-input-hours" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
              Hours
            </label>
            <input
              type="number"
              id="timer-input-hours"
              min="0"
              max="23"
              value="0"
              class="w-full px-2.5 py-1.5 text-xs font-mono font-bold text-center rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
          <div>
            <label for="timer-input-minutes" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
              Minutes
            </label>
            <input
              type="number"
              id="timer-input-minutes"
              min="0"
              max="59"
              value="25"
              class="w-full px-2.5 py-1.5 text-xs font-mono font-bold text-center rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
          <div>
            <label for="timer-input-seconds" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
              Seconds
            </label>
            <input
              type="number"
              id="timer-input-seconds"
              min="0"
              max="59"
              value="0"
              class="w-full px-2.5 py-1.5 text-xs font-mono font-bold text-center rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
        </div>

        <!-- Sound Profile Picker with Preview -->
        <div class="mb-4">
          <label for="select-timer-sound" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">
            Completion Sound Chime
          </label>
          <div class="flex items-center gap-2">
            <select
              id="select-timer-sound"
              class="flex-1 px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-black/[0.12] dark:border-white/[0.15] text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
            >
              {SOUND_PROFILES.map((sound) => (
                <option value={sound.id} selected={sound.id === 'crystal-chime'}>
                  {sound.label} — {sound.description}
                </option>
              ))}
            </select>
            <button
              id="btn-test-timer-sound"
              type="button"
              class="refraction-btn px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-white/10 transition-colors shrink-0"
              title="Test audio chime"
            >
              🔔 Test
            </button>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="grid grid-cols-2 gap-2.5">
          <button
            id="btn-set-hero-timer"
            type="button"
            class="refraction-btn py-2 px-3 text-xs font-bold rounded-xl bg-brand-navy dark:bg-brand-gold text-white dark:text-slate-950 hover:opacity-90 transition-all flex items-center justify-center gap-1.5"
          >
            <span>🎯</span>
            <span>Set Main Timer</span>
          </button>
          <button
            id="btn-add-multi-timer"
            type="button"
            class="refraction-btn py-2 px-3 text-xs font-bold rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-1.5 border border-black/[0.08] dark:border-white/[0.1]"
          >
            <span>+</span>
            <span>Add Parallel Timer</span>
          </button>
        </div>
      </div>

      <!-- Parallel Multi-Timers Queue -->
      <div class="refraction-panel p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>🔀</span>
            Parallel Multi-Timers
          </h3>
          <span class="text-[11px] font-mono text-slate-400">MULTITASKING</span>
        </div>

        <div id="multi-timers-list" class="space-y-3">
          <!-- Dynamically populated by client-app.ts -->
        </div>
      </div>
    </div>
  </div>
</section>
